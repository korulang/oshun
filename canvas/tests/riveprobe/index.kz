// riveprobe — replay kr/rive ops onto libs/canvas. cond dispatch,
// path handle lives in a std/grid cell (bodies can't hold vars).
~import libs/canvas
~import kr/rive
~import std/grid
~import std/io

~std/grid:new(hcell, size: 1) { h: 0[i64] }

~pub tor open-store {}
~open-store = libs/canvas:path.open() : h |> std/grid:stored { hcell[0].h: h }

// One persistent path handle, reset per shape — path.open per op leaks a
// registry entry per shape per frame; live sessions exhaust it in ~2
// frames (garbled, then gone). clip.push.path/draw.path copy geometry at
// consume time, so reuse is safe.
~pub tor path-cycle {}
~path-cycle =
    |> if (hcell[0].h == 0)
        | then |> open-store()
        | else |> libs/canvas:path.reset(p: hcell[0].h)

~pub tor step { o: kr/rive:OpRec, f: *libs/canvas:Frame<frame> }
~step = cond (o.kind)
| c _ when o.kind == 0 -> path-cycle()
| c _ when o.kind == 1 -> libs/canvas:path.move(p: hcell[0].h, x: o.x1, y: o.y1)
| c _ when o.kind == 2 -> libs/canvas:path.line(p: hcell[0].h, x: o.x1, y: o.y1)
| c _ when o.kind == 3 -> libs/canvas:path.quad(p: hcell[0].h, cx: o.x1, cy: o.y1, x: o.x2, y: o.y2)
| c _ when o.kind == 4 -> libs/canvas:path.cubic(p: hcell[0].h, c1x: o.x1, c1y: o.y1, c2x: o.x2, c2y: o.y2, x: o.x3, y: o.y3)
| c _ when o.kind == 5 -> libs/canvas:path.close(p: hcell[0].h)
| c _ when o.kind == 6 -> libs/canvas:transform.push(f, o.a, o.b, o.c, o.d, o.e, o.g)
| c _ when o.kind == 7 -> libs/canvas:transform.pop(f)
| c _ when o.kind == 9 -> libs/canvas:draw.clip.push.path(f, p: hcell[0].h, evenodd: o.eo)
| c _ when o.kind == 10 -> libs/canvas:draw.clip.pop(f)
| c _ when o.kind == 8 and o.style == 0 -> libs/canvas:draw.path(f, p: hcell[0].h, fr: 0, fg: 0, fb: 0, fa: 0, sr: (@as(f64, @floatFromInt((o.color >> 16) & 0xFF)) / 255.0), sg: (@as(f64, @floatFromInt((o.color >> 8) & 0xFF)) / 255.0), sb: (@as(f64, @floatFromInt((o.color >> 0) & 0xFF)) / 255.0), sa: (@as(f64, @floatFromInt((o.color >> 24) & 0xFF)) / 255.0), sw: o.thick, o.join, o.cap, evenodd: o.eo)
| c _ when o.kind == 8 -> libs/canvas:draw.path(f, p: hcell[0].h, fr: (@as(f64, @floatFromInt((o.color >> 16) & 0xFF)) / 255.0), fg: (@as(f64, @floatFromInt((o.color >> 8) & 0xFF)) / 255.0), fb: (@as(f64, @floatFromInt((o.color >> 0) & 0xFF)) / 255.0), fa: (@as(f64, @floatFromInt((o.color >> 24) & 0xFF)) / 255.0), sr: 0, sg: 0, sb: 0, sa: 0, sw: o.thick, o.join, o.cap, evenodd: o.eo)
| c _ -> libs/canvas:draw.path(f, p: hcell[0].h, fr: 0, fg: 0, fb: 0, fa: 0, sr: 0, sg: 0, sb: 0, sa: 0, sw: 0, o.join, o.cap, evenodd: o.eo)
