// oshun/canvas:koru-native — the freestanding software rasterizer. Joins
// only under `~[build == koru-native]` (index.kz gates the part); the
// 3000-line ObjC/Metal body in index.macos.kz never enters this build —
// dormant bytes, never parsed, never emitted. That deadstrip is the part
// system's whole claim and this file is its stress test.
//
// What transfers is the CONTRACT: the window/frames/draw/clip/text/input
// tor surface, the phantom states (*Window<opened|active>, *Frame<frame>),
// and the event-ring + arm-dispatch shape inside frames. What does not
// transfer is every line of Cocoa/Metal — this part rasterizes in
// software into a koruos/surface backing (u32 0x00RRGGBB pixels,
// src-over alpha, the cmdview.zig convention) and presents damage
// through the provider's C ABI — the same symbols the koruos/surface
// lift wraps; this is platform code, so it speaks the ABI directly the
// way the macOS part speaks CG*/MTL*.
//
// The pump model mirrors macOS: frames BLOCKS inside prog.main() —
// which runs synchronously inside shell dispatch — and drives one
// desktop tick per iteration through the kernel's exported koru_tick
// (cursor/comp/win/present keep compositing while it runs). Input comes
// from koru_kbd_poll/koru_pointer_state; the app owns the kbd queue and
// pointer while its pump runs. libs/host's host.run is the same shape
// without a window.
//
// v0 scope (honest):
//   IMPLEMENTED — window.open/overlay/show/hide/pin/close/size/
//     clear.color/snap, frames (all arms), draw.rect/roundrect/panel,
//     draw.clip.push/push.round/pop, draw.text, text.index/offset/
//     ascent/descent, input.* synthesis, release.frame.
//   UNDECLARED — draw.triangle/bezier/shadow/glass/capture/frost,
//     draw.image*/imagetint/imagecover, image.load/free/width/height,
//     font.load, draw.textface, offscreen.*, remote.watch. A consumer
//     calling one gets a loud unknown-tor at compile time — the spec's
//     loud axis, never a silent stub.
//   KNOWN DELTAS — text is the kernel's 8x8 bitmap face (ASCII, no
//     shaping); `size` maps to an integer pixel scale; window.snap
//     samples pixels onto the wire instead of writing a BMP (there is
//     no filesystem); window.pin is vacuous (no app-deactivate concept);
//     surfaces are opaque — overlay corners clip but cannot alpha-blend
//     to the desktop.
//
// Kernel exports this part calls — provided by koru-os-m1's native
// image (shell.zig / runtime.zig / text.zig / surf.zig), resolved at
// link; absent on hosted builds where this part never joins.

~import libs/host

const std = @import("std");
// Bare module path, NOT @import("root"): under -Mprogram (the kernel
// image) root is boot.zig, which has no koru_libs — the emitted module
// nests it at file scope where this resolves in every build shape.
const H = koru_libs.koru_host;

// ---- provider + kernel C-ABI ------------------------------------------

extern fn koruos_surface_open(w: u32, h: u32, title: [*:0]const u8) ?*anyopaque;
extern fn koruos_surface_present(s: *anyopaque, x: u32, y: u32, w: u32, h: u32) u8;
extern fn koruos_surface_close(s: *anyopaque) u8;
extern fn koruos_surface_map(p: ?*anyopaque, out_phys: *u64, out_bytes: *u64) u8;
const Geom = extern struct { x: u32, y: u32, w: u32, h: u32, sw: u32, sh: u32 };
extern fn koruos_surface_geom(p: ?*anyopaque, out: *Geom) u8;

extern fn koru_tick() callconv(.c) void;
extern fn koru_kbd_poll() callconv(.c) i32;
extern fn koru_pointer_state(x: *i32, y: *i32, on: *u8, buttons: *u32) callconv(.c) void;
extern fn koru_wire(s: [*]const u8, n: usize) callconv(.c) void;
extern fn koru_glyph8(ch: u8, row: u8) callconv(.c) u8;
extern fn ukplat_monotonic_clock() callconv(.c) u64; // ns

fn sleepNs(ns: u64) void {
    const t0 = ukplat_monotonic_clock();
    while (ukplat_monotonic_clock() - t0 < ns) {}
}

fn nowSeconds() f32 {
    return @floatCast(@as(f64, @floatFromInt(ukplat_monotonic_clock())) / 1.0e9);
}

// ---- pixel format + blend ----------------------------------------------
// Surface backings are u32 0x00RRGGBB (surf.zig/cmdview.zig convention).
// Alpha blends src-over: out = (src*a + dst*(255-a))/255 per channel.

fn packColor(r: f64, g: f64, b: f64) u32 {
    const rc: u32 = @intFromFloat(@round(@max(0.0, @min(1.0, r)) * 255.0));
    const gc: u32 = @intFromFloat(@round(@max(0.0, @min(1.0, g)) * 255.0));
    const bc: u32 = @intFromFloat(@round(@max(0.0, @min(1.0, b)) * 255.0));
    return (rc << 16) | (gc << 8) | bc;
}

fn blendInto(dst: *u32, sr: u32, sg: u32, sb: u32, sa: u32) void {
    const inv = 255 - sa;
    const d = dst.*;
    const nr = (sr * sa + ((d >> 16) & 0xFF) * inv) / 255;
    const ng = (sg * sa + ((d >> 8) & 0xFF) * inv) / 255;
    const nb = (sb * sa + (d & 0xFF) * inv) / 255;
    dst.* = (nr << 16) | (ng << 8) | nb;
}

// ---- event payloads + ring (macOS shapes, verbatim) ---------------------

pub const KeyData = struct {
    code: u16,
    chars: []const u8 = &.{},
};

pub const MouseData = struct {
    x: f64,
    y: f64,
};

pub const ScrollData = struct {
    x: f64,
    y: f64,
    dx: f64,
    dy: f64,
};

pub const RemoteData = struct {
    button: u32,
    page: u32,
    down: u8,
};

const Event = union(enum) {
    key_down: KeyData,
    mouse_down: MouseData,
    mouse_up: MouseData,
    mouse_move: MouseData,
    mouse_drag: MouseData,
    scroll: ScrollData,
    remote_button: RemoteData,
};

var ev_buf: [64]Event = undefined;
var ev_chars: [64][16]u8 = undefined;
var ev_head: usize = 0;
var ev_tail: usize = 0;

fn pushKey(kc: u16, chars: []const u8) void {
    const next = (ev_tail + 1) % ev_buf.len;
    if (next == ev_head) return;
    const n = @min(chars.len, ev_chars[0].len);
    @memcpy(ev_chars[ev_tail][0..n], chars[0..n]);
    ev_buf[ev_tail] = .{ .key_down = .{ .code = kc, .chars = ev_chars[ev_tail][0..n] } };
    ev_tail = next;
}

fn pushEvent(e: Event) void {
    if (ev_tail != ev_head) {
        const last = if (ev_tail == 0) ev_buf.len - 1 else ev_tail - 1;
        switch (e) {
            .mouse_move => if (ev_buf[last] == .mouse_move) {
                ev_buf[last] = e;
                return;
            },
            .mouse_drag => if (ev_buf[last] == .mouse_drag) {
                ev_buf[last] = e;
                return;
            },
            else => {},
        }
    }
    const next = (ev_tail + 1) % ev_buf.len;
    if (next != ev_head) {
        ev_buf[ev_tail] = e;
        ev_tail = next;
    }
}

fn popEvent() ?Event {
    if (ev_head == ev_tail) return null;
    const e = ev_buf[ev_head];
    ev_head = (ev_head + 1) % ev_buf.len;
    return e;
}

// ---- input polling (the kernel's cursor/kbd -> our ring) -----------------

var in_has_prev: bool = false;
var in_prev_x: i32 = 0;
var in_prev_y: i32 = 0;
var in_prev_btns: u32 = 0;

fn pollInput(win: *Window) void {
    while (true) {
        const c = koru_kbd_poll();
        if (c < 0) break;
        var ch: [1]u8 = .{@intCast(c)};
        pushKey(0, ch[0..]); // code 0 — native has no keycode map; chars carry it
    }
    var x: i32 = undefined;
    var y: i32 = undefined;
    var on: u8 = undefined;
    var btns: u32 = undefined;
    koru_pointer_state(&x, &y, &on, &btns);
    if (!in_has_prev) {
        in_prev_x = x;
        in_prev_y = y;
        in_prev_btns = btns;
        in_has_prev = true;
        return;
    }
    const lx = x - win.sx;
    const ly = y - win.sy;
    const inside = on != 0 and lx >= 0 and ly >= 0 and
        @as(u32, @intCast(lx)) < win.w and @as(u32, @intCast(ly)) < win.h;
    const moved = x != in_prev_x or y != in_prev_y;
    const was_down = (in_prev_btns & 1) != 0;
    const is_down = (btns & 1) != 0;
    if (inside) {
        const md = MouseData{ .x = @as(f64, @floatFromInt(lx)), .y = @as(f64, @floatFromInt(ly)) };
        if (is_down and !was_down) {
            pushEvent(.{ .mouse_down = md });
        } else if (!is_down and was_down) {
            pushEvent(.{ .mouse_up = md });
        } else if (moved) {
            pushEvent(if (is_down) .{ .mouse_drag = md } else .{ .mouse_move = md });
        }
    }
    in_prev_x = x;
    in_prev_y = y;
    in_prev_btns = btns;
}

// ---- window + frame tokens ------------------------------------------------
// Platform-typed structs — the phantom states ride the tor signatures,
// identical to the macOS part's by contract.

pub const Window = struct {
    surf: ?*anyopaque = null, // provider token — null while hidden (overlay)
    px: [*]u32 = undefined,   // backing — identity-mapped phys via surface_map
    w: u32 = 0,
    h: u32 = 0,
    sx: i32 = 0, // scene origin — geom, refreshed per frames iteration
    sy: i32 = 0,
    clear: u32 = 0x001A1A26,  // macOS default 0.1/0.1/0.15 -> 0x00RRGGBB
    visible: bool = true,
    overlay: bool = false,
    radius: f32 = 0, // overlay corner radius — base clip when > 0
    slot: u8 = 0,    // index into win_pool — set by winAlloc
};

// Window custody is a static pool, not std.heap — page_allocator pulls
// std.posix.mmap, which does not exist on x86_64-freestanding-none.
// A desktop runs a handful of windows; 16 slots is generous headroom.
const MAX_WINDOWS = 16;
var win_pool: [MAX_WINDOWS]Window = undefined;
var win_used: [MAX_WINDOWS]bool = .{false} ** MAX_WINDOWS;

fn winAlloc() ?*Window {
    for (0..MAX_WINDOWS) |i| {
        if (!win_used[i]) {
            win_used[i] = true;
            win_pool[i] = .{};
            win_pool[i].slot = @intCast(i);
            return &win_pool[i];
        }
    }
    return null;
}

fn winFree(w: *Window) void {
    win_used[w.slot] = false;
}

pub const Frame = struct {
    win: *Window,
    px: [*]u32,
    w: u32,
    h: u32,
    clip: [16][5]f32, // x0,y0,x1,y1,round — same shape as macOS
    clip_depth: u8 = 0,
    clip_aux: [16]i32 = .{-1} ** 16, // per-level clip-path mask pool idx, -1 = rect level
    ctm: [16][6]f64 = undefined, // affine stack [a c e; b d g]
    ctm_depth: u8 = 0,
    calls: usize = 0, // draw-call count
    time: f32 = 0,
};

pub const Size = struct {
    w: f64,
    h: f64,
};

// ---- surface custody -------------------------------------------------------

fn surfEnsure(win: *Window) bool {
    if (win.surf != null) return true;
    if (win.w == 0 or win.h == 0) return false;
    const p = koruos_surface_open(win.w, win.h, "koru-native".ptr) orelse return false;
    var phys: u64 = 0;
    var bytes: u64 = 0;
    if (koruos_surface_map(p, &phys, &bytes) == 0 or bytes < @as(u64, win.w) * win.h * 4) {
        _ = koruos_surface_close(p);
        return false;
    }
    var g: Geom = undefined;
    if (koruos_surface_geom(p, &g) != 0) {
        win.sx = @intCast(g.x);
        win.sy = @intCast(g.y);
    }
    win.surf = p;
    win.px = @ptrFromInt(@as(usize, @intCast(phys)));
    return true;
}

fn surfDrop(win: *Window) void {
    if (win.surf) |s| {
        _ = koruos_surface_close(s);
        win.surf = null;
    }
}

fn refreshGeom(win: *Window) void {
    const s = win.surf orelse return;
    var g: Geom = undefined;
    if (koruos_surface_geom(s, &g) != 0) {
        win.sx = @intCast(g.x);
        win.sy = @intCast(g.y);
    }
}

fn clearBacking(win: *Window) void {
    const n: usize = @as(usize, @intCast(win.w)) * @as(usize, @intCast(win.h));
    var i: usize = 0;
    while (i < n) : (i += 1) win.px[i] = win.clear;
}

// present + tick as one module fn — externs can't be named bare inside a
// spliced (effect-branch) proc body, so the frame commit rides $mod.
fn frameCommit(win: *Window, s: *anyopaque) void {
    _ = koruos_surface_present(s, 0, 0, win.w, win.h);
    koru_tick();
}

// ---- rasterizer ------------------------------------------------------------
// Signed distance to a rounded box (negative inside), pixel-center
// sampled with a 1px coverage ramp — the honest software answer to the
// Metal SDF the macOS fragment shader evaluates per-pixel.

fn sdRoundBox(px: f32, py: f32, x0: f32, y0: f32, x1: f32, y1: f32, r: f32) f32 {
    const cx = (x0 + x1) * 0.5;
    const cy = (y0 + y1) * 0.5;
    const hw = @max(0.0, (x1 - x0) * 0.5 - r);
    const hh = @max(0.0, (y1 - y0) * 0.5 - r);
    const qx = @abs(px - cx) - hw;
    const qy = @abs(py - cy) - hh;
    const ax = @max(qx, 0.0);
    const ay = @max(qy, 0.0);
    return @sqrt(ax * ax + ay * ay) + @min(@max(qx, qy), 0.0) - r;
}

fn covOf(d: f32) f32 {
    return @max(0.0, @min(1.0, 0.5 - d));
}

fn clipDepth(f: *Frame) usize {
    return @as(usize, @intCast(f.clip_depth));
}

// Coverage of the live clip stack at a pixel center — every level must
// contain the point (intersection), each level keeping its own rounding.
fn clipCov(f: *Frame, sx: f32, sy: f32) f32 {
    var cc: f32 = 1.0;
    const d = clipDepth(f);
    for (f.clip[0..d], 0..) |*l, li| {
        if (f.clip_aux[li] >= 0) {
            const m = clip_masks.items[@intCast(f.clip_aux[li])];
            const wusz: usize = @intCast(f.w);
            const husz: usize = @intCast(f.h);
            const mx = @min(wusz - 1, @max(@as(usize, 0), @as(usize, @intFromFloat(@floor(sx)))));
            const my = @min(husz - 1, @max(@as(usize, 0), @as(usize, @intFromFloat(@floor(sy)))));
            const mv: f32 = if (m[my * @as(usize, @intCast(f.w)) + mx] != 0) 1.0 else 0.0;
            cc = @min(cc, mv);
        } else {
            cc = @min(cc, covOf(sdRoundBox(sx, sy, l[0], l[1], l[2], l[3], l[4])));
        }
        if (cc <= 0.0) return 0.0;
    }
    return cc;
}

fn pxAt(f: *Frame, x: i32, y: i32) *u32 {
    return &f.px[@as(usize, @intCast(y)) * @as(usize, @intCast(f.w)) + @as(usize, @intCast(x))];
}

// One blended pixel — clip coverage times the caller's alpha.
fn pxBlend(f: *Frame, x: i32, y: i32, sx: f32, sy: f32, sr: u32, sg: u32, sb: u32, sa: u32) void {
    const cc = clipCov(f, sx, sy);
    if (cc <= 0.0) return;
    const a = @min(1.0, cc) * (@as(f32, @floatFromInt(sa)) / 255.0);
    const ai: u32 = @intFromFloat(@round(a * 255.0));
    if (ai == 0) return;
    blendInto(pxAt(f, x, y), sr, sg, sb, ai);
}

const Col = struct { r: u32, g: u32, b: u32, a: u32 };

fn colOf(r: f64, g: f64, b: f64, a: f64) Col {
    const c = packColor(r, g, b);
    const av: u32 = @intFromFloat(@round(@max(0.0, @min(1.0, a)) * 255.0));
    return .{ .r = (c >> 16) & 0xFF, .g = (c >> 8) & 0xFF, .b = c & 0xFF, .a = av };
}

// A filled rounded box — the one shape draw.rect/roundrect/panel share.
// radius 0 degenerates to a sharp rect; coverage is analytic, not
// point-sampled, so edges carry a 1px ramp.
fn fillShape(f: *Frame, x: f64, y: f64, w: f64, h: f64, radius: f64, col: Col) void {
    if (col.a == 0 or w <= 0 or h <= 0) return;
    if (f.ctm_depth > 0) {
        const r = ctmRect(f, x, y, w, h);
        // Rotated/skewed rects rasterize as their bbox — named delta vs CG.
        const saved = f.ctm_depth;
        f.ctm_depth = 0;
        fillShape(f, r.x, r.y, r.w, r.h, radius, col);
        f.ctm_depth = saved;
        return;
    }
    const x0: f32 = @floatCast(x);
    const y0: f32 = @floatCast(y);
    const x1: f32 = @floatCast(x + w);
    const y1: f32 = @floatCast(y + h);
    const rad: f32 = @floatCast(radius);
    const ix0 = @max(0, @floor(@min(x, x + w)));
    const iy0 = @max(0, @floor(@min(y, y + h)));
    const ix1 = @min(@as(f64, @floatFromInt(f.w)), @ceil(@max(x, x + w)));
    const iy1 = @min(@as(f64, @floatFromInt(f.h)), @ceil(@max(y, y + h)));
    var py = iy0;
    while (py < iy1) : (py += 1) {
        var px = ix0;
        while (px < ix1) : (px += 1) {
            const sx = @as(f32, @floatCast(px)) + 0.5;
            const sy = @as(f32, @floatCast(py)) + 0.5;
            const sc = covOf(sdRoundBox(sx, sy, x0, y0, x1, y1, rad));
            if (sc <= 0.0) continue;
            const a = sc * (@as(f32, @floatFromInt(col.a)) / 255.0);
            const ai: u32 = @intFromFloat(@round(@min(1.0, a) * 255.0));
            if (ai == 0) continue;
            const cc = clipCov(f, sx, sy);
            if (cc <= 0.0) continue;
            const fa = @min(1.0, cc) * (@as(f32, @floatFromInt(ai)) / 255.0);
            const fi: u32 = @intFromFloat(@round(fa * 255.0));
            if (fi == 0) continue;
            blendInto(pxAt(f, @intFromFloat(px), @intFromFloat(py)), col.r, col.g, col.b, fi);
        }
    }
    f.calls += 1;
}

// A crisp filled rect — no shape AA (bitmap-font cells want hard edges);
// clip coverage still applies.
fn fillPxRect(f: *Frame, x: f64, y: f64, w: f64, h: f64, col: Col) void {
    if (col.a == 0) return;
    const ix0 = @max(0, @floor(@min(x, x + w)));
    const iy0 = @max(0, @floor(@min(y, y + h)));
    const ix1 = @min(@as(f64, @floatFromInt(f.w)), @ceil(@max(x, x + w)));
    const iy1 = @min(@as(f64, @floatFromInt(f.h)), @ceil(@max(y, y + h)));
    var py = iy0;
    while (py < iy1) : (py += 1) {
        var px = ix0;
        while (px < ix1) : (px += 1) {
            pxBlend(f, @intFromFloat(px), @intFromFloat(py), @as(f32, @floatCast(px)) + 0.5, @as(f32, @floatCast(py)) + 0.5, col.r, col.g, col.b, col.a);
        }
    }
    f.calls += 1;
}

// ---- text metrics (the 8x8 bitmap face) -------------------------------------
// `size` is the line-box height in the contract's points; the native face
// is an 8px em, so size maps to an integer scale — size 16 -> scale 2.
// advance = 9*scale (8 glyph + 1 gap), ascent = 8*scale, descent = 2*scale.

fn textScale(size: f64) u32 {
    return @max(@as(u32, 1), @as(u32, @intFromFloat(@round(size / 8.0))));
}

fn textAdvance(sc: u32) f64 {
    return @floatFromInt(9 * sc);
}

fn drawGlyph(f: *Frame, gx: f64, gy: f64, sc: u32, ch: u8, col: Col) void {
    const x0 = @floor(gx);
    const y0 = @floor(gy);
    var row: u8 = 0;
    while (row < 8) : (row += 1) {
        const bits = koru_glyph8(ch, row);
        var colb: u8 = 0;
        while (colb < 8) : (colb += 1) {
            // bit `colb` is the pixel — the kernel renderers (text.zig
            // glyphAt, cmdview) read LSB-first; bit7-first mirrors the face.
            if (((bits >> @as(u3, @intCast(colb))) & 1) != 0) {
                fillPxRect(f, x0 + @as(f64, @floatFromInt(@as(u32, colb) * sc)), y0 + @as(f64, @floatFromInt(@as(u32, row) * sc)), @as(f64, @floatFromInt(sc)), @as(f64, @floatFromInt(sc)), col);
            }
        }
    }
}

fn drawTextRun(f: *Frame, x: f64, y: f64, size: f64, face: i64, r: f64, g: f64, b: f64, a: f64, text: []const u8) void {
    if (f.ctm_depth > 0) {
        const p = ctmPoint(f, x, y);
        const m = &f.ctm[@intCast(f.ctm_depth - 1)];
        const sc = (@sqrt(m[0] * m[0] + m[1] * m[1]) + @sqrt(m[2] * m[2] + m[3] * m[3])) / 2.0;
        const saved = f.ctm_depth;
        f.ctm_depth = 0;
        drawTextRun(f, p[0], p[1], size * sc, face, r, g, b, a, text);
        f.ctm_depth = saved;
        return;
    }
    const col = colOf(r, g, b, a);
    if (col.a == 0 or text.len == 0) return;
    const sc = textScale(size);
    const adv = textAdvance(sc);
    var pen = x;
    for (text) |ch| {
        if (ch >= 0x20 and ch < 0x7F) {
            drawGlyph(f, pen, y, sc, ch, col);
        }
        pen += adv;
    }
    f.calls += 1;
}

// ---- input synthesis (automation verbs — same as macOS) ---------------------

~pub tor input.key { code: i64 }

~proc input.key|zig {
    pushKey(@intCast(code), &.{});
}

~pub tor input.type { chars: string }

~proc input.type|zig {
    pushKey(0xFFFF, chars);
}

~pub tor input.mouse { x: f64, y: f64 }

~proc input.mouse|zig {
    pushEvent(.{ .mouse_down = .{ .x = x, .y = y } });
}

~pub tor input.move { x: f64, y: f64 }

~proc input.move|zig {
    pushEvent(.{ .mouse_move = .{ .x = x, .y = y } });
}

~pub tor input.up { x: f64, y: f64 }

~proc input.up|zig {
    pushEvent(.{ .mouse_up = .{ .x = x, .y = y } });
}

~pub tor input.drag { x: f64, y: f64 }

~proc input.drag|zig {
    pushEvent(.{ .mouse_drag = .{ .x = x, .y = y } });
}

~pub tor input.scroll { x: f64, y: f64, dx: f64, dy: f64 }

~proc input.scroll|zig {
    pushEvent(.{ .scroll = .{ .x = x, .y = y, .dx = dx, .dy = dy } });
}

// ---- window lifecycle --------------------------------------------------------

~pub tor window.open { width: i32, height: i32, title: string }
| win *Window<opened!>
| err string

~proc window.open|zig {
    _ = title; // the provider takes a label arg but has no WM to show it
    if (width <= 0 or height <= 0) return .{ .err = "metal: window.open needs positive dims" };
    const w = winAlloc() orelse return .{ .err = "metal: window pool exhausted" };
    w.w = @intCast(width);
    w.h = @intCast(height);
    w.visible = true;
    w.overlay = false;
    if (!surfEnsure(w)) {
        winFree(w);
        return .{ .err = "metal: surface open refused (pool/pmm/display)" };
    }
    return .{ .win = w };
}

~pub tor window.overlay { width: i32, height: i32, radius: f64 }
| win *Window<opened!>
| err string

~proc window.overlay|zig {
    if (width <= 0 or height <= 0) return .{ .err = "metal: window.overlay needs positive dims" };
    const w = winAlloc() orelse return .{ .err = "metal: window pool exhausted" };
    // Mints hidden — the surface opens lazily on show/frames so an
    // overlay costs zero compositor layers until summoned. Opaque, not
    // translucent: surface pixels carry no alpha to the desktop.
    w.w = @intCast(width);
    w.h = @intCast(height);
    w.visible = false;
    w.overlay = true;
    w.radius = @floatCast(radius);
    return .{ .win = w };
}

~pub tor window.show { win: *Window<opened|active> }
~proc window.show|zig {
    win.visible = true;
    if (!surfEnsure(win)) win.visible = false; // frames will report close
}

// Vacuous on native — there is no app-deactivate to pin against; the
// semantic is satisfied by construction. Declared so shared consumers
// compile; the body is honestly empty, not a stub of missing work.
~pub tor window.pin { win: *Window<opened|active> }
~proc window.pin|zig {
    _ = win;
}

~pub tor window.hide { win: *Window<opened|active> }
~proc window.hide|zig {
    win.visible = false;
    surfDrop(win); // pixels must leave the compositor — reopen on show
}

~pub tor window.size { win: *Window<opened|active> } -> libs/canvas:Size

~proc window.size|zig {
    return .{ .w = @as(f64, @floatFromInt(win.w)), .h = @as(f64, @floatFromInt(win.h)) };
}

// window.snap — the pixel oracle. No filesystem exists natively, so the
// BMP path becomes a wire dump: a header line then a deterministic
// 8x6 sample grid of surface pixels as RRGGBB hex. A gate can assert
// exact colors at exact coords — fresher and more falsifiable than a
// file nobody opens.
~pub tor window.snap { path: string }

~proc window.snap|zig {
    const win = live_win orelse {
        // No pump running — say so on the wire rather than guess a window.
        const msg = "KSNAP none\n";
        koru_wire(msg.ptr, msg.len);
        return;
    };
    var buf: [3072]u8 = undefined;
    var n: usize = 0;
    const put = struct {
        fn s(b: []u8, i: *usize, t: []const u8) void {
            @memcpy(b[i.*..][0..t.len], t);
            i.* += t.len;
        }
        fn c(b: []u8, i: *usize, ch: u8) void {
            b[i.*] = ch;
            i.* += 1;
        }
        fn d(b: []u8, i: *usize, v: u64) void {
            var tmp: [20]u8 = undefined;
            var k: usize = tmp.len;
            var x = v;
            if (x == 0) {
                c(b, i, '0');
                return;
            }
            while (x > 0) {
                k -= 1;
                tmp[k] = @intCast('0' + x % 10);
                x /= 10;
            }
            s(b, i, tmp[k..]);
        }
        fn h(b: []u8, i: *usize, v: u32) void {
            var sh: u5 = 28;
            while (true) {
                const nib: u8 = @intCast((v >> sh) & 0xF);
                c(b, i, if (nib < 10) '0' + nib else 'a' + nib - 10);
                if (sh == 0) break;
                sh -= 4;
            }
        }
    };
    s2: {
        put.s(&buf, &n, "KSNAP ");
        var li: usize = 0;
        while (li < path.len and li < 24 and n < buf.len - 40) : (li += 1) {
            const ch = path[li];
            put.c(&buf, &n, if (ch >= 0x20 and ch < 0x7F) ch else '_');
        }
        put.c(&buf, &n, ' ');
        put.d(&buf, &n, win.w);
        put.c(&buf, &n, 'x');
        put.d(&buf, &n, win.h);
        put.c(&buf, &n, '\n');
        const s = win.surf orelse break :s2;
        _ = s;
        const gw: u32 = 4;
        const gh: u32 = 3;
        var gy: u32 = 0;
        while (gy < gh) : (gy += 1) {
            var gx: u32 = 0;
            while (gx < gw) : (gx += 1) {
                const sx = @min(win.w - 1, (gx * win.w) / gw);
                const sy = @min(win.h - 1, (gy * win.h) / gh);
                const px = win.px[@as(usize, @intCast(sy)) * @as(usize, @intCast(win.w)) + @as(usize, @intCast(sx))];
                if (n > buf.len - 40) break :s2;
                put.s(&buf, &n, "SNAP ");
                put.d(&buf, &n, sx);
                put.c(&buf, &n, ',');
                put.d(&buf, &n, sy);
                put.c(&buf, &n, ' ');
                put.h(&buf, &n, px);
                put.c(&buf, &n, '\n');
            }
        }
    }
    koru_wire(buf[0..n].ptr, n);
}

~pub tor window.close { win: *Window<!active> }

~proc window.close|zig {
    surfDrop(win);
    winFree(win);
}

~pub tor window.clear.color { win: *Window<opened|active>, r: f32, g: f32, b: f32 }

~proc window.clear.color|zig {
    win.clear = packColor(@floatCast(r), @floatCast(g), @floatCast(b));
}

// The window snap samples — the contract takes no win param (macOS
// resolves it through live_win, the frame loop's active window). Same
// mechanism here: frames sets it for its duration.
var live_win: ?*Window = null;

// ---- the frame loop ----------------------------------------------------------
// The `opened -> active` transition, same bracket shape as the macOS part:
// each iteration ticks the desktop once (koru_tick — the compositor keeps
// compositing while prog.main() is blocked here), polls kernel input into
// the ring, drains both rings into the effect arms, then clears the
// backing, hands `! frame` a live Frame borrow, presents the damage, and
// paces. `count` bounds the loop; quit()/host.quit or a hidden window
// exits `| done` (with `! close` fired for the hide path, mirroring
// macOS's isVisible poll).

~pub tor frames { win: *Window<!opened|!active>, count: ?i32 }
! frame *Frame<frame!>
! ?key-down libs/canvas:KeyData
! ?mouse-down libs/canvas:MouseData
! ?mouse-up libs/canvas:MouseData
! ?mouse-move libs/canvas:MouseData
! ?mouse-drag libs/canvas:MouseData
! ?scroll libs/canvas:ScrollData
! ?remote-button libs/canvas:RemoteData
! ?tray-action libs/host:TrayActionData
! ?menu-action libs/host:MenuActionData
! ?hotkey libs/host:HotkeyData
! ?close
| done *Window<active!>

~proc frames|zig {
    const __cap = @as(?i32, count) orelse 2147483647;
    $mod.H.drain_paused = true;
    defer $mod.H.drain_paused = false;
    $mod.live_win = win;
    defer $mod.live_win = null;
    var i: i32 = 0;
    while (i < __cap) : (i += 1) {
        if (win.visible and win.surf == null) _ = $mod.surfEnsure(win);
        $mod.pollInput(win);
        while ($mod.popEvent()) |mev| {
            switch (mev) {
                .key_down => |k| key_down(k),
                .mouse_down => |m| mouse_down(m),
                .mouse_up => |m| mouse_up(m),
                .mouse_move => |m| mouse_move(m),
                .mouse_drag => |m| mouse_drag(m),
                .scroll => |s| scroll(s),
                .remote_button => |r| remote_button(r),
            }
        }
        while ($mod.H.popEvent()) |hev| {
            switch (hev) {
                .tray => |td| tray_action(td),
                .menu => |md| menu_action(md),
                .hotkey => |hk| hotkey(hk),
                .remote_button => |rd| remote_button(.{ .button = rd.button, .page = rd.page, .down = rd.down }),
            }
        }
        if ($mod.H.should_quit) break;
        if (!win.visible or win.surf == null) {
            close();
            break;
        }
        const s = win.surf.?;
        $mod.refreshGeom(win);
        $mod.clearBacking(win);
        var __f = $mod.Frame{
            .win = win,
            .px = win.px,
            .w = win.w,
            .h = win.h,
            .clip = undefined,
            .clip_depth = 0,
            .calls = 0,
            .time = $mod.nowSeconds(),
        };
        if (win.radius > 0) {
            __f.clip[0] = .{ 0, 0, @as(f32, @floatFromInt(win.w)), @as(f32, @floatFromInt(win.h)), win.radius };
            __f.clip_depth = 1;
        }
        frame(&__f);
        $mod.frameCommit(win, s);
        $mod.sleepNs(8_000_000); // ~8ms — the macOS pump's cadence
    }
    return .{ .done = win };
}

// No-op consumer of the per-frame borrow — auto-inserted release, mirror
// of the macOS part's release.frame.
~pub tor release.frame { f: *Frame<!frame> }
~proc release.frame|zig { _ = &f; }

// ---- drawing -------------------------------------------------------------------
// Every draw call borrows the frame handle, so it can only appear inside
// a `! frame` body. All rasterization is immediate-mode into the surface
// backing — the compositor picks the pixels up on present.

~pub tor draw.rect { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64, r: f64, g: f64, b: f64, a: f64 }

~proc draw.rect|zig {
    fillShape(f, x, y, w, h, 0, colOf(r, g, b, a));
}

~pub tor draw.roundrect { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64, radius: f64, r: f64, g: f64, b: f64, a: f64 }

~proc draw.roundrect|zig {
    fillShape(f, x, y, w, h, radius, colOf(r, g, b, a));
}

~pub tor draw.panel { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64, radius: f64, r: f64, g: f64, b: f64, a: f64, bw: f64, br: f64, bg: f64, bb: f64, ba: f64 }

~proc draw.panel|zig {
    fillShape(f, x, y, w, h, radius, colOf(r, g, b, a));
    const bc = colOf(br, bg, bb, ba);
    if (bc.a == 0 or bw <= 0) return;
    // Border ring: coverage of the outer shape minus the shape inset by
    // the border width — the same SDF math, one ring deep.
    const ix = @min(bw, @min(w, h) * 0.5);
    const inner_r = @max(0.0, radius - ix);
    const x0: f32 = @floatCast(x + ix);
    const y0: f32 = @floatCast(y + ix);
    const x1: f32 = @floatCast(x + w - ix);
    const y1: f32 = @floatCast(y + h - ix);
    const orad: f32 = @floatCast(radius);
    const irad: f32 = @floatCast(inner_r);
    const bx0 = @max(0, @floor(x));
    const by0 = @max(0, @floor(y));
    const bx1 = @min(@as(f64, @floatFromInt(f.w)), @ceil(x + w));
    const by1 = @min(@as(f64, @floatFromInt(f.h)), @ceil(y + h));
    var py = by0;
    while (py < by1) : (py += 1) {
        var px = bx0;
        while (px < bx1) : (px += 1) {
            const sx = @as(f32, @floatCast(px)) + 0.5;
            const sy = @as(f32, @floatCast(py)) + 0.5;
            const xo: f32 = @floatCast(x);
            const yo: f32 = @floatCast(y);
            const xw: f32 = @floatCast(x + w);
            const yh: f32 = @floatCast(y + h);
            const ring = covOf(sdRoundBox(sx, sy, xo, yo, xw, yh, orad)) -
                covOf(sdRoundBox(sx, sy, x0, y0, x1, y1, irad));
            if (ring <= 0.0) continue;
            const ra = @min(1.0, ring) * (@as(f32, @floatFromInt(bc.a)) / 255.0);
            const ai: u32 = @intFromFloat(@round(ra * 255.0));
            if (ai == 0) continue;
            const cc = clipCov(f, sx, sy);
            if (cc <= 0.0) continue;
            const fi: u32 = @intFromFloat(@round(@min(1.0, cc) * (@as(f32, @floatFromInt(ai)) / 255.0) * 255.0));
            if (fi == 0) continue;
            blendInto(pxAt(f, @intFromFloat(px), @intFromFloat(py)), bc.r, bc.g, bc.b, fi);
        }
    }
    f.calls += 1;
}

// ---- clip stack ----------------------------------------------------------------

~pub tor draw.clip.push { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64 }

~proc draw.clip.push|zig {
    if (clipDepth(f) >= f.clip.len) return;
    var x0: f32 = @floatCast(x);
    var y0: f32 = @floatCast(y);
    var x1: f32 = x0 + @as(f32, @floatCast(w));
    var y1: f32 = y0 + @as(f32, @floatCast(h));
    if (f.clip_depth > 0) {
        const parent = f.clip[f.clip_depth - 1];
        x0 = @max(x0, parent[0]);
        y0 = @max(y0, parent[1]);
        x1 = @min(x1, parent[2]);
        y1 = @min(y1, parent[3]);
    }
    f.clip[f.clip_depth] = .{ x0, y0, x1, y1, 0.0 };
    f.clip_aux[f.clip_depth] = -1;
    f.clip_depth += 1;
}

~pub tor draw.clip.push.round { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64, radius: f64 }

~proc draw.clip.push.round|zig {
    if (clipDepth(f) >= f.clip.len) return;
    var x0: f32 = @floatCast(x);
    var y0: f32 = @floatCast(y);
    var x1: f32 = x0 + @as(f32, @floatCast(w));
    var y1: f32 = y0 + @as(f32, @floatCast(h));
    if (f.clip_depth > 0) {
        const parent = f.clip[f.clip_depth - 1];
        x0 = @max(x0, parent[0]);
        y0 = @max(y0, parent[1]);
        x1 = @min(x1, parent[2]);
        y1 = @min(y1, parent[3]);
    }
    f.clip[f.clip_depth] = .{ x0, y0, x1, y1, @floatCast(radius) };
    f.clip_aux[f.clip_depth] = -1;
    f.clip_depth += 1;
}

~pub tor draw.clip.pop { f: *Frame<frame> }

~proc draw.clip.pop|zig {
    if (f.clip_depth == 0) return;
    const d = clipDepth(f) - 1;
    if (f.clip_aux[d] >= 0) {
        clipMaskFree(f.clip_aux[d]);
        f.clip_aux[d] = -1;
    }
    f.clip_depth = @intCast(d);
}

// ---- text ------------------------------------------------------------------------

~pub tor draw.text { f: *Frame<frame>, x: f64, y: f64, size: f64, r: f64, g: f64, b: f64, a: f64, text: string<*> }

~proc draw.text|zig {
    drawTextRun(f, x, y, size, 0, r, g, b, a, text);
}

// ---- text metrics -----------------------------------------------------------------
// Same face draw.text rasterizes with, so the metrics can't drift from
// the renderer — the contract's whole point for these verbs.

~pub tor text.index { win: *Window<opened|active>, text: string, size: f64, face: i64, x: f64 } -> i64

~proc text.index|zig {
    _ = win;
    _ = face;
    const sc = textScale(size);
    const adv = textAdvance(sc);
    const click = x;
    var pen = 0.0;
    var idx: i64 = 0;
    for (text) |ch| {
        if (click < pen + adv * 0.5) return idx;
        pen += adv;
        idx += 1;
        _ = ch;
    }
    return @intCast(text.len);
}

~pub tor text.offset { win: *Window<opened|active>, text: string, size: f64, face: i64, index: i64 } -> f64

~proc text.offset|zig {
    _ = win;
    _ = face;
    const sc = textScale(size);
    const adv = textAdvance(sc);
    const idx: usize = @intCast(@max(0, @min(index, @as(i64, @intCast(text.len)))));
    return @as(f64, @floatFromInt(idx)) * adv;
}

~pub tor text.ascent { win: *Window<opened|active>, size: f64, face: i64 } -> f64

~proc text.ascent|zig {
    _ = win;
    _ = face;
    return @as(f64, @floatFromInt(8 * textScale(size)));
}

~pub tor text.descent { win: *Window<opened|active>, size: f64, face: i64 } -> f64

~proc text.descent|zig {
    _ = win;
    _ = face;
    return @as(f64, @floatFromInt(2 * textScale(size)));
}

// ---- mesh: tessellated triangle soup (uniform with index.macos.kz) ----------
// draw.mesh consumes Tri records from the koru-rive tessellator — the
// koru-native polygon path. Rasterized in software: 2x2 supersampled
// triangle fill, src-over, clip-aware — same coverage contract as
// fillShape.

const MeshData = struct { verts: std.ArrayList(f32) = .empty };
var meshes: std.ArrayList(MeshData) = .empty;

fn pointInTri(px: f32, py: f32, v: [6]f32) bool {
    const ax = v[0]; const ay = v[1]; const bx = v[2]; const by = v[3]; const cx = v[4]; const cy = v[5];
    const d1 = (px - bx) * (ay - by) - (ax - bx) * (py - by);
    const d2 = (px - cx) * (by - cy) - (bx - cx) * (py - cy);
    const d3 = (px - ax) * (cy - ay) - (cx - ax) * (py - ay);
    const neg = (d1 < 0) or (d2 < 0) or (d3 < 0);
    const pos = (d1 > 0) or (d2 > 0) or (d3 > 0);
    return !(neg and pos);
}

fn fillTri(f: *Frame, ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64, col: Col) void {
    if (col.a == 0) return;
    const minx = @floor(@min(ax, @min(bx, cx))) - 1;
    const miny = @floor(@min(ay, @min(by, cy))) - 1;
    const maxx = @ceil(@max(ax, @max(bx, cx))) + 1;
    const maxy = @ceil(@max(ay, @max(by, cy))) + 1;
    const ix0 = @max(0, @max(minx, 0));
    const iy0 = @max(0, @max(miny, 0));
    const ix1 = @min(@as(f64, @floatFromInt(f.w)), maxx);
    const iy1 = @min(@as(f64, @floatFromInt(f.h)), maxy);
    const a32: f32 = @floatCast(ax); const b32: f32 = @floatCast(ay);
    const c32: f32 = @floatCast(bx); const d32: f32 = @floatCast(by);
    const e32: f32 = @floatCast(cx); const f32_: f32 = @floatCast(cy);
    var py = iy0;
    while (py < iy1) : (py += 1) {
        var px = ix0;
        while (px < ix1) : (px += 1) {
            var hits: u32 = 0;
            var syi: u32 = 0;
            while (syi < 2) : (syi += 1) {
                var sxi: u32 = 0;
                while (sxi < 2) : (sxi += 1) {
                    const sx = @as(f32, @floatCast(px)) + 0.25 + @as(f32, @floatFromInt(sxi)) * 0.5;
                    const sy = @as(f32, @floatCast(py)) + 0.25 + @as(f32, @floatFromInt(syi)) * 0.5;
                    if (pointInTri(sx, sy, .{ a32, b32, c32, d32, e32, f32_ })) hits += 1;
                }
            }
            if (hits == 0) continue;
            const cov: f32 = @as(f32, @floatFromInt(hits)) / 4.0;
            const mx = @as(f32, @floatCast(px)) + 0.5;
            const my = @as(f32, @floatCast(py)) + 0.5;
            const cc = clipCov(f, mx, my);
            if (cc <= 0.0) continue;
            const a = cov * (@as(f32, @floatFromInt(col.a)) / 255.0) * @min(1.0, cc);
            const ai: u32 = @intFromFloat(@round(@min(1.0, a) * 255.0));
            if (ai == 0) continue;
            blendInto(pxAt(f, @intFromFloat(px), @intFromFloat(py)), col.r, col.g, col.b, ai);
        }
    }
    f.calls += 1;
}

~pub tor mesh.open { } -> i64

~proc mesh.open|zig {
    meshes.append(std.heap.page_allocator, .{}) catch @panic("canvas: OOM mesh registry");
    return @intCast(meshes.items.len);
}

~pub tor mesh.tri { h: i64, x1: f64, y1: f64, x2: f64, y2: f64, x3: f64, y3: f64 }

~proc mesh.tri|zig {
    if (h < 1 or h > @as(i64, @intCast(meshes.items.len))) return;
    const m = &meshes.items[@intCast(h - 1)];
    m.verts.append(std.heap.page_allocator, @floatCast(x1)) catch {};
    m.verts.append(std.heap.page_allocator, @floatCast(y1)) catch {};
    m.verts.append(std.heap.page_allocator, @floatCast(x2)) catch {};
    m.verts.append(std.heap.page_allocator, @floatCast(y2)) catch {};
    m.verts.append(std.heap.page_allocator, @floatCast(x3)) catch {};
    m.verts.append(std.heap.page_allocator, @floatCast(y3)) catch {};
}

~pub tor mesh.reset { h: i64 }

~proc mesh.reset|zig {
    if (h < 1 or h > @as(i64, @intCast(meshes.items.len))) return;
    meshes.items[@intCast(h - 1)].verts.clearRetainingCapacity();
}

~pub tor draw.mesh { f: *Frame<frame>, h: i64, r: f64, g: f64, b: f64, a: f64 }

~proc draw.mesh|zig {
    if (h < 1 or h > @as(i64, @intCast(meshes.items.len))) return;
    const m = &meshes.items[@intCast(h - 1)];
    const col = colOf(r, g, b, a);
    const n = m.verts.items.len;
    var i: usize = 0;
    while (i + 5 < n) : (i += 6) {
        fillTri(f,
            @floatCast(m.verts.items[i]), @floatCast(m.verts.items[i + 1]),
            @floatCast(m.verts.items[i + 2]), @floatCast(m.verts.items[i + 3]),
            @floatCast(m.verts.items[i + 4]), @floatCast(m.verts.items[i + 5]), col);
    }
}

// ---- paths: recorded verb stream, flattened + scanline-filled in software --
// Same contract as index.macos.kz path.*/draw.path/transform.*/clip.push.path.
// Curves flatten at draw time (24 segs/cubic, 12/quad); fill is per-pixel
// 2x2 supersampled point-in-contour; stroke approximates joins/caps with
// per-segment quads + joint discs (named delta vs CG stroke).

const PathSeg = struct { verb: u8, n: u8, pts: [6]f64 };
// verb: 0 move(1pt) 1 line(1pt) 2 quad(2pts) 3 cubic(3pts) 4 close
const PathData = struct {
    segs: std.ArrayList(PathSeg) = .empty,
    cur: [2]f64 = .{ 0, 0 },
    start: [2]f64 = .{ 0, 0 },
    has_cur: bool = false,
};
var paths: std.ArrayList(PathData) = .empty;

fn pathAt(p: i64) ?*PathData {
    if (p < 1 or p > @as(i64, @intCast(paths.items.len))) return null;
    return &paths.items[@intCast(p - 1)];
}

fn pathPushSeg(pd: *PathData, verb: u8, pts: []const f64) void {
    var s = PathSeg{ .verb = verb, .n = @intCast(pts.len / 2), .pts = .{0} ** 6 };
    for (pts, 0..) |v, i| s.pts[i] = v;
    pd.segs.append(std.heap.page_allocator, s) catch @panic("canvas: OOM path");
}

fn pathMoveTo(pd: *PathData, x: f64, y: f64) void {
    pathPushSeg(pd, 0, &.{ x, y });
    pd.cur = .{ x, y };
    pd.start = .{ x, y };
    pd.has_cur = true;
}

// Flatten `pd` into contours under CTM `m` ([a c e; b d g] affine).
// out_pts: flat xy pairs; out_counts: points per contour. Returns false on OOM-path (empty ok).
fn flattenPath(pd: *const PathData, m: ?*const [6]f64, out_pts: *std.ArrayList(f64), out_counts: *std.ArrayList(usize)) void {
    out_pts.clearRetainingCapacity();
    out_counts.clearRetainingCapacity();
    var cx = pd.cur[0];
    var cy = pd.cur[1];
    var sx = pd.start[0];
    var sy = pd.start[1];
    var contour_open = false;
    var cur_count: usize = 0;
    const A = std.heap.page_allocator;

    for (pd.segs.items) |s| {
        switch (s.verb) {
            0 => {
                if (contour_open and cur_count > 0) out_counts.append(A, cur_count) catch {};
                cur_count = 0;
                contour_open = true;
                flattenEmit(out_pts, &cur_count, m, s.pts[0], s.pts[1]);
                cx = s.pts[0]; cy = s.pts[1]; sx = cx; sy = cy;
            },
            1 => {
                if (!contour_open) { contour_open = true; flattenEmit(out_pts, &cur_count, m, cx, cy); }
                flattenEmit(out_pts, &cur_count, m, s.pts[0], s.pts[1]);
                cx = s.pts[0]; cy = s.pts[1];
            },
            2 => { // quad: cx,cy ctrl + x,y end
                if (!contour_open) { contour_open = true; flattenEmit(out_pts, &cur_count, m, cx, cy); cur_count -= 1; }
                const px = cx; const py = cy;
                const qx = s.pts[0]; const qy = s.pts[1]; const ex = s.pts[2]; const ey = s.pts[3];
                var i: usize = 1;
                while (i <= 12) : (i += 1) {
                    const t = @as(f64, @floatFromInt(i)) / 12.0;
                    const u = 1.0 - t;
                    flattenEmit(out_pts, &cur_count, m, u * u * px + 2.0 * u * t * qx + t * t * ex, u * u * py + 2.0 * u * t * qy + t * t * ey);
                }
                cx = ex; cy = ey;
            },
            3 => { // cubic
                if (!contour_open) { contour_open = true; flattenEmit(out_pts, &cur_count, m, cx, cy); }
                const px = cx; const py = cy;
                const c1x = s.pts[0]; const c1y = s.pts[1];
                const c2x = s.pts[2]; const c2y = s.pts[3];
                const ex = s.pts[4]; const ey = s.pts[5];
                var i: usize = 1;
                while (i <= 24) : (i += 1) {
                    const t = @as(f64, @floatFromInt(i)) / 24.0;
                    const u = 1.0 - t;
                    flattenEmit(out_pts, &cur_count, m,
                        u*u*u*px + 3.0*u*u*t*c1x + 3.0*u*t*t*c2x + t*t*t*ex,
                        u*u*u*py + 3.0*u*u*t*c1y + 3.0*u*t*t*c2y + t*t*t*ey);
                }
                cx = ex; cy = ey;
            },
            4 => { // close
                if (contour_open and cur_count > 0) {
                    flattenEmit(out_pts, &cur_count, m, sx, sy);
                    out_counts.append(A, cur_count) catch {};
                    cur_count = 0;
                    contour_open = false;
                }
                cx = sx; cy = sy;
            },
            else => {},
        }
    }
    if (contour_open and cur_count > 0) out_counts.append(A, cur_count) catch {};
}

fn flattenEmit(pts: *std.ArrayList(f64), count: *usize, m: ?*const [6]f64, x: f64, y: f64) void {
    const A = std.heap.page_allocator;
    if (m) |mm| {
        pts.append(A, mm[0] * x + mm[2] * y + mm[4]) catch {};
        pts.append(A, mm[1] * x + mm[3] * y + mm[5]) catch {};
    } else {
        pts.append(A, x) catch {};
        pts.append(A, y) catch {};
    }
    count.* += 1;
}

// Point-in-contours: evenodd pairs crossings; winding accumulates direction.
fn pointInContours(pts: []const f64, counts: []const usize, x: f64, y: f64, evenodd: bool) bool {
    var inside = false;
    var wind: i32 = 0;
    var base: usize = 0;
    for (counts) |n| {
        if (n < 3) { base += n * 2; continue; }
        var i: usize = 0;
        while (i < n) : (i += 1) {
            const j = (i + 1) % n;
            const ax = pts[(base + i * 2)]; const ay = pts[(base + i * 2 + 1)];
            const bx = pts[(base + j * 2)]; const by = pts[(base + j * 2 + 1)];
            if ((ay > y) != (by > y)) {
                const xint = ax + (y - ay) * (bx - ax) / (by - ay);
                if (xint > x) {
                    if (evenodd) inside = !inside else wind += if (by > ay) @as(i32, 1) else -1;
                }
            }
        }
        base += n * 2;
    }
    if (evenodd) return inside;
    return wind != 0;
}

var g_flat_pts: std.ArrayList(f64) = .empty;
var g_flat_counts: std.ArrayList(usize) = .empty;
var g_stroke_pts: std.ArrayList(f64) = .empty;
var g_stroke_counts: std.ArrayList(usize) = .empty;

fn ctmOf(f: *const Frame) ?*const [6]f64 {
    if (f.ctm_depth == 0) return null;
    return &f.ctm[@intCast(f.ctm_depth - 1)];
}

fn fillContours(f: *Frame, pts: []const f64, counts: []const usize, col: Col, evenodd: bool) void {
    if (col.a == 0 or pts.len < 6 or counts.len == 0) return;
    var minx: f64 = 1e30; var miny: f64 = 1e30; var maxx: f64 = -1e30; var maxy: f64 = -1e30;
    // bbox over pairs
    var i: usize = 0;
    while (i + 1 < pts.len) : (i += 2) {
        minx = @min(minx, pts[i]); maxx = @max(maxx, pts[i]);
        miny = @min(miny, pts[i + 1]); maxy = @max(maxy, pts[i + 1]);
    }
    const ix0 = @max(0, @floor(minx));
    const iy0 = @max(0, @floor(miny));
    const ix1 = @min(@as(f64, @floatFromInt(f.w)), @ceil(maxx));
    const iy1 = @min(@as(f64, @floatFromInt(f.h)), @ceil(maxy));
    const sa = (@as(f32, @floatFromInt(col.a)) / 255.0);
    var py = iy0;
    while (py < iy1) : (py += 1) {
        var px = ix0;
        while (px < ix1) : (px += 1) {
            var hits: u32 = 0;
            var syi: u32 = 0;
            while (syi < 2) : (syi += 1) {
                var sxi: u32 = 0;
                while (sxi < 2) : (sxi += 1) {
                    const sx = @as(f64, @floatCast(px)) + 0.25 + @as(f64, @floatFromInt(sxi)) * 0.5;
                    const sy = @as(f64, @floatCast(py)) + 0.25 + @as(f64, @floatFromInt(syi)) * 0.5;
                    if (pointInContours(pts, counts, sx, sy, evenodd)) hits += 1;
                }
            }
            if (hits == 0) continue;
            const a = (@as(f32, @floatFromInt(hits)) / 4.0) * sa;
            const ai: u32 = @intFromFloat(@round(a * 255.0));
            if (ai == 0) continue;
            blendInto(pxAt(f, @intFromFloat(px), @intFromFloat(py)), col.r, col.g, col.b, ai);
        }
    }
}

fn rasterizePathContours(f: *Frame, pd: *const PathData, col: Col, evenodd: bool) void {
    flattenPath(pd, ctmOf(f), &g_flat_pts, &g_flat_counts);
    fillContours(f, g_flat_pts.items, g_flat_counts.items, col, evenodd);
}

// Stroke: flatten to polylines, emit a quad per segment + a disc at every
// joint (covers joins + round caps approximately; square/butt deltas named).
fn strokeContours(f: *Frame, pd: *const PathData, sw: f64, evenodd: bool, col: Col) void {
    _ = evenodd; // stroke fill is always nonzero-rule quads+discs
    if (sw <= 0 or col.a == 0) return;
    flattenPath(pd, ctmOf(f), &g_flat_pts, &g_flat_counts);
    const A = std.heap.page_allocator;
    g_stroke_pts.clearRetainingCapacity();
    g_stroke_counts.clearRetainingCapacity();
    const half = sw / 2.0;
    const nseg_disc: usize = 8;
    var base: usize = 0;
    for (g_flat_counts.items) |n| {
        if (n < 2) { base += n * 2; continue; }
        // polyline points for this contour
        var prev: ?[2]f64 = null;
        var i: usize = 0;
        while (i < n) : (i += 1) {
            const x = g_flat_pts.items[(base + i * 2)];
            const y = g_flat_pts.items[(base + i * 2 + 1)];
            if (prev) |p0| {
                const dx = x - p0[0]; const dy = y - p0[1];
                const len = @sqrt(dx * dx + dy * dy);
                if (len > 1e-9) {
                    const nx = -dy / len * half; const ny = dx / len * half;
                    // quad contour: p0+n, p1+n, p1-n, p0-n
                    const quad = [_]f64{ p0[0] + nx, p0[1] + ny, x + nx, y + ny, x - nx, y - ny, p0[0] - nx, p0[1] - ny };
                    for (quad) |v| g_stroke_pts.append(A, v) catch {};
                    g_stroke_counts.append(A, 4) catch {};
                }
            }
            prev = .{ x, y };
        }
        // joint discs at every vertex (incl. endpoints -> round-cap approx)
        i = 0;
        while (i < n) : (i += 1) {
            const x = g_flat_pts.items[(base + i * 2)];
            const y = g_flat_pts.items[(base + i * 2 + 1)];
            var k: usize = 0;
            while (k < nseg_disc) : (k += 1) {
                const a = 2.0 * std.math.pi * @as(f64, @floatFromInt(k)) / @as(f64, @floatFromInt(nseg_disc));
                g_stroke_pts.append(A, x + @cos(a) * half) catch {};
                g_stroke_pts.append(A, y + @sin(a) * half) catch {};
            }
            g_stroke_counts.append(A, nseg_disc) catch {};
        }
        base += n * 2;
    }
    fillContours(f, g_stroke_pts.items, g_stroke_counts.items, col, false);
}

// ---- transform stack ---------------------------------------------------------
// Frame gains ctm: [16][6]f64 affine stack ([a c e; b d g] row-major use:
// x' = a*x + c*y + e ; y' = b*x + d*y + g). Identity at depth 0.

fn ctmPush(f: *Frame, a: f64, b: f64, c: f64, d: f64, e: f64, g: f64) void {
    if (f.ctm_depth >= 16) return;
    const dpt: usize = @intCast(f.ctm_depth);
    f.ctm[dpt] = if (dpt == 0)
        .{ a, b, c, d, e, g }
    else blk: {
        const p = &f.ctm[dpt - 1];
        break :blk .{
            a * p[0] + c * p[1],
            b * p[0] + d * p[1],
            a * p[2] + c * p[3],
            b * p[2] + d * p[3],
            a * p[4] + c * p[5] + e,
            b * p[4] + d * p[5] + g,
        };
    };
    f.ctm_depth = @intCast(dpt + 1);
}

fn ctmPop(f: *Frame) void {
    if (f.ctm_depth > 0) f.ctm_depth -= 1;
}

// Apply live CTM to a rect: returns axis-aligned bbox (exact for
// translate/scale; rotated rects degrade to bbox — named delta).
const RectD = struct { x: f64, y: f64, w: f64, h: f64 };
fn ctmRect(f: *const Frame, x: f64, y: f64, w: f64, h: f64) RectD {
    if (f.ctm_depth == 0) return .{ .x = x, .y = y, .w = w, .h = h };
    const m = &f.ctm[@intCast(f.ctm_depth - 1)];
    const x0 = m[0] * x + m[2] * y + m[4];
    const y0 = m[1] * x + m[3] * y + m[5];
    const x1 = m[0] * (x + w) + m[2] * (y + h) + m[4];
    const y1 = m[1] * (x + w) + m[3] * (y + h) + m[5];
    return .{ .x = @min(x0, x1), .y = @min(y0, y1), .w = @abs(x1 - x0), .h = @abs(y1 - y0) };
}

fn ctmPoint(f: *const Frame, x: f64, y: f64) [2]f64 {
    if (f.ctm_depth == 0) return .{ x, y };
    const m = &f.ctm[@intCast(f.ctm_depth - 1)];
    return .{ m[0] * x + m[2] * y + m[4], m[1] * x + m[3] * y + m[5] };
}

// ---- clip path masks ----------------------------------------------------------
// clip.push.path rasterizes the path into a binary coverage mask stored in a
// pool; clip_aux[i] = mask index or -1. clipCov samples masks before rects.

var clip_masks: std.ArrayList([]u8) = .empty;

fn clipMaskAlloc(f: *Frame) i32 {
    const n = @as(usize, @intCast(f.w)) * @as(usize, @intCast(f.h));
    const mask = std.heap.page_allocator.alloc(u8, n) catch return -1;
    @memset(mask, 0);
    clip_masks.append(std.heap.page_allocator, mask) catch return -1;
    return @intCast(clip_masks.items.len - 1);
}

fn clipMaskFree(idx: i32) void {
    if (idx < 0 or idx >= @as(i32, @intCast(clip_masks.items.len))) return;
    const m = clip_masks.items[@intCast(idx)];
    std.heap.page_allocator.free(m);
    _ = clip_masks.orderedRemove(@as(usize, @intCast(idx)));
    // NOTE: indices shift on remove — clip_aux entries store pool indices;
    // orderedRemove invalidates higher indices. Frames are short-lived and
    // clips pop LIFO so only the tail index is ever live at removal; the
    // pop path clears its own slot first. (named limitation)
}

// Rasterize path into mask (binary, no AA v0) — writes 255 inside.
fn rasterizeClipMask(f: *Frame, pd: *const PathData, evenodd: bool, mask: []u8) void {
    flattenPath(pd, ctmOf(f), &g_flat_pts, &g_flat_counts);
    const w = @as(usize, @intCast(f.w));
    var py: usize = 0;
    while (py < @as(usize, @intCast(f.h))) : (py += 1) {
        var px: usize = 0;
        while (px < w) : (px += 1) {
            const sx = @as(f64, @floatFromInt(px)) + 0.5;
            const sy = @as(f64, @floatFromInt(py)) + 0.5;
            if (pointInContours(g_flat_pts.items, g_flat_counts.items, sx, sy, evenodd)) {
                mask[py * w + px] = 255;
            }
        }
    }
}

// ---- path/transform/draw.path verbs (macOS contract parity) -----------------

~pub tor path.open { } -> i64

~proc path.open|zig {
    paths.append(std.heap.page_allocator, .{}) catch @panic("canvas: OOM path");
    return @intCast(paths.items.len);
}

~pub tor path.move { p: i64, x: f64, y: f64 }
~pub tor path.line { p: i64, x: f64, y: f64 }
~pub tor path.quad { p: i64, cx: f64, cy: f64, x: f64, y: f64 }
~pub tor path.cubic { p: i64, c1x: f64, c1y: f64, c2x: f64, c2y: f64, x: f64, y: f64 }
~pub tor path.close { p: i64 }
~pub tor path.reset { p: i64 }
~pub tor path.free { p: i64 }

~proc path.move|zig {
    const pd = pathAt(p) orelse return;
    pathMoveTo(pd, x, y);
}

~proc path.line|zig {
    const pd = pathAt(p) orelse return;
    if (!pd.has_cur) { pathMoveTo(pd, x, y); return; }
    pathPushSeg(pd, 1, &.{ x, y });
    pd.cur = .{ x, y };
}

~proc path.quad|zig {
    const pd = pathAt(p) orelse return;
    if (!pd.has_cur) { pathMoveTo(pd, cx, cy); }
    pathPushSeg(pd, 2, &.{ cx, cy, x, y });
    pd.cur = .{ x, y };
}

~proc path.cubic|zig {
    const pd = pathAt(p) orelse return;
    if (!pd.has_cur) { pathMoveTo(pd, c1x, c1y); }
    pathPushSeg(pd, 3, &.{ c1x, c1y, c2x, c2y, x, y });
    pd.cur = .{ x, y };
}

~proc path.close|zig {
    const pd = pathAt(p) orelse return;
    pathPushSeg(pd, 4, &.{});
    pd.cur = pd.start;
}

~proc path.reset|zig {
    const pd = pathAt(p) orelse return;
    pd.segs.clearRetainingCapacity();
    pd.has_cur = false;
    pd.cur = .{ 0, 0 };
    pd.start = .{ 0, 0 };
}

~proc path.free|zig {
    const pd = pathAt(p) orelse return;
    pd.segs.deinit(std.heap.page_allocator);
    _ = paths.orderedRemove(@intCast(p - 1));
    // Handles are positional — freeing shifts indices; probe holds one live
    // path at a time (hcell single slot), same custody shape as meshes.
}

~pub tor transform.push { f: *Frame<frame>, a: f64, b: f64, c: f64, d: f64, e: f64, g: f64 }
~pub tor transform.pop { f: *Frame<frame> }

~proc transform.push|zig {
    ctmPush(f, a, b, c, d, e, g);
}

~proc transform.pop|zig {
    ctmPop(f);
}

~pub tor draw.path { f: *Frame<frame>, p: i64, fr: f64, fg: f64, fb: f64, fa: f64, sr: f64, sg: f64, sb: f64, sa: f64, sw: f64, join: i64, cap: i64, evenodd: i64 }

~proc draw.path|zig {
    const pd = pathAt(p) orelse return;
    const eo: bool = evenodd != 0;
    const fill = colOf(fr, fg, fb, fa);
    const strk = colOf(sr, sg, sb, sa);
    if (fill.a != 0) rasterizePathContours(f, pd, fill, eo);
    if (strk.a != 0) strokeContours(f, pd, sw, eo, strk);
    _ = join;
    _ = cap;
}

~pub tor draw.clip.push.path { f: *Frame<frame>, p: i64, evenodd: i64 }

~proc draw.clip.push.path|zig {
    const pd = pathAt(p) orelse return;
    if (f.clip_depth >= 16) return;
    const idx = clipMaskAlloc(f);
    if (idx < 0) return;
    const mask = clip_masks.items[@intCast(idx)];
    rasterizeClipMask(f, pd, evenodd != 0, mask);
    const d = clipDepth(f);
    f.clip[d] = .{ -1e9, -1e9, 1e9, 1e9, 0 }; // full-frame rect; mask carries shape
    f.clip_aux[d] = idx;
    f.clip_depth = @intCast(d + 1);
}


// ---- image verbs: decode is undeclared on the freestanding target (no
// codec in the kernel ABI) — the tor exists so consumers compile, and it
// fails LOUD through the err arm. width/height/draw.image are unreachable
// behind that err; declared so the contract surface stays whole.

~pub tor image.decode.data { data: string } | img i64 | err string

~proc image.decode.data|zig {
    return .{ .err = "koru-native: image decode undeclared (no codec in kernel ABI)" };
}

~pub tor image.width { tex: i64 } -> i64
~pub tor image.height { tex: i64 } -> i64
~pub tor draw.image { f: *Frame<frame>, tex: i64, x: f64, y: f64, w: f64, h: f64 }

~proc image.width|zig {
    _ = tex;
    return 0;
}

~proc image.height|zig {
    _ = tex;
    return 0;
}

~proc draw.image|zig {
    // Unreachable: image.decode.data always errs, so step-image's err arm
    // (magenta rect) runs instead. Panic rather than silently drop.
    @panic("canvas: draw.image unreachable — decode is undeclared");
}
