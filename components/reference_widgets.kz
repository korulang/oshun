// @korulang/components/reference_widgets — faithful ports of the reference
// widgets, not Lantern reinterpretations.
//
// Coordinates, sizes and colours are the measured C-arm specs (the HTML
// candidates that scored 0.910 / 0.864 SSIM at 1x). The canvas has no
// gradients or text blur, so dots are layered alpha and the background
// vignettes are shadow approximations; geometry and palette are the
// reference values. `s` scales the whole reference frame.

~import libs/canvas

~pub tor soft-text {
    f: *libs/canvas:Frame<frame>, face: i64,
    x: f64, y: f64, size: f64, soft: f64,
    r: f64, g: f64, b: f64, a: f64, text: string,
}

~soft-text = libs/canvas:draw.textface(f, x: x - soft, y: y - soft, size, font: face, r, g, b, a: a * 0.10, text)
    |> libs/canvas:draw.textface(f, x: x + soft, y: y - soft, size, font: face, r, g, b, a: a * 0.10, text)
    |> libs/canvas:draw.textface(f, x: x - soft, y: y + soft, size, font: face, r, g, b, a: a * 0.10, text)
    |> libs/canvas:draw.textface(f, x: x + soft, y: y + soft, size, font: face, r, g, b, a: a * 0.10, text)
    |> libs/canvas:draw.textface(f, x, y, size, font: face, r, g, b, a: a * 0.72, text)

// ---- vitals (BP widget) --------------------------------------------------

~pub tor reference-bp {
    win: *libs/canvas:Window<opened|active>,
    f: *libs/canvas:Frame<frame>, face: i64,
    x: f64, y: f64, s: f64,
}

~reference-bp = libs/canvas:draw.rect(f, x, y, w: 394.0 * s, h: 210.0 * s, r: 0.169, g: 0.169, b: 0.169, a: 1.0)
    |> libs/canvas:draw.shadow(f, x: x - 100.0 * s, y: y - 120.0 * s, w: 594.0 * s, h: 180.0 * s, radius: 90.0 * s, blur: 70.0 * s, r: 0.0, g: 0.0, b: 0.0, a: 0.40)
    |> libs/canvas:draw.shadow(f, x: x - 110.0 * s, y: y + 150.0 * s, w: 614.0 * s, h: 160.0 * s, radius: 80.0 * s, blur: 70.0 * s, r: 0.0, g: 0.0, b: 0.0, a: 0.38)
    |> libs/canvas:draw.shadow(f, x: x + 25.5 * s, y: y + 44.5 * s, w: 337.5 * s, h: 154.5 * s, radius: 35.0 * s, blur: 18.0 * s, r: 0.0, g: 0.0, b: 0.0, a: 0.42)
    |> libs/canvas:draw.roundrect(f, x: x + 25.5 * s, y: y + 37.5 * s, w: 337.5 * s, h: 154.5 * s, radius: 35.0 * s, r: 0.004, g: 0.004, b: 0.004, a: 1.0)
    |> soft-text(f, face, x: x + 54.0 * s, y: y + 59.5 * s, size: 26.0 * s, soft: 0.55 * s, r: 0.941, g: 0.686, b: 0.784, a: 1.0, text: "82")
    |> soft-text(f, face, x: x + 90.1 * s, y: y + 67.2 * s, size: 16.5 * s, soft: 0.55 * s, r: 0.627, g: 0.502, b: 0.549, a: 1.0, text: "mmhg")
    |> soft-text(f, face, x: x + 292.7 * s, y: y + 64.2 * s, size: 17.0 * s, soft: 0.55 * s, r: 0.910, g: 0.910, b: 0.910, a: 1.0, text: "5 min")
    |> bp-bar(f, x: x + (25.5+30.30) * s, y: y + (37.5+101.50) * s, h: 5.00 * s, s)
    |> bp-bar(f, x: x + (25.5+43.60) * s, y: y + (37.5+101.50) * s, h: 5.50 * s, s)
    |> bp-bar(f, x: x + (25.5+56.90) * s, y: y + (37.5+94.50) * s, h: 5.00 * s, s)
    |> bp-bar(f, x: x + (25.5+70.00) * s, y: y + (37.5+106.30) * s, h: 12.40 * s, s)
    |> bp-bar(f, x: x + (25.5+83.20) * s, y: y + (37.5+86.90) * s, h: 18.90 * s, s)
    |> bp-bar(f, x: x + (25.5+96.50) * s, y: y + (37.5+73.70) * s, h: 40.20 * s, s)
    |> bp-bar(f, x: x + (25.5+109.80) * s, y: y + (37.5+67.70) * s, h: 69.40 * s, s)
    |> bp-bar(f, x: x + (25.5+123.10) * s, y: y + (37.5+85.80) * s, h: 35.50 * s, s)
    |> bp-bar(f, x: x + (25.5+136.30) * s, y: y + (37.5+84.70) * s, h: 21.10 * s, s)
    |> bp-bar(f, x: x + (25.5+149.60) * s, y: y + (37.5+95.50) * s, h: 16.50 * s, s)
    |> bp-bar(f, x: x + (25.5+163.00) * s, y: y + (37.5+92.90) * s, h: 17.70 * s, s)
    |> bp-bar(f, x: x + (25.5+176.00) * s, y: y + (37.5+90.40) * s, h: 21.60 * s, s)
    |> bp-bar(f, x: x + (25.5+189.40) * s, y: y + (37.5+90.80) * s, h: 18.30 * s, s)
    |> bp-bar(f, x: x + (25.5+202.70) * s, y: y + (37.5+77.30) * s, h: 33.20 * s, s)
    |> bp-bar(f, x: x + (25.5+216.00) * s, y: y + (37.5+70.30) * s, h: 52.10 * s, s)
    |> bp-bar(f, x: x + (25.5+229.00) * s, y: y + (37.5+80.80) * s, h: 31.30 * s, s)
    |> bp-bar(f, x: x + (25.5+242.80) * s, y: y + (37.5+94.50) * s, h: 5.50 * s, s)
    |> bp-bar(f, x: x + (25.5+255.80) * s, y: y + (37.5+99.50) * s, h: 5.00 * s, s)
    |> bp-bar(f, x: x + (25.5+268.90) * s, y: y + (37.5+98.00) * s, h: 7.00 * s, s)
    |> bp-bar(f, x: x + (25.5+282.50) * s, y: y + (37.5+103.00) * s, h: 5.00 * s, s)
    |> bp-bar(f, x: x + (25.5+295.50) * s, y: y + (37.5+100.60) * s, h: 13.70 * s, s)
    |> bp-dot(f, x: x + (25.5+26.30) * s, y: y + (37.5+93.50) * s, s)
    |> bp-dot(f, x: x + (25.5+26.30) * s, y: y + (37.5+98.50) * s, s)
    |> bp-dot(f, x: x + (25.5+39.60) * s, y: y + (37.5+93.50) * s, s)
    |> bp-dot(f, x: x + (25.5+39.60) * s, y: y + (37.5+99.00) * s, s)
    |> bp-dot(f, x: x + (25.5+52.90) * s, y: y + (37.5+86.50) * s, s)
    |> bp-dot(f, x: x + (25.5+52.90) * s, y: y + (37.5+91.50) * s, s)
    |> bp-dot(f, x: x + (25.5+66.00) * s, y: y + (37.5+98.30) * s, s)
    |> bp-dot(f, x: x + (25.5+66.00) * s, y: y + (37.5+110.70) * s, s)
    |> bp-dot(f, x: x + (25.5+79.20) * s, y: y + (37.5+78.90) * s, s)
    |> bp-dot(f, x: x + (25.5+79.20) * s, y: y + (37.5+97.80) * s, s)
    |> bp-dot(f, x: x + (25.5+92.50) * s, y: y + (37.5+65.70) * s, s)
    |> bp-dot(f, x: x + (25.5+92.50) * s, y: y + (37.5+105.90) * s, s)
    |> bp-dot(f, x: x + (25.5+105.80) * s, y: y + (37.5+59.70) * s, s)
    |> bp-dot(f, x: x + (25.5+105.80) * s, y: y + (37.5+129.10) * s, s)
    |> bp-dot(f, x: x + (25.5+119.10) * s, y: y + (37.5+77.80) * s, s)
    |> bp-dot(f, x: x + (25.5+119.10) * s, y: y + (37.5+113.30) * s, s)
    |> bp-dot(f, x: x + (25.5+132.30) * s, y: y + (37.5+76.70) * s, s)
    |> bp-dot(f, x: x + (25.5+132.30) * s, y: y + (37.5+97.80) * s, s)
    |> bp-dot(f, x: x + (25.5+145.60) * s, y: y + (37.5+87.50) * s, s)
    |> bp-dot(f, x: x + (25.5+145.60) * s, y: y + (37.5+104.00) * s, s)
    |> bp-dot(f, x: x + (25.5+159.00) * s, y: y + (37.5+84.90) * s, s)
    |> bp-dot(f, x: x + (25.5+159.00) * s, y: y + (37.5+102.60) * s, s)
    |> bp-dot(f, x: x + (25.5+172.00) * s, y: y + (37.5+82.40) * s, s)
    |> bp-dot(f, x: x + (25.5+172.00) * s, y: y + (37.5+104.00) * s, s)
    |> bp-dot(f, x: x + (25.5+185.40) * s, y: y + (37.5+82.80) * s, s)
    |> bp-dot(f, x: x + (25.5+185.40) * s, y: y + (37.5+101.10) * s, s)
    |> bp-dot(f, x: x + (25.5+198.70) * s, y: y + (37.5+69.30) * s, s)
    |> bp-dot(f, x: x + (25.5+198.70) * s, y: y + (37.5+102.50) * s, s)
    |> bp-dot(f, x: x + (25.5+212.00) * s, y: y + (37.5+62.30) * s, s)
    |> bp-dot(f, x: x + (25.5+212.00) * s, y: y + (37.5+114.40) * s, s)
    |> bp-dot(f, x: x + (25.5+225.00) * s, y: y + (37.5+72.80) * s, s)
    |> bp-dot(f, x: x + (25.5+225.00) * s, y: y + (37.5+104.10) * s, s)
    |> bp-dot(f, x: x + (25.5+238.80) * s, y: y + (37.5+86.50) * s, s)
    |> bp-dot(f, x: x + (25.5+238.80) * s, y: y + (37.5+92.00) * s, s)
    |> bp-dot(f, x: x + (25.5+251.80) * s, y: y + (37.5+91.50) * s, s)
    |> bp-dot(f, x: x + (25.5+251.80) * s, y: y + (37.5+96.50) * s, s)
    |> bp-dot(f, x: x + (25.5+264.90) * s, y: y + (37.5+90.00) * s, s)
    |> bp-dot(f, x: x + (25.5+264.90) * s, y: y + (37.5+97.00) * s, s)
    |> bp-dot(f, x: x + (25.5+278.50) * s, y: y + (37.5+95.00) * s, s)
    |> bp-dot(f, x: x + (25.5+278.50) * s, y: y + (37.5+100.00) * s, s)
    |> bp-dot(f, x: x + (25.5+291.50) * s, y: y + (37.5+92.60) * s, s)
    |> bp-dot(f, x: x + (25.5+291.50) * s, y: y + (37.5+106.30) * s, s)

~pub tor bp-bar { f: *libs/canvas:Frame<frame>, x: f64, y: f64, h: f64, s: f64 }

~bp-bar = libs/canvas:draw.rect(f, x, y, w: 8.0 * s, h, r: 0.388, g: 0.204, b: 0.310, a: 0.22)
    |> libs/canvas:draw.rect(f, x: x + 1.4 * s, y, w: 5.2 * s, h, r: 0.388, g: 0.204, b: 0.310, a: 0.55)
    |> libs/canvas:draw.rect(f, x: x + 2.8 * s, y, w: 2.4 * s, h, r: 0.388, g: 0.204, b: 0.310, a: 0.95)

~pub tor bp-dot { f: *libs/canvas:Frame<frame>, x: f64, y: f64, s: f64 }

~bp-dot = libs/canvas:draw.shadow(f, x: x - 3.0 * s, y: y - 3.0 * s, w: 22.0 * s, h: 22.0 * s, radius: 11.0 * s, blur: 5.0 * s, r: 0.961, g: 0.537, b: 0.675, a: 0.10)
    |> libs/canvas:draw.roundrect(f, x, y, w: 16.0 * s, h: 16.0 * s, radius: 8.0 * s, r: 0.961, g: 0.537, b: 0.675, a: 0.06)
    |> libs/canvas:draw.roundrect(f, x: x + 2.0 * s, y: y + 2.0 * s, w: 12.0 * s, h: 12.0 * s, radius: 6.0 * s, r: 0.961, g: 0.537, b: 0.675, a: 0.22)
    |> libs/canvas:draw.roundrect(f, x: x + 4.0 * s, y: y + 4.0 * s, w: 8.0 * s, h: 8.0 * s, radius: 4.0 * s, r: 0.961, g: 0.537, b: 0.675, a: 0.92)
    |> libs/canvas:draw.roundrect(f, x: x + 6.0 * s, y: y + 6.0 * s, w: 4.0 * s, h: 4.0 * s, radius: 2.0 * s, r: 0.98, g: 0.66, b: 0.76, a: 1.0)

// ---- flight --------------------------------------------------------------

~pub tor reference-flight {
    win: *libs/canvas:Window<opened|active>,
    f: *libs/canvas:Frame<frame>, face: i64,
    x: f64, y: f64, s: f64,
}

~reference-flight = libs/canvas:draw.rect(f, x, y, w: 400.0 * s, h: 155.0 * s, r: 0.169, g: 0.169, b: 0.169, a: 1.0)
    |> libs/canvas:draw.shadow(f, x: x - 100.0 * s, y: y + 100.0 * s, w: 600.0 * s, h: 130.0 * s, radius: 70.0 * s, blur: 60.0 * s, r: 0.0, g: 0.0, b: 0.0, a: 0.42)
    |> libs/canvas:draw.shadow(f, x: x - 120.0 * s, y: y - 80.0 * s, w: 640.0 * s, h: 120.0 * s, radius: 60.0 * s, blur: 60.0 * s, r: 0.0, g: 0.0, b: 0.0, a: 0.25)
    |> libs/canvas:draw.shadow(f, x: x + 16.0 * s, y: y + 20.4 * s, w: 350.0 * s, h: 120.0 * s, radius: 37.5 * s, blur: 6.0 * s, r: 0.0, g: 0.0, b: 0.0, a: 0.42)
    |> libs/canvas:draw.roundrect(f, x: x + 16.0 * s, y: y + 17.4 * s, w: 350.0 * s, h: 120.0 * s, radius: 37.5 * s, r: 0.0, g: 0.0, b: 0.0, a: 1.0)
    |> libs/canvas:draw.shadow(f, x: x + 107.0 * s, y: y + 69.0 * s, w: 155.0 * s, h: 15.0 * s, radius: 8.0 * s, blur: 6.0 * s, r: 0.388, g: 0.831, b: 0.847, a: 0.12)
    |> libs/canvas:draw.roundrect(f, x: x + 109.2 * s, y: y + 70.6 * s, w: 151.5 * s, h: 12.2 * s, radius: 6.1 * s, r: 0.388, g: 0.831, b: 0.847, a: 1.0)
    |> libs/canvas:draw.shadow(f, x: x + 248.0 * s, y: y + 62.0 * s, w: 30.0 * s, h: 28.0 * s, radius: 8.0 * s, blur: 5.0 * s, r: 1.0, g: 1.0, b: 1.0, a: 0.28)
    |> soft-text(f, face, x: x + 251.0 * s, y: y + 62.0 * s, size: 20.0 * s, soft: 0.55 * s, r: 1.0, g: 1.0, b: 1.0, a: 1.0, text: "✈")
    |> soft-text(f, face, x: x + 44.5 * s, y: y + 39.0 * s, size: 16.0 * s, soft: 0.55 * s, r: 0.949, g: 0.949, b: 0.949, a: 1.0, text: "San Francisco")
    |> soft-text(f, face, x: x + 265.0 * s, y: y + 39.5 * s, size: 16.0 * s, soft: 0.55 * s, r: 0.949, g: 0.949, b: 0.949, a: 1.0, text: "Edmonton")
    |> soft-text(f, face, x: x + 44.5 * s, y: y + 64.0 * s, size: 28.0 * s, soft: 0.55 * s, r: 1.0, g: 1.0, b: 1.0, a: 1.0, text: "SFO")
    |> libs/canvas:text.offset(win, text: "YEG", size: 28.0 * s, face, index: 3) : yw
    |> soft-text(f, face, x: x + (400.0 - 57.0) * s - yw, y: y + 63.5 * s, size: 28.0 * s, soft: 0.55 * s, r: 1.0, g: 1.0, b: 1.0, a: 1.0, text: "YEG")
    |> soft-text(f, face, x: x + 45.0 * s, y: y + 96.5 * s, size: 16.0 * s, soft: 0.55 * s, r: 0.949, g: 0.949, b: 0.949, a: 1.0, text: "9:59 PM")
    |> soft-text(f, face, x: x + 126.3 * s, y: y + 97.0 * s, size: 15.3 * s, soft: 0.55 * s, r: 0.682, g: 0.792, b: 0.784, a: 1.0, text: "Arrives in 20m")
    |> libs/canvas:text.offset(win, text: "12:59 AM", size: 16.0 * s, face, index: 8) : tw
    |> soft-text(f, face, x: x + (400.0 - 57.5) * s - tw, y: y + 96.5 * s, size: 16.0 * s, soft: 0.55 * s, r: 0.949, g: 0.949, b: 0.949, a: 1.0, text: "12:59 AM")
