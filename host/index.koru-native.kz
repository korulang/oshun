// oshun/host:koru-native — the freestanding compositor host. Joins only
// under `~[build == koru-native]` (index.kz gates the part); the AppKit
// body in index.macos.kz never enters this build — that is the part
// system's whole job, and this file is its first complex stress test.
//
// What transfers from the macOS part is the CONTRACT SHAPE, not the
// code: an event ring the program drains, host.run as the pump that
// keeps it fed, quit as the exit verb, and the H.* primitives renderers
// call. What does not transfer is every line of Cocoa — this part talks
// to the kernel's koru_tick seam instead.
//
// The pump model mirrors macOS exactly: host.run BLOCKS inside the
// program's flow — prog.main() is synchronous inside shell dispatch, so
// the pump drives one desktop tick per iteration through the exported
// koru_tick (cursor/comp/win/present keep turning while it runs), drains
// the ring, and fires the effect arms at the splice site. koru_pump_set
// is NOT used here — that seam is for programs that register a callback
// and return (surf_pump), not for modal pumps with arms.
//
// v0 scope (honest): the ring shape and dispatch are real; no native
// source pushes chrome events yet (no tray/menu/hotkey/remote devices),
// so the arms simply never fire until one lands. Chrome verbs
// (tray.*/menu.*/dialog.*/notify.*/hotkey.*/mic.*/paste.*) are NOT
// declared — a consumer that calls one gets a loud unknown-tor at
// compile time, which is the spec's loud axis, not a silent stub.

// ---- event payloads -------------------------------------------------
// Field-for-field the macOS part's structs — shared consumers name the
// types and switch on the union; only variants a native source can
// produce are pushed today (none — the ring is honest plumbing).

pub const TrayActionData = struct {
    tray: i64,
    tag: i64,
    action: []const u8,
};

pub const MenuActionData = struct {
    tag: i64,
    action: []const u8,
};

pub const HotkeyData = struct {
    key: i64,
    mods: i64,
    down: i64,
};

pub const RemoteData = struct {
    button: u32,
    page: u32,
    down: u8,
};

pub const HostEvent = union(enum) {
    tray: TrayActionData,
    menu: MenuActionData,
    hotkey: HotkeyData,
    remote_button: RemoteData,
};

// ---- the ring (same discipline as the macOS part) -------------------

var ev_buf: [64]HostEvent = undefined;
var ev_actions: [64][64]u8 = undefined;
var ev_head: usize = 0;
var ev_tail: usize = 0;

fn pushEvent(e: HostEvent, action_src: []const u8) void {
    const next = (ev_tail + 1) % ev_buf.len;
    if (next == ev_head) return;
    const n = @min(action_src.len, ev_actions[0].len);
    @memcpy(ev_actions[ev_tail][0..n], action_src[0..n]);
    var ev = e;
    switch (ev) {
        .tray => |*t| t.action = ev_actions[ev_tail][0..n],
        .menu => |*m| m.action = ev_actions[ev_tail][0..n],
        .hotkey, .remote_button => {},
    }
    ev_buf[ev_tail] = ev;
    ev_tail = next;
}

pub fn popEvent() ?HostEvent {
    if (ev_head == ev_tail) return null;
    const e = ev_buf[ev_head];
    ev_head = (ev_head + 1) % ev_buf.len;
    return e;
}

pub var should_quit: bool = false;

// ---- H.* primitives (the surface renderers call) --------------------
// Same names as the macOS part where the semantics overlap, so a
// renderer written against the contract compiles against either body.

pub fn ensureApp() void {}

pub fn activateRegular() void {}

pub fn pushRemote(d: RemoteData) void {
    pushEvent(.{ .remote_button = d }, "");
}

// drain_paused — on macOS a nested pump owns the drain while it runs.
// On native every modal pump (frames, host.run) drains the ring itself
// inside its own loop; the flag exists so shared renderer code compiles
// and behaves (nothing to arbitrate here — one pump owns the thread).
pub var drain_paused: bool = false;

// serviceRunLoop — macOS pumps NSApp events here. Native: koru_tick IS
// the runloop step; this is a no-op that keeps the call shape.
pub fn serviceRunLoop() void {}

// ---- the pump --------------------------------------------------------
// host.run mirrors the macOS [app run] + NSTimer shape: install the arm
// thunks, then loop — one koru_tick (the desktop keeps compositing),
// drain the ring into the arms, count, quit-check, pace. prog.main()
// stays blocked inside this call; when it returns the shell loop resumes.
//
// The kernel exports this part calls — provided by koru-os-m1's native
// image (shell.zig / runtime.zig), resolved at link, absent on hosted
// builds where this part never joins.

extern fn koru_tick() callconv(.c) void;
extern fn ukplat_monotonic_clock() callconv(.c) u64; // ns, TSC-calibrated

fn sleepNs(ns: u64) void {
    const t0 = ukplat_monotonic_clock();
    while (ukplat_monotonic_clock() - t0 < ns) {}
}

// koru_tick can't be named bare inside the spliced host.run body — the
// extern rides a module fn like every other module-scope reach.
fn hostTick() void {
    koru_tick();
}

// Arms-as-values, the same mechanism the macOS part uses: the proc
// installs thunks for its effect arms; the drain calls them. Optional
// arms the consumer didn't bind arrive as generated no-ops.
const HostArms = struct {
    tray: *const fn (TrayActionData) void,
    menu: *const fn (MenuActionData) void,
    hotkey: *const fn (HotkeyData) void,
    remote: *const fn (RemoteData) void,
};
var host_arms: ?HostArms = null;

fn hostDrain() void {
    const arms = host_arms orelse return;
    while (popEvent()) |hev| {
        switch (hev) {
            .tray => |td| arms.tray(td),
            .menu => |md| arms.menu(md),
            .hotkey => |hk| arms.hotkey(hk),
            .remote_button => |rd| arms.remote(rd),
        }
    }
}

~pub tor host.run { count: ?i32 }
! ?tray-action libs/host:TrayActionData
! ?menu-action libs/host:MenuActionData
! ?hotkey libs/host:HotkeyData
! ?remote-button libs/host:RemoteData
| done

~proc host.run|zig {
    const __cap = @as(?i32, count) orelse 2147483647;
    $mod.host_arms = .{ .tray = tray_action, .menu = menu_action, .hotkey = hotkey, .remote = remote_button };
    defer $mod.host_arms = null;
    $mod.drain_paused = true;
    defer $mod.drain_paused = false;
    var i: i32 = 0;
    while (i < __cap) : (i += 1) {
        $mod.hostTick();
        $mod.hostDrain();
        if ($mod.should_quit) break;
        $mod.sleepNs(4_000_000); // ~4ms — the macOS pump's timer interval
    }
    return .{ .done = .{} };
}

~pub tor quit {}

~proc quit|zig {
    should_quit = true;
}
