// oshun/host:macos — the AppKit half of the platform layer.
//
// Three pieces, one file:
//
//   1. The ObjC-runtime bridge — sel/cls/send arity helpers over
//      objc_msgSend. Shared platform substrate: every macos module
//      (host verbs here, the metal renderer next door) talks Cocoa
//      through these; there is no .m file and no wrapper library.
//   2. The tray mailbox — the ObjC ↔ Koru boundary for host chrome.
//      ObjC IMPs are plain C functions: they cannot call Koru effect
//      arms, so they PUSH events into this ring, and a pump — `frames`
//      in metal, `host.run` here — drains it at the splice site where
//      arms are callable. Window input rides metal's own ring; each
//      module owns the vocabulary its sources produce.
//   3. The chrome verbs — tray today. Status item, menu items, the
//      KoruTrayTarget whose IMPs push into the tray ring.

~import std/build

~std/build:requires {
    exe.linkLibC();
    exe.linkFramework("Cocoa");
    exe.linkFramework("CoreFoundation");
}

const std = @import("std");

pub const objc = @cImport({
    @cInclude("objc/runtime.h");
    @cInclude("objc/message.h");
    @cInclude("objc/objc.h");
});

pub const cf = @cImport({
    @cInclude("CoreFoundation/CoreFoundation.h");
});

pub const Id = ?*anyopaque;
pub const SEL = objc.SEL;

pub extern fn objc_autoreleasePoolPush() callconv(.c) *anyopaque;
pub extern fn objc_autoreleasePoolPop(*anyopaque) callconv(.c) void;
pub extern fn CFStringGetCString(s: ?*const anyopaque, buf: [*]u8, max: isize, enc: u32) callconv(.c) bool;
pub extern var NSDefaultRunLoopMode: Id;
pub extern var kCFRunLoopDefaultMode: Id;
pub extern fn CFRunLoopRunInMode(mode: Id, seconds: f64, handled: bool) callconv(.c) i32;

// Service the run loop the manual pump starves. nextEventMatchingMask
// only spins the run loop while it WAITS — our nil untilDate never
// waits, so every run-loop source in the process (timers, tracking
// areas, deferred selectors, the system menu bar's auto-hide reveal)
// is dead without this. Zero-cost: returns as soon as sources drain.
pub fn serviceRunLoop() void {
    _ = CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0, true);
}

// ============================================================================
// The bridge. msgSend, arity-indexed — objc_msgSend is an unprototyped
// forwarder; the call's real signature is asserted per use by the
// fn-pointer cast.
// ============================================================================

pub fn sel(comptime name: [:0]const u8) SEL {
    return objc.sel_registerName(name);
}

pub fn cls(comptime name: [:0]const u8) Id {
    return @ptrCast(objc.objc_getClass(name));
}

pub fn send(comptime R: type, recv: Id, selector: SEL) R {
    return @as(*const fn (Id, SEL) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector);
}

pub fn send1(comptime R: type, comptime A1: type, recv: Id, selector: SEL, a1: A1) R {
    return @as(*const fn (Id, SEL, A1) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1);
}

pub fn send2(comptime R: type, comptime A1: type, comptime A2: type, recv: Id, selector: SEL, a1: A1, a2: A2) R {
    return @as(*const fn (Id, SEL, A1, A2) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1, a2);
}

pub fn send3(comptime R: type, comptime A1: type, comptime A2: type, comptime A3: type, recv: Id, selector: SEL, a1: A1, a2: A2, a3: A3) R {
    return @as(*const fn (Id, SEL, A1, A2, A3) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1, a2, a3);
}

pub fn send4(comptime R: type, comptime A1: type, comptime A2: type, comptime A3: type, comptime A4: type, recv: Id, selector: SEL, a1: A1, a2: A2, a3: A3, a4: A4) R {
    return @as(*const fn (Id, SEL, A1, A2, A3, A4) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1, a2, a3, a4);
}

pub fn cstr(title: []const u8, buf: []u8) [*:0]const u8 {
    const n = @min(title.len, buf.len - 1);
    @memcpy(buf[0..n], title[0..n]);
    buf[n] = 0;
    return @ptrCast(buf.ptr);
}

// sharedApplication is idempotent and finishLaunching twice is harmless —
// a tray must not require a window, so every entry point that needs NSApp
// acquires it through here.
pub fn ensureApp() Id {
    const app = send(Id, cls("NSApplication"), sel("sharedApplication"));
    send(void, app, sel("finishLaunching"));
    return app;
}

// An unbundled binary launches with no real activation policy: its
// windows can look key while the process never owns a menu bar — under
// auto-hide the reveal zone stays dead because there is no bar to
// reveal to. Windowed apps must declare Regular; tray-only apps declare
// Accessory (an agent: status item, no dock icon, no bar). The last
// call wins, so window.open after tray.new upgrades cleanly.
//   0 = NSApplicationActivationPolicyRegular
//   1 = NSApplicationActivationPolicyAccessory
pub fn setActivationPolicy(p: i64) void {
    send1(void, i64, ensureApp(), sel("setActivationPolicy:"), p);
}

// Windowed activation: Regular policy, a minimal main menu so the bar
// has something to own (until the menu verb exists, an empty NSMenu is
// enough — AppKit draws the app-name menu around it), and activate so
// the frontmost app is actually us.
pub fn activateRegular() Id {
    const app = ensureApp();
    setActivationPolicy(0);
    if (send(Id, app, sel("mainMenu")) == null) {
        send1(void, Id, app, sel("setMainMenu:"), send(Id, send(Id, cls("NSMenu"), sel("alloc")), sel("init")));
    }
    send1(void, bool, app, sel("activateIgnoringOtherApps:"), true);
    return app;
}

// ============================================================================
// Chrome mailbox — the ObjC ↔ Koru boundary for host-chrome events. ObjC
// IMPs are plain C functions: they cannot call Koru effect arms, so they
// PUSH into this ring, and a pump — `frames` in metal, `host.run` here —
// drains it and dispatches. Window input rides its own ring in metal;
// chrome verbs (tray, menu, later dialogs/notifications) share ONE ring
// so a pump's drain site never changes as the vocabulary grows.
// ============================================================================

// A status-item event. `tray` is the tray.new registration slot, `tag` the
// NSMenuItem tag (integer `when` matching, no string compare), `action` its
// representedObject — valid until the ring slot wraps. A bare button click
// (no menu attached) carries tag -1 and an empty action.
pub const TrayActionData = struct {
    tray: i64,
    tag: i64,
    action: []const u8,
};

// A main-menu event — tag/action straight from the NSMenuItem, same
// matching contract as tray (integer `when` on tag).
pub const MenuActionData = struct {
    tag: i64,
    action: []const u8,
};

pub const HostEvent = union(enum) {
    tray: TrayActionData,
    menu: MenuActionData,
};

var ev_buf: [64]HostEvent = undefined;
// Char backing for action strings — a parallel ring, same wrap semantics
// as the view's ev_chars.
var ev_actions: [64][64]u8 = undefined;
var ev_head: usize = 0;
var ev_tail: usize = 0;

fn pushEvent(e: HostEvent, action_src: []const u8) void {
    const next = (ev_tail + 1) % ev_buf.len;
    if (next == ev_head) return;
    const n = @min(action_src.len, ev_actions[0].len);
    @memcpy(ev_actions[ev_tail][0..n], action_src[0..n]);
    var ev = e;
    switch (ev) {
        .tray => |*t| t.action = ev_actions[ev_tail][0..n],
        .menu => |*m| m.action = ev_actions[ev_tail][0..n],
    }
    ev_buf[ev_tail] = ev;
    ev_tail = next;
}

fn trayPushAction(tray: i64, tag: i64, action: []const u8) void {
    pushEvent(.{ .tray = .{ .tray = tray, .tag = tag, .action = &.{} } }, action);
}

fn menuPushAction(tag: i64, action: []const u8) void {
    pushEvent(.{ .menu = .{ .tag = tag, .action = &.{} } }, action);
}

pub fn popEvent() ?HostEvent {
    if (ev_head == ev_tail) return null;
    const e = ev_buf[ev_head];
    ev_head = (ev_head + 1) % ev_buf.len;
    return e;
}

pub var should_quit: bool = false;

// ============================================================================
// Status item — the first host verb (electrobun's createTray shape):
// an NSStatusBar item plus a runtime-registered KoruTrayTarget NSObject
// receiving target/action callbacks. Same mailbox discipline as the view
// IMPs: menuItemClicked:/statusItemClicked: push tray_action, and a pump
// drains it into the `! tray-action` arm. Where electrobun takes a JSON
// menu tree, items arrive one tor call at a time and match on native
// NSMenuItem.tag.
// ============================================================================

const MAX_TRAYS = 8;
var tray_class: ?objc.Class = null;
// target instance -> registration slot, consulted by the IMPs. Slots freed
// by tray.remove go null and are reused by the next tray.new.
var tray_targets: [MAX_TRAYS]Id = .{null} ** MAX_TRAYS;
var tray_count: usize = 0;

fn traySlotFor(recv: Id) ?usize {
    for (0..tray_count) |i| {
        if (tray_targets[i] == recv) return i;
    }
    return null;
}

// tag + representedObject off the clicked NSMenuItem — shared by every
// chrome click IMP. The action slice points into `tmp`; the ring push
// copies it before the IMP returns.
fn readTagAndAction(sender: Id, tmp: *[64]u8) struct { tag: i64, action: []const u8 } {
    var action: []const u8 = &.{};
    const robj = send(Id, sender, sel("representedObject"));
    if (robj != null and CFStringGetCString(robj, tmp, tmp.len, cf.kCFStringEncodingUTF8)) {
        action = tmp[0..std.mem.len(@as([*:0]u8, @ptrCast(tmp)))];
    }
    return .{ .tag = send(i64, sender, sel("tag")), .action = action };
}

fn impStatusItemClicked(recv: Id, _s: SEL, sender: Id) callconv(.c) void {
    _ = _s;
    _ = sender;
    const slot = traySlotFor(recv) orelse return;
    trayPushAction(@intCast(slot), -1, "");
}

fn impMenuItemClicked(recv: Id, _s: SEL, sender: Id) callconv(.c) void {
    _ = _s;
    const slot = traySlotFor(recv) orelse return;
    var tmp: [64]u8 = undefined;
    const e = readTagAndAction(sender, &tmp);
    trayPushAction(@intCast(slot), e.tag, e.action);
}

// Main-menu clicks land on a single shared target — unlike trays, a
// MenuActionData carries no source slot, so one instance serves every
// menu item in the process.
fn impMenuClicked(recv: Id, _s: SEL, sender: Id) callconv(.c) void {
    _ = recv;
    _ = _s;
    var tmp: [64]u8 = undefined;
    const e = readTagAndAction(sender, &tmp);
    menuPushAction(e.tag, e.action);
}

var menu_class: ?objc.Class = null;
var menu_target: ?Id = null;

fn ensureMenuTarget() ?Id {
    if (menu_target) |t| return t;
    const sup: objc.Class = @ptrCast(cls("NSObject"));
    const c = objc.objc_allocateClassPair(sup, "KoruMenuTarget", 0) orelse return null;
    _ = objc.class_addMethod(c, sel("menuItemClicked:"), @ptrCast(&impMenuClicked), "v@:@");
    objc.objc_registerClassPair(c);
    menu_class = c;
    const t = send(Id, send(Id, @as(Id, @ptrCast(c)), sel("alloc")), sel("init"));
    menu_target = t;
    return t;
}

fn ensureTrayClass() ?objc.Class {
    if (tray_class) |c| return c;
    const sup: objc.Class = @ptrCast(cls("NSObject"));
    const c = objc.objc_allocateClassPair(sup, "KoruTrayTarget", 0) orelse return null;
    _ = objc.class_addMethod(c, sel("statusItemClicked:"), @ptrCast(&impStatusItemClicked), "v@:@");
    _ = objc.class_addMethod(c, sel("menuItemClicked:"), @ptrCast(&impMenuItemClicked), "v@:@");
    objc.objc_registerClassPair(c);
    tray_class = c;
    return c;
}

// The status-item token. `sitem` is the NSStatusItem, `target` the
// KoruTrayTarget receiving its callbacks, `menu` lazily created by the
// first tray.item, `slot` the registration index TrayActionData reports.
// tray.new grants <ready>; tray.remove is the only consumer.
pub const Tray = struct {
    sitem: Id,
    target: Id,
    menu: ?Id,
    slot: usize,
};

// ============================================================================
// Tray lifecycle. `ready` — fresh from tray.new, items attachable,
// removable. tray.remove is the only <!ready> consumer.
// ============================================================================

~pub tor tray.new { title: string }
| tray *Tray<ready!>
| err string

~proc tray.new|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);

    const app = ensureApp();
    // A status item is agent UI — declare Accessory so a tray-only app
    // never claims the menu bar. Never downgrade: a window.open that
    // already ran made us Regular, and the bar is worth more than the
    // agent flag. window.open itself upgrades unconditionally.
    if (send(i64, app, sel("activationPolicy")) != 0) {
        setActivationPolicy(1);
    }

    const tc = ensureTrayClass() orelse {
        return .{ .err = "host: KoruTrayTarget class registration failed" };
    };
    var slot: usize = MAX_TRAYS;
    for (0..tray_count) |i| {
        if (tray_targets[i] == null) {
            slot = i;
            break;
        }
    }
    if (slot == MAX_TRAYS) {
        if (tray_count >= MAX_TRAYS) return .{ .err = "host: tray table full" };
        slot = tray_count;
        tray_count += 1;
    }
    const target = send(Id, send(Id, @as(Id, @ptrCast(tc)), sel("alloc")), sel("init"));

    const bar = send(Id, cls("NSStatusBar"), sel("systemStatusBar"));
    const item = send1(Id, f64, bar, sel("statusItemWithLength:"), -1.0); // NSVariableStatusItemLength
    if (item == null) return .{ .err = "host: statusItemWithLength failed" };
    // The bar does NOT retain the item — it is autoreleased, dies when this
    // proc's pool pops, and sitem dangles into whatever reuses the memory
    // (electrobun's retainObjCObject is the same discovery). tray.remove
    // sends the matching release after removeStatusItem:.
    _ = send(Id, item, sel("retain"));

    var tbuf: [256]u8 = undefined;
    const titleStr = cf.CFStringCreateWithCString(null, cstr(title, &tbuf), cf.kCFStringEncodingUTF8);
    const btn = send(Id, item, sel("button"));
    send1(void, Id, btn, sel("setTitle:"), @as(Id, @ptrCast(@constCast(titleStr))));
    send1(void, Id, btn, sel("setTarget:"), target);
    send1(void, SEL, btn, sel("setAction:"), sel("statusItemClicked:"));
    // LeftMouseUp|RightMouseUp — fires statusItemClicked: only while no
    // menu is attached; an attached menu owns the click itself.
    send1(void, u64, btn, sel("sendActionOn:"), 10);

    tray_targets[slot] = target;
    const t = std.heap.page_allocator.create(Tray) catch @panic("host: OOM allocating Tray token");
    t.* = .{ .sitem = item, .target = target, .menu = null, .slot = slot };
    return .{ .tray = t };
}

// The status item's menu is created lazily so a click-only tray never pays
// for one — and so tray.new's button-click path stays live until the first
// item lands (an attached menu owns the click; AppKit's contract).
fn ensureMenu(tray: *Tray) void {
    if (tray.menu != null) return;
    tray.menu = send(Id, send(Id, cls("NSMenu"), sel("alloc")), sel("init"));
    send1(void, Id, tray.sitem, sel("setMenu:"), tray.menu.?);
}

// One menu entry: label shown, `action` carried as representedObject into
// TrayActionData, `tag` the native NSMenuItem tag for integer matching.
~pub tor tray.item { tray: *Tray<ready>, label: string, action: string, tag: i64 }

~proc tray.item|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    ensureMenu(tray);
    var lbuf: [256]u8 = undefined;
    var abuf: [64]u8 = undefined;
    var ebuf: [1]u8 = .{0};
    const labelStr = cf.CFStringCreateWithCString(null, cstr(label, &lbuf), cf.kCFStringEncodingUTF8);
    const actStr = cf.CFStringCreateWithCString(null, cstr(action, &abuf), cf.kCFStringEncodingUTF8);
    const emptyStr = cf.CFStringCreateWithCString(null, @as([*:0]const u8, @ptrCast(&ebuf)), cf.kCFStringEncodingUTF8);
    const mi = send3(
        Id, Id, SEL, Id,
        send(Id, cls("NSMenuItem"), sel("alloc")),
        sel("initWithTitle:action:keyEquivalent:"),
        @as(Id, @ptrCast(@constCast(labelStr))), sel("menuItemClicked:"), @as(Id, @ptrCast(@constCast(emptyStr))),
    );
    send1(void, Id, mi, sel("setTarget:"), tray.target);
    send1(void, Id, mi, sel("setRepresentedObject:"), @as(Id, @ptrCast(@constCast(actStr))));
    send1(void, i64, mi, sel("setTag:"), tag);
    send1(void, Id, tray.menu.?, sel("addItem:"), mi);
    send(void, mi, sel("release"));
}

~pub tor tray.sep { tray: *Tray<ready> }

~proc tray.sep|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    ensureMenu(tray);
    const sep = send(Id, cls("NSMenuItem"), sel("separatorItem"));
    send1(void, Id, tray.menu.?, sel("addItem:"), sep);
}

~pub tor tray.title { tray: *Tray<ready>, title: string }

~proc tray.title|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    var tbuf: [256]u8 = undefined;
    const titleStr = cf.CFStringCreateWithCString(null, cstr(title, &tbuf), cf.kCFStringEncodingUTF8);
    send1(void, Id, send(Id, tray.sitem, sel("button")), sel("setTitle:"), @as(Id, @ptrCast(@constCast(titleStr))));
}

~pub tor tray.remove { tray: *Tray<!ready> }

~proc tray.remove|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    const bar = send(Id, cls("NSStatusBar"), sel("systemStatusBar"));
    send1(void, Id, bar, sel("removeStatusItem:"), tray.sitem);
    // Balances the retain in tray.new; the target was ours (alloc/init).
    send(void, tray.sitem, sel("release"));
    send(void, tray.target, sel("release"));
    tray_targets[tray.slot] = null;
    std.heap.page_allocator.destroy(tray);
}

// ============================================================================
// Automation: a synthesized tray action enters the SAME mailbox the IMPs
// write — verifies ring -> arm dispatch without AX trust.
// ============================================================================

~pub tor tray.action { tray: i64, tag: i64, action: string }

~proc tray.action|zig {
    trayPushAction(tray, tag, action);
}

// ============================================================================
// Main menu — the second host verb. macOS shape: NSApp.mainMenu holds one
// NSMenuItem per bar heading ("App", "File", "Edit"), each carrying a
// submenu NSMenu of real items. Same target/action/tag/representedObject
// mechanics as the tray — one shared KoruMenuTarget, one chrome ring.
// menu.new grants <ready>; menu.remove is the only consumer. Bars are
// plain <ready> borrows — remove frees them with the menu.
// ============================================================================

pub const Menu = struct {
    m: Id,
};

pub const MenuBar = struct {
    sub: Id,
};

const MAX_BARS = 32;
var menu_bars: [MAX_BARS]*MenuBar = undefined;
var menu_bar_count: usize = 0;

// A main menu implies a regular app — activateRegular upgrades the
// policy and replaces the empty scaffolding menu with ours.
~pub tor menu.new {}
| menu *Menu<ready!>
| err string

~proc menu.new|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    const app = activateRegular();
    _ = ensureMenuTarget() orelse {
        return .{ .err = "host: KoruMenuTarget class registration failed" };
    };
    const m = send(Id, send(Id, cls("NSMenu"), sel("alloc")), sel("init"));
    send1(void, Id, app, sel("setMainMenu:"), m);
    const t = std.heap.page_allocator.create(Menu) catch @panic("host: OOM allocating Menu token");
    t.* = .{ .m = m };
    return .{ .menu = t };
}

// One bar heading — its title shows in the menu bar; items attach to
// the submenu it owns.
~pub tor menu.bar { menu: *Menu<ready>, title: string }
| bar *MenuBar<ready>
| err string

~proc menu.bar|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    if (menu_bar_count >= MAX_BARS) {
        return .{ .err = "host: bar table full" };
    }
    var tbuf: [256]u8 = undefined;
    const titleStr = cf.CFStringCreateWithCString(null, cstr(title, &tbuf), cf.kCFStringEncodingUTF8);
    const sub = send(Id, send(Id, cls("NSMenu"), sel("alloc")), sel("init"));
    send1(void, Id, sub, sel("setTitle:"), @as(Id, @ptrCast(@constCast(titleStr))));
    const heading = send(Id, send(Id, cls("NSMenuItem"), sel("alloc")), sel("init"));
    send1(void, Id, heading, sel("setTitle:"), @as(Id, @ptrCast(@constCast(titleStr))));
    send1(void, Id, heading, sel("setSubmenu:"), sub);
    send1(void, Id, menu.m, sel("addItem:"), heading);
    send(void, heading, sel("release"));
    send(void, sub, sel("release"));
    const b = std.heap.page_allocator.create(MenuBar) catch @panic("host: OOM allocating MenuBar token");
    b.* = .{ .sub = sub };
    menu_bars[menu_bar_count] = b;
    menu_bar_count += 1;
    return .{ .bar = b };
}

// One menu entry — `key` is the keyEquivalent: "q" yields Cmd-Q for
// free (Command is the default modifier mask). `action` rides into
// MenuActionData as representedObject; `tag` is the integer matcher.
~pub tor menu.item { bar: *MenuBar<ready>, label: string, key: string, action: string, tag: i64 }

~proc menu.item|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    var lbuf: [256]u8 = undefined;
    var abuf: [64]u8 = undefined;
    var kbuf: [16]u8 = undefined;
    const labelStr = cf.CFStringCreateWithCString(null, cstr(label, &lbuf), cf.kCFStringEncodingUTF8);
    const actStr = cf.CFStringCreateWithCString(null, cstr(action, &abuf), cf.kCFStringEncodingUTF8);
    const keyStr = cf.CFStringCreateWithCString(null, cstr(key, &kbuf), cf.kCFStringEncodingUTF8);
    const mi = send3(
        Id, Id, SEL, Id,
        send(Id, cls("NSMenuItem"), sel("alloc")),
        sel("initWithTitle:action:keyEquivalent:"),
        @as(Id, @ptrCast(@constCast(labelStr))), sel("menuItemClicked:"), @as(Id, @ptrCast(@constCast(keyStr))),
    );
    send1(void, Id, mi, sel("setTarget:"), menu_target.?);
    send1(void, Id, mi, sel("setRepresentedObject:"), @as(Id, @ptrCast(@constCast(actStr))));
    send1(void, i64, mi, sel("setTag:"), tag);
    send1(void, Id, bar.sub, sel("addItem:"), mi);
    send(void, mi, sel("release"));
}

~pub tor menu.sep { bar: *MenuBar<ready> }

~proc menu.sep|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    const sep = send(Id, cls("NSMenuItem"), sel("separatorItem"));
    send1(void, Id, bar.sub, sel("addItem:"), sep);
}

~pub tor menu.remove { menu: *Menu<!ready> }

~proc menu.remove|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    send1(void, Id, ensureApp(), sel("setMainMenu:"), @as(Id, null));
    // The menu retains its headings, they retain their submenus — one
    // release takes the whole tree.
    send(void, menu.m, sel("release"));
    for (0..menu_bar_count) |i| {
        std.heap.page_allocator.destroy(menu_bars[i]);
    }
    menu_bar_count = 0;
    std.heap.page_allocator.destroy(menu);
}

// Automation: a synthesized menu action enters the SAME ring the IMP
// writes — verifies ring -> arm dispatch without AX trust.
~pub tor menu.action { tag: i64, action: string }

~proc menu.action|zig {
    menuPushAction(tag, action);
}

// ============================================================================
// host.run — the windowless pump. AppKit still needs its event loop
// serviced for a menu to open or a click to arrive, so the shape is
// frames-minus-render: acquire NSApp, pump pending events, drain the
// mailbox into arms, honor quit(). `count` bounds the loop so tests halt.
// ============================================================================

~pub tor host.run { count: ?i32 }
! ?tray-action libs/host:TrayActionData
! ?menu-action libs/host:MenuActionData
| done

~proc host.run|zig {
    const __cap = @as(?i32, count) orelse 2147483647;
    const app = $mod.ensureApp();
    var i: i32 = 0;
    while (i < __cap) : (i += 1) {
        const pool = $mod.objc_autoreleasePoolPush();
        defer $mod.objc_autoreleasePoolPop(pool);
        while (true) {
            const ev = $mod.send4(
                $mod.Id, u64, $mod.Id, $mod.Id, bool,
                app,
                $mod.sel("nextEventMatchingMask:untilDate:inMode:dequeue:"),
                $mod.std.math.maxInt(u64), @as($mod.Id, null), $mod.NSDefaultRunLoopMode, true,
            );
            if (ev == null) break;
            $mod.send1(void, $mod.Id, app, $mod.sel("sendEvent:"), ev);
        }
        $mod.send(void, app, $mod.sel("updateWindows"));
        $mod.serviceRunLoop();
        while ($mod.popEvent()) |hev| {
            switch (hev) {
                .tray => |td| tray_action(td),
                .menu => |md| menu_action(md),
            }
        }
        if ($mod.should_quit) break;
        $mod.std.Thread.sleep(16 * $mod.std.time.ns_per_ms);
    }
    return .{ .done = .{} };
}

// Request the pump to exit at the next iteration — same shape as
// vaxis:quit. Sets a module flag; frames and host.run check it after
// mailbox dispatch.
~pub tor quit {}

~proc quit|zig {
    should_quit = true;
}
