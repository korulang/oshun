// oshun/host:macos — the AppKit half of the platform layer.
//
// Three pieces, one file:
//
//   1. The ObjC-runtime bridge — sel/cls/send arity helpers over
//      objc_msgSend. Shared platform substrate: every macos module
//      (host verbs here, the metal renderer next door) talks Cocoa
//      through these; there is no .m file and no wrapper library.
//   2. The tray mailbox — the ObjC ↔ Koru boundary for host chrome.
//      ObjC IMPs are plain C functions: they cannot call Koru effect
//      arms, so they PUSH events into this ring, and a pump — `frames`
//      in metal, `host.run` here — drains it at the splice site where
//      arms are callable. Window input rides metal's own ring; each
//      module owns the vocabulary its sources produce.
//   3. The chrome verbs — tray today. Status item, menu items, the
//      KoruTrayTarget whose IMPs push into the tray ring.

~import std/build

~std/build:requires {
    exe.linkLibC();
    exe.linkFramework("Cocoa");
    exe.linkFramework("CoreFoundation");
    exe.linkFramework("UserNotifications");
    exe.linkFramework("Carbon");
    exe.linkFramework("AudioToolbox");
}

const std = @import("std");

pub const objc = @cImport({
    @cInclude("objc/runtime.h");
    @cInclude("objc/message.h");
    @cInclude("objc/objc.h");
});

pub const cf = @cImport({
    @cInclude("CoreFoundation/CoreFoundation.h");
});

pub const Id = ?*anyopaque;
pub const SEL = objc.SEL;

pub extern fn objc_autoreleasePoolPush() callconv(.c) *anyopaque;
pub extern fn objc_autoreleasePoolPop(*anyopaque) callconv(.c) void;
pub extern fn CFStringGetCString(s: ?*const anyopaque, buf: [*]u8, max: isize, enc: u32) callconv(.c) bool;
pub extern var NSDefaultRunLoopMode: Id;
pub extern var kCFRunLoopDefaultMode: Id;
pub extern fn CFRunLoopRunInMode(mode: Id, seconds: f64, handled: bool) callconv(.c) i32;

// Service the run loop the manual pump starves. nextEventMatchingMask
// only spins the run loop while it WAITS — our nil untilDate never
// waits, so every run-loop source in the process (timers, tracking
// areas, deferred selectors, the system menu bar's auto-hide reveal)
// is dead without this. Zero-cost: returns as soon as sources drain.
pub fn serviceRunLoop() void {
    _ = CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0, true);
}

// One drain of the app's pending NSEvent queue — sendEvent routes each
// to its window; updateWindows flushes pending display. Shared by both
// pumps and by the dialog spin loop (a modal dialog is a nested pump).
pub fn pumpEvents(app: Id) void {
    while (true) {
        const ev = send4(
            Id, u64, Id, Id, bool,
            app,
            sel("nextEventMatchingMask:untilDate:inMode:dequeue:"),
            std.math.maxInt(u64), @as(Id, null), NSDefaultRunLoopMode, true,
        );
        if (ev == null) break;
        send1(void, Id, app, sel("sendEvent:"), ev);
    }
    send(void, app, sel("updateWindows"));
}

// ============================================================================
// The bridge. msgSend, arity-indexed — objc_msgSend is an unprototyped
// forwarder; the call's real signature is asserted per use by the
// fn-pointer cast.
// ============================================================================

pub fn sel(comptime name: [:0]const u8) SEL {
    return objc.sel_registerName(name);
}

pub fn cls(comptime name: [:0]const u8) Id {
    return @ptrCast(objc.objc_getClass(name));
}

pub fn send(comptime R: type, recv: Id, selector: SEL) R {
    return @as(*const fn (Id, SEL) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector);
}

pub fn send1(comptime R: type, comptime A1: type, recv: Id, selector: SEL, a1: A1) R {
    return @as(*const fn (Id, SEL, A1) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1);
}

pub fn send2(comptime R: type, comptime A1: type, comptime A2: type, recv: Id, selector: SEL, a1: A1, a2: A2) R {
    return @as(*const fn (Id, SEL, A1, A2) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1, a2);
}

pub fn send3(comptime R: type, comptime A1: type, comptime A2: type, comptime A3: type, recv: Id, selector: SEL, a1: A1, a2: A2, a3: A3) R {
    return @as(*const fn (Id, SEL, A1, A2, A3) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1, a2, a3);
}

pub fn send4(comptime R: type, comptime A1: type, comptime A2: type, comptime A3: type, comptime A4: type, recv: Id, selector: SEL, a1: A1, a2: A2, a3: A3, a4: A4) R {
    return @as(*const fn (Id, SEL, A1, A2, A3, A4) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1, a2, a3, a4);
}

pub fn send5(comptime R: type, comptime A1: type, comptime A2: type, comptime A3: type, comptime A4: type, comptime A5: type, recv: Id, selector: SEL, a1: A1, a2: A2, a3: A3, a4: A4, a5: A5) R {
    return @as(*const fn (Id, SEL, A1, A2, A3, A4, A5) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1, a2, a3, a4, a5);
}

pub fn cstr(title: []const u8, buf: []u8) [*:0]const u8 {
    const n = @min(title.len, buf.len - 1);
    @memcpy(buf[0..n], title[0..n]);
    buf[n] = 0;
    return @ptrCast(buf.ptr);
}

// sharedApplication is idempotent and finishLaunching twice is harmless —
// a tray must not require a window, so every entry point that needs NSApp
// acquires it through here.
pub fn ensureApp() Id {
    const app = send(Id, cls("NSApplication"), sel("sharedApplication"));
    send(void, app, sel("finishLaunching"));
    return app;
}

// An unbundled binary launches with no real activation policy: its
// windows can look key while the process never owns a menu bar — under
// auto-hide the reveal zone stays dead because there is no bar to
// reveal to. Windowed apps must declare Regular; tray-only apps declare
// Accessory (an agent: status item, no dock icon, no bar). The last
// call wins, so window.open after tray.new upgrades cleanly.
//   0 = NSApplicationActivationPolicyRegular
//   1 = NSApplicationActivationPolicyAccessory
pub fn setActivationPolicy(p: i64) void {
    send1(void, i64, ensureApp(), sel("setActivationPolicy:"), p);
}

// Windowed activation: Regular policy, a minimal main menu so the bar
// has something to own (until the menu verb exists, an empty NSMenu is
// enough — AppKit draws the app-name menu around it), and activate so
// the frontmost app is actually us.
pub fn activateRegular() Id {
    const app = ensureApp();
    setActivationPolicy(0);
    if (send(Id, app, sel("mainMenu")) == null) {
        send1(void, Id, app, sel("setMainMenu:"), send(Id, send(Id, cls("NSMenu"), sel("alloc")), sel("init")));
    }
    send1(void, bool, app, sel("activateIgnoringOtherApps:"), true);
    return app;
}

// ============================================================================
// Chrome mailbox — the ObjC ↔ Koru boundary for host-chrome events. ObjC
// IMPs are plain C functions: they cannot call Koru effect arms, so they
// PUSH into this ring, and a pump — `frames` in metal, `host.run` here —
// drains it and dispatches. Window input rides its own ring in metal;
// chrome verbs (tray, menu, later dialogs/notifications) share ONE ring
// so a pump's drain site never changes as the vocabulary grows.
// ============================================================================

// A status-item event. `tray` is the tray.new registration slot, `tag` the
// NSMenuItem tag (integer `when` matching, no string compare), `action` its
// representedObject — valid until the ring slot wraps. A bare button click
// (no menu attached) carries tag -1 and an empty action.
pub const TrayActionData = struct {
    tray: i64,
    tag: i64,
    action: []const u8,
};

// A main-menu event — tag/action straight from the NSMenuItem, same
// matching contract as tray (integer `when` on tag).
pub const MenuActionData = struct {
    tag: i64,
    action: []const u8,
};

// A global-hotkey event — the watched key/mods echoed back so `when`
// guards match on them, `down` 1 on press / 0 on release. Press AND
// release both land: hold-to-talk is the load this exists for.
pub const HotkeyData = struct {
    key: i64,
    mods: i64,
    down: i64,
};

pub const HostEvent = union(enum) {
    tray: TrayActionData,
    menu: MenuActionData,
    hotkey: HotkeyData,
};

var ev_buf: [64]HostEvent = undefined;
// Char backing for action strings — a parallel ring, same wrap semantics
// as the view's ev_chars.
var ev_actions: [64][64]u8 = undefined;
var ev_head: usize = 0;
var ev_tail: usize = 0;

fn pushEvent(e: HostEvent, action_src: []const u8) void {
    const next = (ev_tail + 1) % ev_buf.len;
    if (next == ev_head) return;
    const n = @min(action_src.len, ev_actions[0].len);
    @memcpy(ev_actions[ev_tail][0..n], action_src[0..n]);
    var ev = e;
    switch (ev) {
        .tray => |*t| t.action = ev_actions[ev_tail][0..n],
        .menu => |*m| m.action = ev_actions[ev_tail][0..n],
        .hotkey => {},
    }
    ev_buf[ev_tail] = ev;
    ev_tail = next;
}

fn trayPushAction(tray: i64, tag: i64, action: []const u8) void {
    pushEvent(.{ .tray = .{ .tray = tray, .tag = tag, .action = &.{} } }, action);
}

fn menuPushAction(tag: i64, action: []const u8) void {
    pushEvent(.{ .menu = .{ .tag = tag, .action = &.{} } }, action);
}

fn pushHotkey(d: HotkeyData) void {
    pushEvent(.{ .hotkey = d }, "");
}

pub fn popEvent() ?HostEvent {
    if (ev_head == ev_tail) return null;
    const e = ev_buf[ev_head];
    ev_head = (ev_head + 1) % ev_buf.len;
    return e;
}

pub var should_quit: bool = false;

// ============================================================================
// Status item — the first host verb (electrobun's createTray shape):
// an NSStatusBar item plus a runtime-registered KoruTrayTarget NSObject
// receiving target/action callbacks. Same mailbox discipline as the view
// IMPs: menuItemClicked:/statusItemClicked: push tray_action, and a pump
// drains it into the `! tray-action` arm. Where electrobun takes a JSON
// menu tree, items arrive one tor call at a time and match on native
// NSMenuItem.tag.
// ============================================================================

const MAX_TRAYS = 8;
var tray_class: ?objc.Class = null;
// target instance -> registration slot, consulted by the IMPs. Slots freed
// by tray.remove go null and are reused by the next tray.new.
var tray_targets: [MAX_TRAYS]Id = .{null} ** MAX_TRAYS;
var tray_count: usize = 0;

fn traySlotFor(recv: Id) ?usize {
    for (0..tray_count) |i| {
        if (tray_targets[i] == recv) return i;
    }
    return null;
}

// tag + representedObject off the clicked NSMenuItem — shared by every
// chrome click IMP. The action slice points into `tmp`; the ring push
// copies it before the IMP returns.
fn readTagAndAction(sender: Id, tmp: *[64]u8) struct { tag: i64, action: []const u8 } {
    var action: []const u8 = &.{};
    const robj = send(Id, sender, sel("representedObject"));
    if (robj != null and CFStringGetCString(robj, tmp, tmp.len, cf.kCFStringEncodingUTF8)) {
        action = tmp[0..std.mem.len(@as([*:0]u8, @ptrCast(tmp)))];
    }
    return .{ .tag = send(i64, sender, sel("tag")), .action = action };
}

fn impStatusItemClicked(recv: Id, _s: SEL, sender: Id) callconv(.c) void {
    _ = _s;
    _ = sender;
    const slot = traySlotFor(recv) orelse return;
    trayPushAction(@intCast(slot), -1, "");
}

fn impMenuItemClicked(recv: Id, _s: SEL, sender: Id) callconv(.c) void {
    _ = _s;
    const slot = traySlotFor(recv) orelse return;
    var tmp: [64]u8 = undefined;
    const e = readTagAndAction(sender, &tmp);
    trayPushAction(@intCast(slot), e.tag, e.action);
}

// Main-menu clicks land on a single shared target — unlike trays, a
// MenuActionData carries no source slot, so one instance serves every
// menu item in the process.
fn impMenuClicked(recv: Id, _s: SEL, sender: Id) callconv(.c) void {
    _ = recv;
    _ = _s;
    var tmp: [64]u8 = undefined;
    const e = readTagAndAction(sender, &tmp);
    menuPushAction(e.tag, e.action);
}

var menu_class: ?objc.Class = null;
var menu_target: ?Id = null;

fn ensureMenuTarget() ?Id {
    if (menu_target) |t| return t;
    const sup: objc.Class = @ptrCast(cls("NSObject"));
    const c = objc.objc_allocateClassPair(sup, "KoruMenuTarget", 0) orelse return null;
    _ = objc.class_addMethod(c, sel("menuItemClicked:"), @ptrCast(&impMenuClicked), "v@:@");
    objc.objc_registerClassPair(c);
    menu_class = c;
    const t = send(Id, send(Id, @as(Id, @ptrCast(c)), sel("alloc")), sel("init"));
    menu_target = t;
    return t;
}

fn ensureTrayClass() ?objc.Class {
    if (tray_class) |c| return c;
    const sup: objc.Class = @ptrCast(cls("NSObject"));
    const c = objc.objc_allocateClassPair(sup, "KoruTrayTarget", 0) orelse return null;
    _ = objc.class_addMethod(c, sel("statusItemClicked:"), @ptrCast(&impStatusItemClicked), "v@:@");
    _ = objc.class_addMethod(c, sel("menuItemClicked:"), @ptrCast(&impMenuItemClicked), "v@:@");
    objc.objc_registerClassPair(c);
    tray_class = c;
    return c;
}

// The status-item token. `sitem` is the NSStatusItem, `target` the
// KoruTrayTarget receiving its callbacks, `menu` lazily created by the
// first tray.item, `slot` the registration index TrayActionData reports.
// tray.new grants <ready>; tray.remove is the only consumer.
pub const Tray = struct {
    sitem: Id,
    target: Id,
    menu: ?Id,
    slot: usize,
};

// ============================================================================
// Tray lifecycle. `ready` — fresh from tray.new, items attachable,
// removable. tray.remove is the only <!ready> consumer.
// ============================================================================

~pub tor tray.new { title: string }
| tray *Tray<ready!>
| err string

~proc tray.new|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);

    const app = ensureApp();
    // A status item is agent UI — declare Accessory so a tray-only app
    // never claims the menu bar. Never downgrade: a window.open that
    // already ran made us Regular, and the bar is worth more than the
    // agent flag. window.open itself upgrades unconditionally.
    if (send(i64, app, sel("activationPolicy")) != 0) {
        setActivationPolicy(1);
    }

    const tc = ensureTrayClass() orelse {
        return .{ .err = "host: KoruTrayTarget class registration failed" };
    };
    var slot: usize = MAX_TRAYS;
    for (0..tray_count) |i| {
        if (tray_targets[i] == null) {
            slot = i;
            break;
        }
    }
    if (slot == MAX_TRAYS) {
        if (tray_count >= MAX_TRAYS) return .{ .err = "host: tray table full" };
        slot = tray_count;
        tray_count += 1;
    }
    const target = send(Id, send(Id, @as(Id, @ptrCast(tc)), sel("alloc")), sel("init"));

    const bar = send(Id, cls("NSStatusBar"), sel("systemStatusBar"));
    const item = send1(Id, f64, bar, sel("statusItemWithLength:"), -1.0); // NSVariableStatusItemLength
    if (item == null) return .{ .err = "host: statusItemWithLength failed" };
    // The bar does NOT retain the item — it is autoreleased, dies when this
    // proc's pool pops, and sitem dangles into whatever reuses the memory
    // (electrobun's retainObjCObject is the same discovery). tray.remove
    // sends the matching release after removeStatusItem:.
    _ = send(Id, item, sel("retain"));

    var tbuf: [256]u8 = undefined;
    const titleStr = cf.CFStringCreateWithCString(null, cstr(title, &tbuf), cf.kCFStringEncodingUTF8);
    const btn = send(Id, item, sel("button"));
    send1(void, Id, btn, sel("setTitle:"), @as(Id, @ptrCast(@constCast(titleStr))));
    send1(void, Id, btn, sel("setTarget:"), target);
    send1(void, SEL, btn, sel("setAction:"), sel("statusItemClicked:"));
    // LeftMouseUp|RightMouseUp — fires statusItemClicked: only while no
    // menu is attached; an attached menu owns the click itself.
    send1(void, u64, btn, sel("sendActionOn:"), 10);

    tray_targets[slot] = target;
    const t = std.heap.page_allocator.create(Tray) catch @panic("host: OOM allocating Tray token");
    t.* = .{ .sitem = item, .target = target, .menu = null, .slot = slot };
    return .{ .tray = t };
}

// The status item's menu is created lazily so a click-only tray never pays
// for one — and so tray.new's button-click path stays live until the first
// item lands (an attached menu owns the click; AppKit's contract).
fn ensureMenu(tray: *Tray) void {
    if (tray.menu != null) return;
    tray.menu = send(Id, send(Id, cls("NSMenu"), sel("alloc")), sel("init"));
    send1(void, Id, tray.sitem, sel("setMenu:"), tray.menu.?);
}

// One menu entry: label shown, `action` carried as representedObject into
// TrayActionData, `tag` the native NSMenuItem tag for integer matching.
~pub tor tray.item { tray: *Tray<ready>, label: string, action: string, tag: i64 }

~proc tray.item|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    ensureMenu(tray);
    var lbuf: [256]u8 = undefined;
    var abuf: [64]u8 = undefined;
    var ebuf: [1]u8 = .{0};
    const labelStr = cf.CFStringCreateWithCString(null, cstr(label, &lbuf), cf.kCFStringEncodingUTF8);
    const actStr = cf.CFStringCreateWithCString(null, cstr(action, &abuf), cf.kCFStringEncodingUTF8);
    const emptyStr = cf.CFStringCreateWithCString(null, @as([*:0]const u8, @ptrCast(&ebuf)), cf.kCFStringEncodingUTF8);
    const mi = send3(
        Id, Id, SEL, Id,
        send(Id, cls("NSMenuItem"), sel("alloc")),
        sel("initWithTitle:action:keyEquivalent:"),
        @as(Id, @ptrCast(@constCast(labelStr))), sel("menuItemClicked:"), @as(Id, @ptrCast(@constCast(emptyStr))),
    );
    send1(void, Id, mi, sel("setTarget:"), tray.target);
    send1(void, Id, mi, sel("setRepresentedObject:"), @as(Id, @ptrCast(@constCast(actStr))));
    send1(void, i64, mi, sel("setTag:"), tag);
    send1(void, Id, tray.menu.?, sel("addItem:"), mi);
    send(void, mi, sel("release"));
}

~pub tor tray.sep { tray: *Tray<ready> }

~proc tray.sep|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    ensureMenu(tray);
    const sep = send(Id, cls("NSMenuItem"), sel("separatorItem"));
    send1(void, Id, tray.menu.?, sel("addItem:"), sep);
}

~pub tor tray.title { tray: *Tray<ready>, title: string }

~proc tray.title|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    var tbuf: [256]u8 = undefined;
    const titleStr = cf.CFStringCreateWithCString(null, cstr(title, &tbuf), cf.kCFStringEncodingUTF8);
    send1(void, Id, send(Id, tray.sitem, sel("button")), sel("setTitle:"), @as(Id, @ptrCast(@constCast(titleStr))));
}

~pub tor tray.remove { tray: *Tray<!ready> }

~proc tray.remove|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    const bar = send(Id, cls("NSStatusBar"), sel("systemStatusBar"));
    send1(void, Id, bar, sel("removeStatusItem:"), tray.sitem);
    // Balances the retain in tray.new; the target was ours (alloc/init).
    send(void, tray.sitem, sel("release"));
    send(void, tray.target, sel("release"));
    tray_targets[tray.slot] = null;
    std.heap.page_allocator.destroy(tray);
}

// ============================================================================
// Automation: a synthesized tray action enters the SAME mailbox the IMPs
// write — verifies ring -> arm dispatch without AX trust.
// ============================================================================

~pub tor tray.action { tray: i64, tag: i64, action: string }

~proc tray.action|zig {
    trayPushAction(tray, tag, action);
}

// ============================================================================
// Main menu — the second host verb. macOS shape: NSApp.mainMenu holds one
// NSMenuItem per bar heading ("App", "File", "Edit"), each carrying a
// submenu NSMenu of real items. Same target/action/tag/representedObject
// mechanics as the tray — one shared KoruMenuTarget, one chrome ring.
// menu.new grants <ready>; menu.remove is the only consumer. Bars are
// plain <ready> borrows — remove frees them with the menu.
// ============================================================================

pub const Menu = struct {
    m: Id,
};

pub const MenuBar = struct {
    sub: Id,
};

const MAX_BARS = 32;
var menu_bars: [MAX_BARS]*MenuBar = undefined;
var menu_bar_count: usize = 0;

// A main menu implies a regular app — activateRegular upgrades the
// policy and replaces the empty scaffolding menu with ours.
~pub tor menu.new {}
| menu *Menu<ready!>
| err string

~proc menu.new|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    const app = activateRegular();
    _ = ensureMenuTarget() orelse {
        return .{ .err = "host: KoruMenuTarget class registration failed" };
    };
    const m = send(Id, send(Id, cls("NSMenu"), sel("alloc")), sel("init"));
    send1(void, Id, app, sel("setMainMenu:"), m);
    const t = std.heap.page_allocator.create(Menu) catch @panic("host: OOM allocating Menu token");
    t.* = .{ .m = m };
    return .{ .menu = t };
}

// One bar heading — its title shows in the menu bar; items attach to
// the submenu it owns.
~pub tor menu.bar { menu: *Menu<ready>, title: string }
| bar *MenuBar<ready>
| err string

~proc menu.bar|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    if (menu_bar_count >= MAX_BARS) {
        return .{ .err = "host: bar table full" };
    }
    var tbuf: [256]u8 = undefined;
    const titleStr = cf.CFStringCreateWithCString(null, cstr(title, &tbuf), cf.kCFStringEncodingUTF8);
    const sub = send(Id, send(Id, cls("NSMenu"), sel("alloc")), sel("init"));
    send1(void, Id, sub, sel("setTitle:"), @as(Id, @ptrCast(@constCast(titleStr))));
    const heading = send(Id, send(Id, cls("NSMenuItem"), sel("alloc")), sel("init"));
    send1(void, Id, heading, sel("setTitle:"), @as(Id, @ptrCast(@constCast(titleStr))));
    send1(void, Id, heading, sel("setSubmenu:"), sub);
    send1(void, Id, menu.m, sel("addItem:"), heading);
    send(void, heading, sel("release"));
    send(void, sub, sel("release"));
    const b = std.heap.page_allocator.create(MenuBar) catch @panic("host: OOM allocating MenuBar token");
    b.* = .{ .sub = sub };
    menu_bars[menu_bar_count] = b;
    menu_bar_count += 1;
    return .{ .bar = b };
}

// One menu entry — `key` is the keyEquivalent: "q" yields Cmd-Q for
// free (Command is the default modifier mask); absent means click-only.
// `action` rides into MenuActionData as representedObject; `tag` is the
// integer matcher.
~pub tor menu.item { bar: *MenuBar<ready>, label: string, key: ?string, action: string, tag: i64 }

~proc menu.item|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    var lbuf: [256]u8 = undefined;
    var abuf: [64]u8 = undefined;
    var kbuf: [16]u8 = undefined;
    const labelStr = cf.CFStringCreateWithCString(null, cstr(label, &lbuf), cf.kCFStringEncodingUTF8);
    const actStr = cf.CFStringCreateWithCString(null, cstr(action, &abuf), cf.kCFStringEncodingUTF8);
    const keyStr = cf.CFStringCreateWithCString(null, cstr(key orelse "", &kbuf), cf.kCFStringEncodingUTF8);
    const mi = send3(
        Id, Id, SEL, Id,
        send(Id, cls("NSMenuItem"), sel("alloc")),
        sel("initWithTitle:action:keyEquivalent:"),
        @as(Id, @ptrCast(@constCast(labelStr))), sel("menuItemClicked:"), @as(Id, @ptrCast(@constCast(keyStr))),
    );
    send1(void, Id, mi, sel("setTarget:"), menu_target.?);
    send1(void, Id, mi, sel("setRepresentedObject:"), @as(Id, @ptrCast(@constCast(actStr))));
    send1(void, i64, mi, sel("setTag:"), tag);
    send1(void, Id, bar.sub, sel("addItem:"), mi);
    send(void, mi, sel("release"));
}

~pub tor menu.sep { bar: *MenuBar<ready> }

~proc menu.sep|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    const sep = send(Id, cls("NSMenuItem"), sel("separatorItem"));
    send1(void, Id, bar.sub, sel("addItem:"), sep);
}

~pub tor menu.remove { menu: *Menu<!ready> }

~proc menu.remove|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    send1(void, Id, ensureApp(), sel("setMainMenu:"), @as(Id, null));
    // The menu retains its headings, they retain their submenus — one
    // release takes the whole tree.
    send(void, menu.m, sel("release"));
    for (0..menu_bar_count) |i| {
        std.heap.page_allocator.destroy(menu_bars[i]);
    }
    menu_bar_count = 0;
    std.heap.page_allocator.destroy(menu);
}

// Automation: a synthesized menu action enters the SAME ring the IMP
// writes — verifies ring -> arm dispatch without AX trust.
~pub tor menu.action { tag: i64, action: string }

~proc menu.action|zig {
    menuPushAction(tag, action);
}

// ============================================================================
// Dialogs — the first synchronous verbs, and the reason host.run IS
// -[NSApp run]. Probed: every non-run() path for runModal silently
// aborts (session creates, its loop returns -1002, the window reports
// isVisible but never composites — activation for unbundled binaries is
// denied on macOS 14+). Once the app is genuinely running — which
// host.run guarantees for anything called from an arm — runModal works
// natively: real modality, centered panel, keyboard equivalents. The
// answer arrives as a BRANCH: `dialog.confirm` -> | ok | | cancel |.
// ============================================================================

// A dialog is UI — a Prohibited app cannot show one. Upgrade to
// Accessory when needed (agent UI may display windows); never downgrade
// a windowed app's Regular.
fn ensurePresentable() void {
    const app = ensureApp();
    if (send(i64, app, sel("activationPolicy")) == 2) {
        setActivationPolicy(1);
    }
}

// addButtonWithTitle: order is the response code — first added is
// NSAlertFirstButtonReturn (1000), second is 1001.
fn alertDialog(title: []const u8, message: []const u8, btn1: []const u8, btn2: ?[]const u8) i64 {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    ensurePresentable();
    var tbuf: [256]u8 = undefined;
    var mbuf: [1024]u8 = undefined;
    var b1: [64]u8 = undefined;
    var b2: [64]u8 = undefined;
    const titleStr = cf.CFStringCreateWithCString(null, cstr(title, &tbuf), cf.kCFStringEncodingUTF8);
    const msgStr = cf.CFStringCreateWithCString(null, cstr(message, &mbuf), cf.kCFStringEncodingUTF8);
    const alert = send(Id, send(Id, cls("NSAlert"), sel("alloc")), sel("init"));
    send1(void, Id, alert, sel("setMessageText:"), @as(Id, @ptrCast(@constCast(titleStr))));
    send1(void, Id, alert, sel("setInformativeText:"), @as(Id, @ptrCast(@constCast(msgStr))));
    send1(void, Id, alert, sel("addButtonWithTitle:"), @as(Id, @ptrCast(@constCast(cf.CFStringCreateWithCString(null, cstr(btn1, &b1), cf.kCFStringEncodingUTF8)))));
    if (btn2) |b| {
        send1(void, Id, alert, sel("addButtonWithTitle:"), @as(Id, @ptrCast(@constCast(cf.CFStringCreateWithCString(null, cstr(b, &b2), cf.kCFStringEncodingUTF8)))));
    }
    const r = send(i64, alert, sel("runModal"));
    send(void, alert, sel("release"));
    return r;
}

// One-button alert — no branch, the dismissal IS the answer.
~pub tor dialog.alert { title: string, message: string }

~proc dialog.alert|zig {
    _ = alertDialog(title, message, "OK", null);
}

~pub tor dialog.confirm { title: string, message: string }
| ok
| cancel

~proc dialog.confirm|zig {
    if (alertDialog(title, message, "OK", "Cancel") == 1000) {
        return .{ .ok = .{} };
    }
    return .{ .cancel = .{} };
}

// NSOpenPanel — same modal shape, returns a path. NSModalResponseOK is
// 1; everything else (Cancel, Esc, closed) maps to the cancel branch.
// The path string is heap-duped out of the panel's NSString — it owns
// no obligation because a path is just data, not a native handle.
~pub tor dialog.open { title: string }
| path string
| cancel

~proc dialog.open|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    ensurePresentable();
    var tbuf: [256]u8 = undefined;
    const titleStr = cf.CFStringCreateWithCString(null, cstr(title, &tbuf), cf.kCFStringEncodingUTF8);
    const panel = send(Id, cls("NSOpenPanel"), sel("openPanel"));
    send1(void, Id, panel, sel("setTitle:"), @as(Id, @ptrCast(@constCast(titleStr))));
    send1(void, bool, panel, sel("setCanChooseFiles:"), true);
    send1(void, bool, panel, sel("setCanChooseDirectories:"), false);
    if (send(i64, panel, sel("runModal")) != 1) {
        return .{ .cancel = .{} };
    }
    const url = send(Id, send(Id, panel, sel("URL")), sel("path"));
    var pbuf: [2048]u8 = undefined;
    if (!CFStringGetCString(url, &pbuf, pbuf.len, cf.kCFStringEncodingUTF8)) {
        return .{ .cancel = .{} };
    }
    const n = std.mem.len(@as([*:0]u8, @ptrCast(&pbuf)));
    const s = std.heap.page_allocator.dupe(u8, pbuf[0..n]) catch @panic("host: OOM in dialog.open path");
    return .{ .path = s };
}

// ============================================================================
// notify — UNUserNotificationCenter. This verb only exists because the
// bundle does: +currentNotificationCenter throws bundleProxyForCurrentProcess
// is nil on unbundled binaries even with the embedded __TEXT,__info_plist —
// the XPC bundle proxy needs the real .app directory, which `koru bundle`
// makes. Two pieces: a lazy center that requests authorization
// on first use (alert|sound|badge = 7, nil completion — the system
// prompt is the receipt), and a KoruNotifyDelegate whose willPresent
// IMP answers banner+list+sound so a notification fired while the app
// is frontmost still shows. Without that delegate macOS suppresses
// notification UI from the active app entirely.
// ============================================================================

var notify_center: ?Id = null;

// userNotificationCenter:willPresentNotification:withCompletionHandler:
// — the completion arg is a block literal; its invoke pointer lives at
// offset 16 (isa, flags, reserved). We call it with presentation
// options badge(1)|sound(2)|list(8)|banner(16) = 27.
fn impWillPresent(recv: Id, _s: SEL, center: Id, notif: Id, completion: ?*anyopaque) callconv(.c) void {
    _ = recv;
    _ = _s;
    _ = center;
    _ = notif;
    const Block = extern struct {
        isa: ?*anyopaque,
        flags: c_int,
        reserved: c_int,
        invoke: ?*const anyopaque,
    };
    const blk: *const Block = @ptrCast(@alignCast(completion));
    if (blk.invoke) |iv| {
        const f: *const fn (?*anyopaque, u64) callconv(.c) void = @ptrCast(@alignCast(iv));
        f(completion, 27);
    }
}

var notify_delegate_class: ?objc.Class = null;

fn ensureNotifyDelegate() ?Id {
    if (notify_delegate_class == null) {
        const sup: objc.Class = @ptrCast(cls("NSObject"));
        const c = objc.objc_allocateClassPair(sup, "KoruNotifyDelegate", 0) orelse return null;
        _ = objc.class_addMethod(
            c,
            sel("userNotificationCenter:willPresentNotification:withCompletionHandler:"),
            @ptrCast(&impWillPresent),
            "v@:@@@?",
        );
        objc.objc_registerClassPair(c);
        notify_delegate_class = c;
    }
    return send(Id, send(Id, @as(Id, @ptrCast(notify_delegate_class.?)), sel("alloc")), sel("init"));
}

fn ensureNotifyCenter() ?Id {
    if (notify_center) |c| return c;
    const c = send(Id, cls("UNUserNotificationCenter"), sel("currentNotificationCenter"));
    if (c == null) return null;
    // alert(4)|sound(2)|badge(1) — nil completion is legal and fire-and-forget:
    // the permission prompt itself is the receipt. A request added while the
    // prompt is still up may be dropped; the second send delivers.
    send2(void, u64, ?*anyopaque, c, sel("requestAuthorizationWithOptions:completionHandler:"), 7, null);
    if (ensureNotifyDelegate()) |d| {
        send1(void, Id, c, sel("setDelegate:"), d);
    }
    notify_center = c;
    return c;
}

var notify_seq: u64 = 0;

~pub tor notify.send { title: string, body: string }
| ok
| err string

~proc notify.send|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    // The center hard-throws on unbundled binaries (bundleProxyForCurrentProcess
    // is nil) — embedded __TEXT,__info_plist is not enough here. Detect the
    // bundle by its .app path extension and refuse instead of crashing.
    const b = send(Id, cls("NSBundle"), sel("mainBundle"));
    const ext = send(Id, send(Id, b, sel("bundleURL")), sel("pathExtension"));
    const extc = send([*:0]const u8, ext, sel("UTF8String"));
    if (!std.mem.eql(u8, std.mem.span(extc), "app")) {
        return .{ .err = "host: notify needs `koru bundle` — the notification center throws on unbundled binaries" };
    }
    const c = ensureNotifyCenter() orelse return .{ .err = "host: no UNUserNotificationCenter" };
    var tbuf: [256]u8 = undefined;
    var bbuf: [1024]u8 = undefined;
    var ibuf: [64]u8 = undefined;
    const content = send(Id, send(Id, cls("UNMutableNotificationContent"), sel("alloc")), sel("init"));
    send1(void, Id, content, sel("setTitle:"), @as(Id, @ptrCast(@constCast(cf.CFStringCreateWithCString(null, cstr(title, &tbuf), cf.kCFStringEncodingUTF8)))));
    send1(void, Id, content, sel("setBody:"), @as(Id, @ptrCast(@constCast(cf.CFStringCreateWithCString(null, cstr(body, &bbuf), cf.kCFStringEncodingUTF8)))));
    send1(void, Id, content, sel("setSound:"), send(Id, cls("UNNotificationSound"), sel("defaultSound")));
    notify_seq += 1;
    const n = std.fmt.bufPrint(&ibuf, "koru-notify-{d}", .{notify_seq}) catch return .{ .err = "host: notify id overflow" };
    var zbuf: [64]u8 = undefined;
    @memcpy(zbuf[0..n.len], n);
    zbuf[n.len] = 0;
    const req = send3(
        Id, Id, Id, Id,
        cls("UNNotificationRequest"),
        sel("requestWithIdentifier:content:trigger:"),
        @as(Id, @ptrCast(@constCast(cf.CFStringCreateWithCString(null, @as([*:0]const u8, @ptrCast(&zbuf)), cf.kCFStringEncodingUTF8)))),
        content,
        @as(Id, null),
    );
    if (req == null) return .{ .err = "host: notification request failed" };
    send2(void, Id, ?*anyopaque, c, sel("addNotificationRequest:withCompletionHandler:"), req, null);
    return .{ .ok = .{} };
}

// ============================================================================
// host.run — the windowless pump, now riding AppKit's own loop. This was
// a manual nextEventMatchingMask pump until dialogs forced the truth:
// modal machinery, prompt compositing, and activation all gate on
// -[NSApp run] having installed the app as running — no KVC flag or
// manual drain reproduces it. So run() owns the thread, and a repeating
// NSTimer on the main run loop drains the chrome ring into the stashed
// arm closures. quit()/count stop the loop via stop: plus a wake —
// stop: alone won't break a run() blocked waiting for an event.
// ============================================================================

pub extern fn CFRunLoopGetMain() callconv(.c) Id;
pub extern fn CFRunLoopWakeUp(rl: Id) callconv(.c) void;

const HostArms = struct {
    tray: *const fn (TrayActionData) void,
    menu: *const fn (MenuActionData) void,
    hotkey: *const fn (HotkeyData) void,
};

var host_arms: ?HostArms = null;
var host_ticks: i32 = 0;
var host_cap: i32 = 0;
var host_app: Id = null;

fn impHostTick(recv: Id, _s: SEL, timer: Id) callconv(.c) void {
    _ = recv;
    _ = _s;
    while (popEvent()) |hev| {
        if (host_arms) |arms| {
            switch (hev) {
                .tray => |td| arms.tray(td),
                .menu => |md| arms.menu(md),
                .hotkey => |hk| arms.hotkey(hk),
            }
        }
    }
    host_ticks += 1;
    if (should_quit or host_ticks >= host_cap) {
        send(void, timer, sel("invalidate"));
        if (host_app) |app| {
            send1(void, Id, app, sel("stop:"), @as(Id, null));
            // stop: only takes effect when the run loop iterates — and a
            // run() blocked in nextEventMatchingMask waits on a mach port,
            // not the CFRunLoop, so CFRunLoopWakeUp can't reach it. A
            // posted ApplicationDefined event is the wake that lands.
            postWakeEvent(app);
        }
    }
}

const NSPoint = extern struct { x: f64, y: f64 };

fn postWakeEvent(app: Id) void {
    const makeEvent = @as(
        *const fn (Id, SEL, i64, NSPoint, u64, f64, i64, Id, i64, i64, i64) callconv(.c) Id,
        @ptrCast(&objc.objc_msgSend),
    );
    const ev = makeEvent(
        cls("NSEvent"),
        sel("otherEventWithType:location:modifierFlags:timestamp:windowNumber:context:subtype:data1:data2:"),
        15, // NSApplicationDefined
        .{ .x = 0, .y = 0 }, 0, 0.0, 0, null, 0, 0, 0,
    );
    send2(void, Id, bool, app, sel("postEvent:atStart:"), ev, true);
}

var host_tick_target: ?Id = null;

fn ensureHostTickTarget() ?Id {
    if (host_tick_target) |t| return t;
    const sup: objc.Class = @ptrCast(cls("NSObject"));
    const c = objc.objc_allocateClassPair(sup, "KoruHostTick", 0) orelse return null;
    _ = objc.class_addMethod(c, sel("hostTick:"), @ptrCast(&impHostTick), "v@:@");
    objc.objc_registerClassPair(c);
    const t = send(Id, send(Id, @as(Id, @ptrCast(c)), sel("alloc")), sel("init"));
    host_tick_target = t;
    return t;
}

~pub tor host.run { count: ?i32 }
! ?tray-action libs/host:TrayActionData
! ?menu-action libs/host:MenuActionData
! ?hotkey libs/host:HotkeyData
| done

~proc host.run|zig {
    const __cap = @as(?i32, count) orelse 2147483647;
    const app = $mod.ensureApp();
    $mod.host_arms = .{ .tray = tray_action, .menu = menu_action, .hotkey = hotkey };
    $mod.host_app = app;
    $mod.host_ticks = 0;
    $mod.host_cap = __cap;
    const t = $mod.ensureHostTickTarget() orelse return .{ .done = .{} };
    const timer = $mod.send5(
        $mod.Id, f64, $mod.Id, $mod.SEL, $mod.Id, bool,
        $mod.cls("NSTimer"),
        $mod.sel("timerWithTimeInterval:target:selector:userInfo:repeats:"),
        0.004, t, $mod.sel("hostTick:"), @as($mod.Id, null), true,
    );
    const rl = $mod.send($mod.Id, $mod.cls("NSRunLoop"), $mod.sel("mainRunLoop"));
    $mod.send2(void, $mod.Id, $mod.Id, rl, $mod.sel("addTimer:forMode:"), timer, $mod.NSDefaultRunLoopMode);
    $mod.send(void, app, $mod.sel("run"));
    return .{ .done = .{} };
}

// Request the pump to exit at the next iteration — same shape as
// vaxis:quit. Sets a module flag; frames and host.run check it after
// mailbox dispatch.
~pub tor quit {}

~proc quit|zig {
    should_quit = true;
}

// ============================================================================
// Global hotkeys — Carbon RegisterEventHotKey, the one global-key API that
// needs NO Accessibility / Input-Monitoring grant (6digit-voice's
// hotkey-watch.swift precedent). The handler is a plain C function pointer
// like every IMP here: it pushes into the host ring; both pumps drain it —
// press AND release land, so hold-to-talk is the shape this exists for.
// Modifier-only keys (fn/globe) are NOT expressible as Carbon hotkeys —
// they want an NSEvent flagsChanged or IOHID path, a different verb.
// ============================================================================

const EventTypeSpec = extern struct { eventClass: u32, eventKind: u32 };
const EventHotKeyID = extern struct { signature: u32, id: u32 };
const EventHotKeyRef = Id;

extern fn RegisterEventHotKey(code: u32, mods: u32, hkid: EventHotKeyID, target: Id, options: u32, ref: ?*EventHotKeyRef) i32;
extern fn UnregisterEventHotKey(ref: EventHotKeyRef) i32;
extern fn InstallEventHandler(target: Id, handler: *const anyopaque, num_types: usize, specs: [*]const EventTypeSpec, user_data: ?*anyopaque, ref: ?*anyopaque) i32;
extern fn GetApplicationEventTarget() Id;
extern fn GetEventKind(ev: Id) u32;
extern fn GetEventParameter(ev: Id, name: u32, dtype: u32, actual: ?*u32, size: usize, actual_size: ?*usize, data: ?*anyopaque) i32;

// kEventClassKeyboard / kEventHotKey{Pressed,Released} / kEventParamDirectObject /
// typeEventHotKeyID / our registration signature — as FourCharCodes.
const K_CLASS_KBD: u32 = 0x6B657962;
const K_HOTKEY_DOWN: u32 = 5;
const K_PARAM_DIRECT: u32 = 0x2D2D2D2D;
const K_TYPE_HOTKEY_ID: u32 = 0x686B6964;
const K_SIG: u32 = 0x4B4F5255; // 'KORU'

const MAX_HOTKEYS = 8;
var hotkey_refs: [MAX_HOTKEYS]EventHotKeyRef = .{null} ** MAX_HOTKEYS;
var hotkey_keys: [MAX_HOTKEYS]i64 = .{0} ** MAX_HOTKEYS;
var hotkey_mods: [MAX_HOTKEYS]i64 = .{0} ** MAX_HOTKEYS;
var hotkey_count: usize = 0;
var hotkey_handler_installed = false;

fn hotkeyHandler(_: Id, ev: Id, _: ?*anyopaque) callconv(.c) i32 {
    var hkid: EventHotKeyID = std.mem.zeroes(EventHotKeyID);
    _ = GetEventParameter(ev, K_PARAM_DIRECT, K_TYPE_HOTKEY_ID, null, @sizeOf(EventHotKeyID), null, &hkid);
    if (hkid.id == 0 or hkid.id > hotkey_count) return 0;
    const slot: usize = @intCast(hkid.id - 1);
    pushHotkey(.{
        .key = hotkey_keys[slot],
        .mods = hotkey_mods[slot],
        .down = if (GetEventKind(ev) == K_HOTKEY_DOWN) 1 else 0,
    });
    return 0;
}

fn ensureHotkeyHandler() bool {
    if (hotkey_handler_installed) return true;
    const specs = [_]EventTypeSpec{
        .{ .eventClass = K_CLASS_KBD, .eventKind = K_HOTKEY_DOWN },
        .{ .eventClass = K_CLASS_KBD, .eventKind = 6 }, // kEventHotKeyReleased
    };
    if (InstallEventHandler(GetApplicationEventTarget(), @ptrCast(&hotkeyHandler), specs.len, &specs, null, null) != 0) return false;
    hotkey_handler_installed = true;
    return true;
}

pub const Hotkey = struct { slot: usize };

// Watch one global hotkey — key is a mac virtual keycode, mods a Carbon
// mask (cmd 256 | shift 512 | option 2048 | control 4096). Events land on
// the `! hotkey` arm of whichever pump is running.
~pub tor hotkey.watch { key: i64, mods: i64 }
| watching *Hotkey<watching!>
| err string

~proc hotkey.watch|zig {
    if (!ensureHotkeyHandler()) return .{ .err = "host: InstallEventHandler failed" };
    if (hotkey_count >= MAX_HOTKEYS) return .{ .err = "host: hotkey table full" };
    const slot = hotkey_count;
    var ref: EventHotKeyRef = null;
    const st = RegisterEventHotKey(
        @intCast(key), @intCast(mods),
        .{ .signature = K_SIG, .id = @intCast(slot + 1) },
        GetApplicationEventTarget(), 0, &ref,
    );
    if (st != 0 or ref == null) return .{ .err = "host: RegisterEventHotKey failed" };
    hotkey_refs[slot] = ref;
    hotkey_keys[slot] = key;
    hotkey_mods[slot] = mods;
    hotkey_count += 1;
    const hk = std.heap.page_allocator.create(Hotkey) catch @panic("host: OOM");
    hk.* = .{ .slot = slot };
    return .{ .watching = hk };
}

// Stop watching — discharges the token.
~pub tor hotkey.unwatch { hk: *Hotkey<!watching> }
~proc hotkey.unwatch|zig {
    if (hotkey_refs[hk.slot]) |r| _ = UnregisterEventHotKey(r);
    hotkey_refs[hk.slot] = null;
    std.heap.page_allocator.destroy(hk);
}

// Push a synthetic hotkey event — same shape as tray.action: exercises
// ring -> arm dispatch without a human press. Only a keyboard can prove
// the Carbon half; the status code in watch is its receipt.
~pub tor hotkey.action { key: i64, mods: i64, down: i64 }
~proc hotkey.action|zig {
    pushHotkey(.{ .key = key, .mods = mods, .down = down });
}

// ============================================================================
// Mic capture — VoiceProcessingIO AudioUnit (built-in AEC/voice isolation),
// plain C render callback, no blocks, no Swift. The unit negotiates 16kHz
// float32 mono on the input element's output edge — whistle's exact sample
// contract — and fails loudly at start if the device refuses it (never a
// silently-wrong-rate stream). Captured samples ride one ring the caller
// drains via mic.read; mic.level is the RMS of the recent tail, which is
// the honest source for a live waveform — the surface draws real energy,
// never a synthesized wave.
// ============================================================================

const ACD = extern struct { ctype: u32, subtype: u32, mfr: u32, flags: u32, flags_mask: u32 };
const ASBD = extern struct {
    rate: f64, fmt: u32, flags: u32, bpp: u32, fpp: u32,
    bpf: u32, chans: u32, bits: u32, reserved: u32,
};
const AudioBuf = extern struct { chans: u32, bytes: u32, data: ?*anyopaque };
const AudioBufList = extern struct { count: u32, bufs: [1]AudioBuf };
const RenderCB = extern struct { proc: *const anyopaque, refcon: ?*anyopaque };

extern fn AudioComponentFindNext(comp: Id, desc: *const ACD) Id;
extern fn AudioComponentInstanceNew(comp: Id, out: *Id) i32;
extern fn AudioUnitSetProperty(u: Id, prop: u32, scope: u32, elem: u32, data: ?*const anyopaque, size: u32) i32;
extern fn AudioUnitGetProperty(u: Id, prop: u32, scope: u32, elem: u32, data: ?*anyopaque, size: *u32) i32;
extern fn AudioUnitInitialize(u: Id) i32;
extern fn AudioUnitUninitialize(u: Id) i32;
extern fn AudioOutputUnitStart(u: Id) i32;
extern fn AudioOutputUnitStop(u: Id) i32;
extern fn AudioComponentInstanceDispose(u: Id) i32;
extern fn AudioUnitRender(u: Id, flags: *u32, ts: ?*const anyopaque, bus: u32, frames: u32, data: ?*AudioBufList) i32;

const MIC_RING_CAP: usize = 16000 * 30; // 30s of f32 mono
var mic_ring: [MIC_RING_CAP]f32 = undefined;
var mic_head: usize = 0; // read pos
var mic_tail: usize = 0; // write pos
var mic_rate: f64 = 0;

fn micRingWrite(src: [*]const f32, n: usize) void {
    for (0..n) |i| {
        const next = (mic_tail + 1) % MIC_RING_CAP;
        if (next == mic_head) return; // full: drop oldest-position semantics = drop new
        mic_ring[mic_tail] = src[i];
        mic_tail = next;
    }
}

var mic_unit: Id = null;
var mic_pull_buf: [4096 * 4]u8 = undefined;

// Pull-model capture: SetInputCallback is notification-only — nothing
// renders means nothing pulls input through. The render callback sits on
// the output element, calls AudioUnitRender on bus 1 to pull the captured
// samples into the ring, and writes silence to the speakers (the output
// half runs only to keep the VPIO pair alive).
fn micRenderCb(_: ?*anyopaque, flags: *u32, ts: ?*const anyopaque, _: u32, frames: u32, data: ?*AudioBufList) callconv(.c) i32 {
    var list = AudioBufList{ .count = 1, .bufs = .{.{ .chans = 1, .bytes = @min(frames * 4, mic_pull_buf.len), .data = @ptrCast(&mic_pull_buf) }} };
    _ = AudioUnitRender(mic_unit, flags, ts, 1, frames, &list);
    const p: [*]const f32 = @ptrCast(@alignCast(@as(?*anyopaque, @ptrCast(&mic_pull_buf))));
    micRingWrite(p, @min(@as(usize, frames), list.bufs[0].bytes / 4));
    if (data) |d| {
        // AudioBufferList declares mBuffers[1] but carries `count` — walk it
        // as a many-item pointer and silence every buffer.
        const bs: [*]AudioBuf = @ptrCast(&d.bufs);
        for (0..d.count) |bi| {
            const b = bs[bi];
            if (b.data) |ptr| @memset(@as([*]u8, @ptrCast(ptr))[0..b.bytes], 0);
        }
    }
    return 0;
}

pub const Mic = struct { unit: Id };

// Start capture on the default input — mints the live token.
// | err = OSStatus*100 + step (OSStatus is already negative; the last two
// digits name the failing call) — 2=InstanceNew, 3=EnableIO-in, 4/5=
// StreamFormat set (capture/render edge), 6=StreamFormat get, 7=
// SetInputCallback, 8=Initialize, 9=Start; -1 no comp, -2 fmt mismatch.
~pub tor mic.start {}
| live *Mic<live!>
| err i32

~proc mic.start|zig {
    var desc = ACD{ .ctype = 0x61756F75, .subtype = 0x7670696F, .mfr = 0x6170706C, .flags = 0, .flags_mask = 0 };
    const comp = AudioComponentFindNext(null, &desc);
    if (comp == null) return .{ .err = -1 };
    var unit: Id = null;
    var st = AudioComponentInstanceNew(comp, &unit);
    if (st != 0) return .{ .err = st * 100 + 2 };
    var one: u32 = 1;
    st = AudioUnitSetProperty(unit, 2003, 1, 1, &one, 4); // EnableIO on input elem
    if (st != 0) return .{ .err = st * 100 + 3 };
    // VPIO is a paired unit: the output element stays ENABLED (its AEC
    // subtracts what the Mac plays; Initialize rejects a half-open pair
    // with InvalidElement, -10875) and BOTH edges carry a stream format —
    // output-of-input-bus (scope 2 elem 1, delivered capture) and
    // input-of-output-bus (scope 1 elem 0, the render edge, silent here).
    var want = ASBD{ .rate = 16000, .fmt = 0x6C70636D, .flags = 5, .bpp = 4, .fpp = 1, .bpf = 4, .chans = 1, .bits = 32, .reserved = 0 };
    st = AudioUnitSetProperty(unit, 8, 2, 1, &want, @sizeOf(ASBD));
    if (st != 0) return .{ .err = st * 100 + 4 };
    st = AudioUnitSetProperty(unit, 8, 1, 0, &want, @sizeOf(ASBD));
    if (st != 0) return .{ .err = st * 100 + 5 };
    var got = std.mem.zeroes(ASBD);
    var got_sz: u32 = @sizeOf(ASBD);
    st = AudioUnitGetProperty(unit, 8, 2, 1, &got, &got_sz);
    if (st != 0) return .{ .err = st * 100 + 6 };
    if (got.rate != 16000 or got.fmt != 0x6C70636D or (got.flags & 1) == 0) return .{ .err = -2 };
    mic_rate = got.rate;
    var cb = RenderCB{ .proc = @ptrCast(&micRenderCb), .refcon = null };
    st = AudioUnitSetProperty(unit, 23, 0, 0, &cb, @sizeOf(RenderCB)); // SetRenderCallback
    if (st != 0) return .{ .err = st * 100 + 7 };
    st = AudioUnitInitialize(unit);
    if (st != 0) return .{ .err = st * 100 + 8 };
    st = AudioOutputUnitStart(unit);
    if (st != 0) return .{ .err = st * 100 + 9 };
    mic_unit = unit;
    const m = std.heap.page_allocator.create(Mic) catch @panic("host: OOM");
    m.* = .{ .unit = unit };
    return .{ .live = m };
}

// Stop and dispose — discharges the token.
~pub tor mic.stop { mic: *Mic<!live> }
~proc mic.stop|zig {
    _ = AudioOutputUnitStop(mic.unit);
    _ = AudioUnitUninitialize(mic.unit);
    _ = AudioComponentInstanceDispose(mic.unit);
    std.heap.page_allocator.destroy(mic);
}

// RMS energy of the most recent ring samples — the live-waveform feed.
~pub tor mic.level { mic: *Mic<live>, window: i64 } -> f64

~proc mic.level|zig {
    _ = mic;
    var n: usize = @intCast(@max(0, @min(window, 16000)));
    var acc: f64 = 0;
    var count: f64 = 0;
    var i = mic_tail;
    while (n > 0) : (n -= 1) {
        i = (i + MIC_RING_CAP - 1) % MIC_RING_CAP;
        if (i == mic_head) break;
        const s = mic_ring[i];
        acc += s * s;
        count += 1;
    }
    return if (count > 0) @sqrt(acc / count) else 0.0;
}

// Drain up to `max` ring samples as little-endian f32 bytes — feeds
// needle stream.process directly.
~pub tor mic.read { mic: *Mic<live>, max: i64 }
| ok string<std/io:allocated!>
| empty

~proc mic.read|zig {
    _ = mic;
    const cap: usize = @intCast(@max(0, max));
    var n: usize = 0;
    var avail: usize = 0;
    if (mic_tail >= mic_head) avail = mic_tail - mic_head else avail = MIC_RING_CAP - mic_head + mic_tail;
    n = @min(cap, avail);
    if (n == 0) return .{ .empty = .{} };
    const out = koru_allocator().alloc(u8, n * 4) catch @panic("host: OOM");
    var i: usize = 0;
    while (i < n) : (i += 1) {
        const s = mic_ring[mic_head];
        mic_head = (mic_head + 1) % MIC_RING_CAP;
        std.mem.writeInt(u32, out[i * 4 ..][0..4], @as(u32, @bitCast(s)), .little);
    }
    return .{ .ok = out };
}
