// OMNI's first vocabulary — file resources on the custody plane.
//
// `file-open` mints an obligation through the bridge: the returned string
// is an opaque 6-hex handle the pool books (created_by_event=file-open,
// type=string) and `file-close` discharges by consuming it. The module's
// own table records path + kind per slot — the surface reads those through
// the seam tors below, which are deliberately NOT in the register: a handle
// is never something to ask for, it is something you were given.
//
// kind: 0 = generic document, 1 = image (by extension), 2 = audio (by
// extension). The bridge owns custody; the app owns the decoded content —
// pixels for images, sample peaks for audio — views in the app, facts on
// the bridge.
//
// Audio decode: WAV/RIFF only, PCM s16 (what siri_mic_bridge writes:
// 48kHz mono s16le). Minting an audio kind walks the resource's actual
// bytes into AUDIO_BUCKETS min/max peak pairs per slot — the surface
// draws THOSE, never a synthesized wave. An audio resource that isn't
// decodable WAV mints kind 2 anyway (it IS audio) but carries zero
// buckets; res-wave-n says so honestly and the renderer draws a bare
// rail rather than invent samples.
//
// Document decode: minting a doc kind walks the resource's bytes into
// DOC_LINES preview lines per slot — the surface shapes and draws THOSE,
// never a stock icon or a "first page" stand-in. A resource whose bytes
// aren't readable text (a NUL byte means binary) mints kind 0 anyway
// (it IS a document) but carries zero lines; res-doc-n says so honestly
// and the renderer draws an empty card rather than invent content.

~import std/runtime

const std = @import("std");

const MAX_RESES = 10;

const AUDIO_BUCKETS = 96;
const WAV_CAP: usize = 16 * 1024 * 1024; // ~174s of 48k s16 mono

var wav_buf: [WAV_CAP]u8 = undefined;
var wave_lo: [MAX_RESES][AUDIO_BUCKETS]i16 = .{.{0} ** AUDIO_BUCKETS} ** MAX_RESES;
var wave_hi: [MAX_RESES][AUDIO_BUCKETS]i16 = .{.{0} ** AUDIO_BUCKETS} ** MAX_RESES;
var wave_n: [MAX_RESES]i64 = .{0} ** MAX_RESES;
var wave_rate: [MAX_RESES]i64 = .{0} ** MAX_RESES;
var wave_secs: [MAX_RESES]f64 = .{0.0} ** MAX_RESES;

// One bucket of decoded samples, normalized to [-1, 1] — the payload a
// res-wave-each firing hands the surface, one per draw call.
pub const WavePeak = struct {
    i: i64,
    lo: f64,
    hi: f64,
};

const DOC_LINES = 14;
const DOC_LINE_CAP = 96;
const DOC_CAP: usize = 64 * 1024;

var doc_buf: [DOC_CAP]u8 = undefined;
var doc_lines: [MAX_RESES][DOC_LINES][DOC_LINE_CAP]u8 = undefined;
var doc_line_len: [MAX_RESES][DOC_LINES]usize = .{.{0} ** DOC_LINES} ** MAX_RESES;
var doc_n: [MAX_RESES]i64 = .{0} ** MAX_RESES;

// One preview line of a document — the index plus the line's own text,
// sanitized to printable UTF-8. A res-doc-each firing hands the surface
// one per draw call, same idiom as WavePeak.
pub const DocLine = struct {
    i: i64,
    text: []const u8,
};

var files: [MAX_RESES]?std.fs.File = .{null} ** MAX_RESES;
var opened: usize = 0;

var handle_buf: [MAX_RESES][16]u8 = undefined;
var handle_len: [MAX_RESES]usize = .{0} ** MAX_RESES;
var path_buf: [MAX_RESES][256]u8 = undefined;
var path_len: [MAX_RESES]usize = .{0} ** MAX_RESES;
var kinds: [MAX_RESES]i64 = .{0} ** MAX_RESES;

var last_minted_buf: [16]u8 = undefined;
var last_minted_len: usize = 0;

var transcript_buf: [MAX_RESES][4096]u8 = undefined;

var mint_seed: u64 = 0;
var mint_count: u32 = 0;

fn slotOf(handle: []const u8) ?usize {
    var s: usize = 0;
    while (s < $mod.opened) : (s += 1) {
        if ($mod.files[s] != null and
            std.mem.eql(u8, $mod.handle_buf[s][0..$mod.handle_len[s]], handle))
        {
            return s;
        }
    }
    return null;
}

fn isImage(path: []const u8) bool {
    const exts = [_][]const u8{ ".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".tiff" };
    for (exts) |e| {
        if (std.mem.endsWith(u8, path, e)) return true;
    }
    return false;
}

fn isAudio(path: []const u8) bool {
    const exts = [_][]const u8{ ".wav", ".wave", ".aif", ".aiff", ".m4a", ".mp3", ".flac", ".ogg" };
    for (exts) |e| {
        if (std.mem.endsWith(u8, path, e)) return true;
    }
    return false;
}

// Walk the resource's bytes at mint: RIFF/WAVE chunks → fmt + data →
// per-bucket min/max over the s16 samples (all channels folded into the
// peak pair). Non-RIFF or non-PCM-s16 input leaves wave_n at 0 — the
// honest "no readable samples" state, not a decode guess.
fn decodeWave(slot: usize) void {
    $mod.wave_n[slot] = 0;
    $mod.wave_rate[slot] = 0;
    $mod.wave_secs[slot] = 0.0;
    const f = $mod.files[slot] orelse return;
    f.seekTo(0) catch return;
    const end = f.getEndPos() catch return;
    if (end == 0) return;
    const got = f.readAll($mod.wav_buf[0..@intCast(@min(end, WAV_CAP))]) catch return;
    const buf = $mod.wav_buf[0..got];
    if (buf.len < 12) return;
    if (!std.mem.eql(u8, buf[0..4], "RIFF") or !std.mem.eql(u8, buf[8..12], "WAVE")) return;
    var pos: usize = 12;
    var fmt_ok = false;
    var audio_format: u16 = 0;
    var channels: u16 = 0;
    var rate: u32 = 0;
    var bits: u16 = 0;
    var data: []const u8 = &.{};
    while (pos + 8 <= buf.len) {
        const csize: usize = std.mem.readInt(u32, buf[pos + 4 ..][0..4], .little);
        const body = buf[pos + 8 .. @min(buf.len, pos + 8 + csize)];
        if (std.mem.eql(u8, buf[pos..][0..4], "fmt ") and body.len >= 16) {
            audio_format = std.mem.readInt(u16, body[0..2], .little);
            channels = std.mem.readInt(u16, body[2..4], .little);
            rate = std.mem.readInt(u32, body[4..8], .little);
            bits = std.mem.readInt(u16, body[14..16], .little);
            fmt_ok = true;
        } else if (std.mem.eql(u8, buf[pos..][0..4], "data")) {
            data = body;
        }
        pos += 8 + csize + (csize & 1); // chunks pad to even
    }
    if (!fmt_ok or audio_format != 1 or bits != 16 or channels == 0 or rate == 0 or data.len == 0) return;
    const frame_bytes = @as(usize, channels) * 2;
    const frames = data.len / frame_bytes;
    if (frames == 0) return;
    $mod.wave_rate[slot] = @intCast(rate);
    $mod.wave_secs[slot] = @as(f64, @floatFromInt(frames)) / @as(f64, @floatFromInt(rate));
    const nb = @min(AUDIO_BUCKETS, frames);
    for (0..nb) |b| {
        var lo: i16 = 32767;
        var hi: i16 = -32768;
        for (b * frames / nb..(b + 1) * frames / nb) |s| {
            for (0..channels) |ch| {
                const v = std.mem.readInt(i16, data[s * frame_bytes + ch * 2 ..][0..2], .little);
                if (v < lo) lo = v;
                if (v > hi) hi = v;
            }
        }
        $mod.wave_lo[slot][b] = lo;
        $mod.wave_hi[slot][b] = hi;
    }
    $mod.wave_n[slot] = @intCast(nb);
}

// Walk the resource's bytes at mint into preview lines: '\n'-delimited,
// '\r' stripped, a UTF-8 BOM skipped, control bytes dropped, invalid or
// truncated UTF-8 spans skipped whole, each line capped at DOC_LINE_CAP
// on a codepoint boundary. A NUL byte anywhere in the read marks the
// resource as binary — doc_n stays 0, the honest "not text" state, and
// the renderer draws nothing where lines would sit.
fn decodeDoc(slot: usize) void {
    $mod.doc_n[slot] = 0;
    const f = $mod.files[slot] orelse return;
    f.seekTo(0) catch return;
    const end = f.getEndPos() catch return;
    if (end == 0) return;
    const got = f.readAll($mod.doc_buf[0..@intCast(@min(end, DOC_CAP))]) catch return;
    const buf = $mod.doc_buf[0..got];
    if (std.mem.indexOfScalar(u8, buf, 0) != null) return;
    var n: usize = 0;
    var pos: usize = 0;
    if (buf.len >= 3 and std.mem.eql(u8, buf[0..3], "\xEF\xBB\xBF")) pos = 3;
    while (n < DOC_LINES and pos < buf.len) {
        const nl = std.mem.indexOfScalarPos(u8, buf, pos, '\n') orelse buf.len;
        var line = buf[pos..nl];
        pos = nl + 1;
        if (line.len > 0 and line[line.len - 1] == '\r') line = line[0 .. line.len - 1];
        var w: usize = 0;
        var r: usize = 0;
        while (r < line.len and w < DOC_LINE_CAP) {
            const b = line[r];
            if (b < 0x20 or b == 0x7f) {
                r += 1;
            } else if (b < 0x80) {
                $mod.doc_lines[slot][n][w] = b;
                w += 1;
                r += 1;
            } else {
                const m = std.unicode.utf8ByteSequenceLength(b) catch {
                    r += 1;
                    continue;
                };
                if (r + m > line.len or w + m > DOC_LINE_CAP) break;
                _ = std.unicode.utf8Decode(line[r .. r + m]) catch {
                    r += 1;
                    continue;
                };
                @memcpy($mod.doc_lines[slot][n][w .. w + m], line[r .. r + m]);
                w += m;
                r += m;
            }
        }
        $mod.doc_line_len[slot][n] = w;
        n += 1;
    }
    $mod.doc_n[slot] = @intCast(n);
}

// ============================================================================
// file-open — mint custody of a file
// ============================================================================

~pub tor file-open { path: string }
| ok string<open!>
| not-found string

~proc file-open|zig {
    const f = std.fs.cwd().openFile(path, .{}) catch
        return .{ .not_found = path };

    var slot: usize = 0;
    while (slot < $mod.opened) : (slot += 1) {
        if ($mod.files[slot] == null) break;
    } else {
        slot = $mod.opened;
        if (slot >= MAX_RESES) @panic("omni: too many open resources");
        $mod.opened += 1;
    }
    $mod.files[slot] = f;
    // Resolve through symlinks — a card minted on the remote-mic link
    // should name the session it pointed at, and sidecars (.txt
    // transcripts) live beside the real file, not the link.
    var resolved: [std.fs.max_path_bytes]u8 = undefined;
    const real = std.fs.cwd().realpath(path, &resolved) catch path;
    const n = @min(real.len, 255);
    @memcpy($mod.path_buf[slot][0..n], real[0..n]);
    $mod.path_len[slot] = n;
    $mod.kinds[slot] = if (isImage(real)) 1 else if (isAudio(real)) 2 else 0;
    if ($mod.kinds[slot] == 2) decodeWave(slot);
    if ($mod.kinds[slot] == 0) decodeDoc(slot);

    if ($mod.mint_seed == 0) {
        $mod.mint_seed = std.crypto.random.int(u64);
    }
    var mix = $mod.mint_seed;
    mix ^= mix >> 33;
    mix *%= 0xff51afd7ed558ccd;
    mix ^= mix >> 33;
    mix +%= @as(u64, $mod.mint_count + 1) *% 0x9e3779b97f4a7c15;
    mix ^= mix >> 33;
    $mod.mint_count += 1;

    var candidate: [8]u8 = undefined;
    var attempts: u32 = 0;
    while (true) : (attempts += 1) {
        const c = std.fmt.bufPrint(&candidate, "{x:0>6}", .{@as(u24, @truncate(mix))}) catch @panic("omni: handle too long");
        var collides = false;
        for (0..$mod.opened) |s| {
            if ($mod.files[s] != null and
                std.mem.eql(u8, $mod.handle_buf[s][0..$mod.handle_len[s]], c))
            {
                collides = true;
                break;
            }
        }
        if (!collides) {
            @memcpy($mod.handle_buf[slot][0..c.len], c);
            $mod.handle_len[slot] = c.len;
            break;
        }
        if (attempts > 32) @panic("omni: handle collision after retries");
        mix ^= mix >> 33;
        mix *%= 0xbf58476d1ce4e5b9;
        mix ^= mix >> 29;
    }
    $mod.last_minted_len = $mod.handle_len[slot];
    @memcpy($mod.last_minted_buf[0..$mod.last_minted_len], $mod.handle_buf[slot][0..$mod.handle_len[slot]]);
    return .{ .ok = $mod.handle_buf[slot][0..$mod.handle_len[slot]] };
}

// ============================================================================
// file-close — discharge custody
// ============================================================================

~pub tor file-close { handle: string<!open> }

~proc file-close|zig {
    const slot = slotOf(handle) orelse @panic("omni: close on a handle this module never minted");
    if ($mod.files[slot]) |f| {
        f.close();
        $mod.files[slot] = null;
    }
    $mod.kinds[slot] = 0;
    $mod.wave_n[slot] = 0;
    $mod.doc_n[slot] = 0;
}

// ============================================================================
// say — the voice is a tool call like any other
// ============================================================================

~pub tor say { text: string }

~proc say|zig {
    std.debug.print("      {s}\n", .{text});
}

// ============================================================================
// THE SEAM — surface reads, NOT in the register
// ============================================================================
//
// The surface enumerates what it may draw through these: slot-stable ids,
// path + kind metadata, and liveness. They mirror the pool because mint and
// release both flow through this module's registered verbs — the bridge's
// discharge paths call file-close.

~[retain]pub tor res-max {} -> i64

~proc res-max|zig {
    return @intCast(MAX_RESES);
}

~[retain]pub tor res-live { slot: i64 } -> i64

~proc res-live|zig {
    const s: usize = @intCast(@max(0, @min(slot, MAX_RESES - 1)));
    return if (s < $mod.opened and $mod.files[s] != null) 1 else 0;
}

~[retain]pub tor res-id { slot: i64 } -> string

~proc res-id|zig {
    const s: usize = @intCast(@max(0, @min(slot, MAX_RESES - 1)));
    return $mod.handle_buf[s][0..$mod.handle_len[s]];
}

~[retain]pub tor res-path { slot: i64 } -> string

~proc res-path|zig {
    const s: usize = @intCast(@max(0, @min(slot, MAX_RESES - 1)));
    return $mod.path_buf[s][0..$mod.path_len[s]];
}

~[retain]pub tor res-kind { slot: i64 } -> i64

~proc res-kind|zig {
    const s: usize = @intCast(@max(0, @min(slot, MAX_RESES - 1)));
    return $mod.kinds[s];
}

// The transcript seam — a voice session's sidecar text, when the
// Whistle watcher has landed it. Re-read per call on purpose: the card
// mints at button-release and the transcript arrives a beat later, so a
// stale read would never see it land. Absent or empty sidecar → "".
// `res-transcript-n` is the byte count for the draw-side conditional.
~[retain]pub tor res-transcript { slot: i64 } -> string

~proc res-transcript|zig {
    const s: usize = @intCast(@max(0, @min(slot, MAX_RESES - 1)));
    const n = transcriptRead(s);
    return $mod.transcript_buf[s][0..n];
}

~[retain]pub tor res-transcript-n { slot: i64 } -> i64

~proc res-transcript-n|zig {
    const s: usize = @intCast(@max(0, @min(slot, MAX_RESES - 1)));
    return @intCast(transcriptRead(s));
}

fn transcriptRead(s: usize) usize {
    if ($mod.files[s] == null) return 0;
    const path = $mod.path_buf[s][0..$mod.path_len[s]];
    if (path.len == 0 or path.len + 4 >= 256) return 0;
    // The sidecar replaces the extension: mic_1.wav → mic_1.txt.
    var stem = path.len;
    if (std.mem.lastIndexOfScalar(u8, path, '.')) |dot| stem = dot;
    var tpath: [260]u8 = undefined;
    @memcpy(tpath[0..stem], path[0..stem]);
    @memcpy(tpath[stem..][0..4], ".txt");
    const f = std.fs.cwd().openFile(tpath[0 .. stem + 4], .{}) catch return 0;
    defer f.close();
    return f.readAll($mod.transcript_buf[s][0..]) catch 0;
}

// The audio seam — what a kind-2 resource carries. `res-wave-n` is the
// decoded bucket count (0 = nothing readable was in the bytes);
// `res-wave-each` fires once per bucket with the normalized min/max pair,
// the same `libs/clay:each` event idiom — the surface draws one bar per
// firing. `res-wave-rate`/`res-wave-secs` are the fmt-chunk facts.
~[retain]pub tor res-wave-n { slot: i64 } -> i64

~proc res-wave-n|zig {
    const s: usize = @intCast(@max(0, @min(slot, MAX_RESES - 1)));
    return $mod.wave_n[s];
}

~[retain]pub tor res-wave-rate { slot: i64 } -> i64

~proc res-wave-rate|zig {
    const s: usize = @intCast(@max(0, @min(slot, MAX_RESES - 1)));
    return $mod.wave_rate[s];
}

~[retain]pub tor res-wave-secs { slot: i64 } -> f64

~proc res-wave-secs|zig {
    const s: usize = @intCast(@max(0, @min(slot, MAX_RESES - 1)));
    return $mod.wave_secs[s];
}

~[retain]pub tor res-wave-each { slot: i64 }
! peak WavePeak
| drained

~proc res-wave-each|zig {
    const s: usize = @intCast(@max(0, @min(slot, $mod.MAX_RESES - 1)));
    for (0..@intCast(@max(0, $mod.wave_n[s]))) |i| {
        peak(.{
            .i = @as(i64, @intCast(i)),
            .lo = @as(f64, @floatFromInt($mod.wave_lo[s][i])) / 32768.0,
            .hi = @as(f64, @floatFromInt($mod.wave_hi[s][i])) / 32768.0,
        });
    }
    return .{ .drained = .{} };
}

// The document seam — what a kind-0 resource carries. `res-doc-n` is the
// decoded preview-line count (0 = the bytes weren't readable text);
// `res-doc-each` fires once per line with its index and the line's own
// text — the same `libs/clay:each` event idiom — the surface draws one
// text run per firing.
~[retain]pub tor res-doc-n { slot: i64 } -> i64

~proc res-doc-n|zig {
    const s: usize = @intCast(@max(0, @min(slot, MAX_RESES - 1)));
    return $mod.doc_n[s];
}

~[retain]pub tor res-doc-each { slot: i64 }
! row DocLine
| drained

~proc res-doc-each|zig {
    const s: usize = @intCast(@max(0, @min(slot, $mod.MAX_RESES - 1)));
    for (0..@intCast(@max(0, $mod.doc_n[s]))) |i| {
        row(.{
            .i = @as(i64, @intCast(i)),
            .text = $mod.doc_lines[s][i][0..$mod.doc_line_len[s][i]],
        });
    }
    return .{ .drained = .{} };
}

// ============================================================================
// THE PERMISSION MODEL
// ============================================================================

~std/runtime:register(scope: "image") {
    file-open(10)
    file-close(1)
    say(1)
}
