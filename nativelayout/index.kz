    e.fae = @min(@max(fae, 0), 8);
    e.fap = @min(@max(fap, 0), 8);
    e.exw = @floatCast(exw);
    e.exh = @floatCast(exh);
    e.zi = @min(@max(zi, -32768), 32767);
    e.fct = @min(@max(fct, 0), 1);
    const __ei: i32 = @intCast(t.n.stack.items[t.n.stack.items.len - 1]);
    if (e.fat != 0) {
