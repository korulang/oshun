~pub tor nl.el.text {
    t: *NTree<ntree>,
    tx: string, fs: f64,
    r: f64, g: f64, b: f64, a: f64,
    eid: i64,
    fid: i64, ls: i64, lh: i64, wm: i64, tal: i64,
}

~proc nl.el.text|zig {
    const n = t.n;
    const idx: i32 = @intCast(n.els.items.len);
    n.els.append($mod.alloc, .{}) catch @panic("nl: OOM");
    $mod.els_clip_anc(n);
    const e = &n.els.items[@intCast(idx)];
    e.is_text = true;
    e.tx = tx;
    e.fs = @intFromFloat(@max(@round(fs), 0));
    e.tcr = @floatCast(r);
    e.tcg = @floatCast(g);
    e.tcb = @floatCast(b);
    e.tca = @floatCast(a);
    e.fid = @intCast(@min(@max(fid, 0), 65535));
    e.ls = @intCast(@min(@max(ls, 0), 65535));
    e.lh = @intCast(@min(@max(lh, 0), 65535));
    e.wm = @min(@max(wm, 0), 2);
    e.tal = @min(@max(tal, 0), 2);
    e.ud = @intCast(@as(u64, @bitCast(eid)));
    e.w0 = @intCast(n.words.items.len);
    // Cache key covers the measure-affecting config only, matching
    // HashStringContentsWithConfig: contents + fontId + fontSize +
    // letterSpacing. lh/wm/tal never shape a measurement.
    var hash = std.hash.Wyhash.init(0);
    hash.update(e.tx);
    var cfgb: [6]u8 = undefined;
    std.mem.writeInt(u16, cfgb[0..2], e.fs, .little);
    std.mem.writeInt(u16, cfgb[2..4], e.ls, .little);
    std.mem.writeInt(u16, cfgb[4..6], e.fid, .little);
    hash.update(&cfgb);
    const mkey = hash.final();
    if (n.mcache.get(mkey)) |hit| {
        const w0: usize = hit.w0;
        n.words.appendSlice($mod.alloc, n.mwords.items[w0..w0 + hit.nw]) catch @panic("nl: OOM");
        e.nw = @intCast(hit.nw);
        e.tmin = hit.tmin;
        e.unw_h = hit.unw_h;
        e.unw_w = hit.unw_w;
        e.has_nl = hit.has_nl;
        e.dw = e.unw_w;
        e.dh = if (e.lh > 0) @floatFromInt(e.lh) else e.unw_h;
        e.mw = e.tmin;
        e.mh = e.dh;
    } else {
        $mod.measureWords(n, e);
        const nw: usize = n.words.items.len - @as(usize, @intCast(e.w0));
        // Bounded like Clay's maxMeasureTextCacheWordCount (16384
        // words): over cap we sweep and refill rather than refuse —
        // results are identical, only shaping cost changes. No
        // generation eviction: stale entries are dead weight until
        // the sweep.
        if (n.mwords.items.len + nw > 16384) {
            n.mcache.clearRetainingCapacity();
            n.mwords.clearRetainingCapacity();
        }
        const mw0: u32 = @intCast(n.mwords.items.len);
        n.mwords.appendSlice($mod.alloc, n.words.items[@as(usize, @intCast(e.w0))..]) catch @panic("nl: OOM");
        n.mcache.put($mod.alloc, mkey, .{ .w0 = mw0, .nw = @intCast(nw), .tmin = e.tmin, .unw_h = e.unw_h, .unw_w = e.unw_w, .has_nl = e.has_nl }) catch @panic("nl: OOM");
    }
    // Attaches to the open parent like a closed child — never opened.
    const p = &n.els.items[@intCast(n.stack.items[n.stack.items.len - 1])];
    p.nc += 1;
    e.par = @intCast(n.stack.items[n.stack.items.len - 1]);
    n.kidsbuf.append($mod.alloc, idx) catch @panic("nl: OOM");
}

~pub tor nl.el.close { t: *NTree<ntree> }

~proc nl.el.close|zig {
    $mod.closeEl(t.n);
    t.depth -= 1;
}

~pub tor nl.el.close-to { t: *NTree<ntree>, d: i64 }

~proc nl.el.close-to|zig {
    while (t.depth > d) : (t.depth -= 1) $mod.closeEl(t.n);
}

~pub tor nl.release.ntree { t: *NTree<!ntree> }

~proc nl.release.ntree|zig { _ = &t; }

~pub tor nl.cmd.count { cl: *Native<solved|ready> } -> i64

~proc nl.cmd.count|zig {
    return @intCast(cl.cmds.items.len);
}

~pub tor nl.each { cl: *Native<solved> }
! cmd libs/clay:CmdView
| drained

~proc nl.each|zig {
    for (cl.cmds.items) |*__rc| {
        const is_text = __rc.kind == 3;
        cmd(.{
            .kind = __rc.kind,
            .x = __rc.x,
            .y = __rc.y,
            .w = __rc.w,
            .h = __rc.h,
            .r = __rc.r / 255.0,
            .g = __rc.g / 255.0,
            .b = __rc.b / 255.0,
            .a = __rc.a / 255.0,
            .img = if (__rc.kind == 4) @as(i64, @intCast(__rc.img)) else 0,
            .cd = if (__rc.kind == 9) @as(i64, @intCast(__rc.cd)) else 0,
            .ud = @as(i64, @bitCast(@as(u64, @intCast(__rc.ud)))),
            .tx = if (is_text) __rc.tx else "",
            .fs = if (is_text) @as(f64, @floatFromInt(__rc.fs)) else 0.0,
            .ctl = __rc.ctl,
            .ctr = __rc.ctr,
            .cbl = __rc.cbl,
            .cbr = __rc.cbr,
            .bwl = __rc.bwl,
            .bwr = __rc.bwr,
            .bwt = __rc.bwt,
            .bwb = __rc.bwb,
            .bwc = __rc.bwc,
            .fi = @as(i64, __rc.fi),
            .ls = __rc.ls,
            .lh = __rc.lh,
            .zi = __rc.zi,
        });
    }
    return .{ .drained = .{} };
}
