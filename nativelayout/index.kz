        if (e.fct == 0) cid = -1;
        e.clipAnc = cid;
        t.n.clipStk.append($mod.alloc, cid) catch @panic("nl: OOM");
        const __par: i32 = switch (e.fat) {
            1 => t.n.stack.items[t.n.stack.items.len - 2],
            3 => 0,
            else => -1,
        };
        $mod.addRoot(t.n, __ei, __par, cid, @intCast(e.zi));
    }
    if (e.ch or e.cv) t.n.clipStk.append($mod.alloc, __ei) catch @panic("nl: OOM");
