// @korulang/nativelayout — a parallel layout bracket over flat arrays.
// Owns its own module so `libs/clay` consumers never pay for it; the fuzz
// gate (clay/tests/fuzz_gate.k) imports it directly as the candidate arm.

~std/build:requires {
    exe.linkLibC();
    exe.linkFramework("CoreText");
    exe.linkFramework("CoreFoundation");
    exe.addIncludePath(.{ .cwd_relative = "/Users/larsde/src/oshun/clay" });
    exe.addCSourceFile(.{ .file = .{ .cwd_relative = "/Users/larsde/src/oshun/clay/clay_impl.c" }, .flags = &.{} });
}

~std/compiler:requires {
    exe.linkLibC();
    exe.linkFramework("CoreText");
    exe.linkFramework("CoreFoundation");
    exe.addIncludePath(.{ .cwd_relative = "/Users/larsde/src/oshun/clay" });
    if (exe.root_module.import_table.get("backend_output")) |mod| {
        mod.addIncludePath(.{ .cwd_relative = "/Users/larsde/src/oshun/clay" });
        mod.addCSourceFile(.{ .file = .{ .cwd_relative = "/Users/larsde/src/oshun/clay/clay_impl.c" }, .flags = &.{} });
    }
}

const std = @import("std");

// ABI twin of Clay_Dimensions — two f32s by value from koru_clay_measure.
const Dims = extern struct { width: f32, height: f32 };
extern fn koru_clay_measure(chars: [*c]const u8, len: i32, size: f64, ls: i32) Dims;

// ============================================================================
// Native solver (nl.*) — a parallel layout bracket over flat arrays.
//
// Same declare→solve→CmdView contract as the clay:* bracket: the same tree
// token shape, the same open/cfg/close ops, the same `each` drain producing
// the same command ordinals and fields. This is a port of clay.h's pipeline
// (Clay__SizeContainersAlongAxis / Clay__CalculateFinalLayout /
// Clay__CloseElement / Clay__MeasureTextCached) restricted to the dialect's
// reachable vocabulary (clay/NATIVE_SOLVER_BRIEF §4):
//
//   sizing fit(0,v)/grow(v,v)/percent(v)/fixed(v,v) per axis — grow's
//     min=max=v quirk included (star w:0 is the only unbounded grow)
//   uniform padding, child gap, LTR/TTB, child alignment
//   background colors, root-attached floats (LEFT_TOP/LEFT_TOP + offset)
//   image elements, h/v clip + childOffset scissor pairs
//   text: word-split measurement (spaces fold into word width, '\n' emits a
//     zero-length word), wrap to solved width, per-line commands
//   userData → CmdView.ud
//   offscreen culling: x > W || y > H || x+w < 0 || y+h < 0, per element —
//     an offscreen clip element skips BOTH scissor commands but its
//     children still emit if their own boxes are onscreen
//
// Dropped by construction, never silently: element ids and hashing (ud is
// the command identity), borders, aspect ratio, z-index, transitions,
// overlay/custom, per-side padding, the wider attachment matrix, and the
// measure cache (measure is called directly per word — same inputs, same
// numbers; the cache is a perf detail, not semantics). The fuzz gate
// (tests/fuzz_gate.k) holds CAND ≡ REF per command field — any port error
// is a stream diff, not a guess.
// ============================================================================

pub const NTree = struct {
    n: *Native,
    depth: i64,
};

pub const Native = struct {
    w: f32,
    h: f32,
    els: std.ArrayListUnmanaged(El) = .{},
    kids: std.ArrayListUnmanaged(i32) = .{},
    kidsbuf: std.ArrayListUnmanaged(i32) = .{},
    stack: std.ArrayListUnmanaged(i32) = .{},
    // Floating registrations — one entry per configure call that sees
    // attachTo != NONE (clay.h:2154 LayoutElementTreeRootArray_Add), so a
    // reconfigured element emits once per registration. par/clip freeze the
    // resolution done at configure time (element indices; -1 = none); zi is
    // the declaration's zIndex at that call.
    roots: std.ArrayListUnmanaged(Root) = .{},
    // clay.h's openClipElementStack: pushed at every clip configure (own
    // index) and every floating configure (resolved clip ancestor, possibly
    // -1), popped ONCE per closed element whose final config has clip or
    // floating — reconfigures leak entries, mirroring upstream.
    clipStk: std.ArrayListUnmanaged(i32) = .{},
    bfs: std.ArrayListUnmanaged(i32) = .{},
    rbuf: std.ArrayListUnmanaged(i32) = .{},
    texts: std.ArrayListUnmanaged(i32) = .{},
    aspects: std.ArrayListUnmanaged(i32) = .{},
    words: std.ArrayListUnmanaged(Wd) = .{},
    lines: std.ArrayListUnmanaged(Wl) = .{},
    cmds: std.ArrayListUnmanaged(Cmd) = .{},
    // Persistent measure cache — survives nl.layout, mirroring Clay's
    // measureTextHashMap living in InitializePersistentMemory.
    mcache: std.AutoHashMapUnmanaged(u64, MEnt) = .{},
    mwords: std.ArrayListUnmanaged(Wd) = .{},
};

// Sizing kinds — same ordinals as the clay binding (sizing()).
const FIT: u8 = 0;
const GROW: u8 = 1;
const PCT: u8 = 2;
const FIX: u8 = 3;
const LTR: u8 = 0;
const TTB: u8 = 1;

const MAXF: f32 = 3.4028234663852886e+38;
const EPS: f32 = 0.01;

// Mirror of ConfigureOpenElementPtr's percentage-over-1 diagnostic —
// fires per configure call on the declared sizing, before any field work.
// CLAY_ERROR_TYPE_PERCENTAGE_OVER_1 is enum ordinal 6.
fn pctOverErr() void {
    std.debug.print("nl: error 6: An element was configured with CLAY_SIZING_PERCENT, but the provided percentage value was over 1.0. Clay expects a value between 0 and 1, i.e. 20% is 0.2.\n", .{});
    std.fs.File.stdout().writeAll("err t=6\n") catch {};
}

const El = struct {
    wk: u8 = 0,
    hk: u8 = 0,
    // Effective minMax per axis after CloseElement's MAXFLOAT reset.
    // fit → {0, v|MAXF}; grow/fixed → {v, v|MAXF}; percent → {v, 0} — the
    // raw union bytes Clay reads back as size.minMax.
    wmn: f32 = 0,
    wmx: f32 = 0,
    hmn: f32 = 0,
    hmx: f32 = 0,
    dir: u8 = 0,
    padl: u16 = 0,
    padr: u16 = 0,
    padt: u16 = 0,
    padb: u16 = 0,
    gap: u16 = 0,
    ax: u8 = 0,
    ay: u8 = 0,
    r: f32 = 0,
    g: f32 = 0,
    b: f32 = 0,
    a: f32 = 0,
    ovr: f32 = 0,
    ovg: f32 = 0,
    ovb: f32 = 0,
    ova: f32 = 0,
    ctl: f32 = 0,
    ctr: f32 = 0,
    cbl: f32 = 0,
    cbr: f32 = 0,
    fat: i64 = 0,
    fx: f32 = 0,
    fy: f32 = 0,
    fae: i64 = 0,
    fap: i64 = 0,
    exw: f32 = 0,
    exh: f32 = 0,
    zi: i64 = 0,
    fct: i64 = 0,
    fpar: i32 = -1,
    clipAnc: i32 = -1,
    ch: bool = false,
    cv: bool = false,
    ox: f32 = 0,
    oy: f32 = 0,
    img: usize = 0,
    cd: usize = 0,
    ar: f32 = 0,
    br: f32 = 0,
    bg: f32 = 0,
    bb: f32 = 0,
    ba: f32 = 0,
    bwl: u16 = 0,
    bwr: u16 = 0,
    bwt: u16 = 0,
    bwb: u16 = 0,
    bwc: u16 = 0,
    ud: usize = 0,
    is_text: bool = false,
    tx: []const u8 = "",
    fs: u16 = 0,
    tcr: f32 = 0,
    tcg: f32 = 0,
    tcb: f32 = 0,
    tca: f32 = 0,
    fid: u16 = 0,
    ls: u16 = 0,
    lh: u16 = 0,
    wm: i64 = 0,
    tal: i64 = 0,
    // solved
    dw: f32 = 0,
    dh: f32 = 0,
    mw: f32 = 0,
    mh: f32 = 0,
    fc: i32 = -1,
    nc: i32 = 0,
    par: i32 = -1,
    bx: f32 = 0,
    by: f32 = 0,
    // emitted bounding box (clay.h:3100 — post-expand, written at DFS visit)
    ebx: f32 = 0,
    eby: f32 = 0,
    ebw: f32 = 0,
    ebh: f32 = 0,
    // text: word range in n.words, wrapped-line range in n.lines
    w0: i32 = 0,
    nw: i32 = 0,
    l0: i32 = 0,
    nl: i32 = 0,
    unw_w: f32 = 0,
    unw_h: f32 = 0,
    tmin: f32 = 0,
    has_nl: bool = false,
};

const Wd = struct { s: i32, len: i32, w: f32 };
const Wl = struct { w: f32, h: f32, s: i32, len: i32 };

// Cache entry: the four outputs measureWords derives from a text's
// shape, plus the word range in the persistent mwords arena.
const MEnt = struct { w0: u32, nw: u32, tmin: f32, unw_h: f32, unw_w: f32, has_nl: bool };

const Cmd = struct {
    kind: i64,
    x: f32 = 0,
    y: f32 = 0,
    w: f32 = 0,
    h: f32 = 0,
    r: f32 = 0,
    g: f32 = 0,
    b: f32 = 0,
    a: f32 = 0,
    img: usize = 0,
    cd: usize = 0,
    ud: usize = 0,
    tx: []const u8 = "",
    fs: u16 = 0,
    ctl: f32 = 0,
    ctr: f32 = 0,
    cbl: f32 = 0,
    cbr: f32 = 0,
    bwl: f32 = 0,
    bwr: f32 = 0,
    bwt: f32 = 0,
    bwb: f32 = 0,
    bwc: f32 = 0,
    fi: u16 = 0,
    ls: f32 = 0,
    lh: f32 = 0,
    zi: i64 = 0,
};

const alloc = std.heap.page_allocator;

fn fEq(a: f32, b: f32) bool {
    const d = a - b;
    return d < EPS and d > -EPS;
}

fn fClamp(v: f32, lo: f32, hi: f32) f32 {
    return @min(@max(v, lo), hi);
}

fn offscreen(n: *const Native, x: f32, y: f32, w: f32, h: f32) bool {
    return x > n.w or y > n.h or x + w < 0 or y + h < 0;
}

// ============================================================================
// Declaration — mirror of OpenElement / ConfigureOpenElement / CloseElement /
// OpenTextElement. Children accumulate in kidsbuf in close order; each close
// moves its run into the flat kids array.
// ============================================================================

fn setSizing(e: *El, xAxis: bool, kind: i64, v: f64) void {
    const f: f32 = @floatCast(v);
    const k: u8 = @intCast(@min(@max(kind, 0), 3));
    if (xAxis) {
        e.wk = k;
        e.wmn = if (k == FIT) 0 else f;
        e.wmx = if (k == PCT) 0 else f;
    } else {
        e.hk = k;
        e.hmn = if (k == FIT) 0 else f;
        e.hmx = if (k == PCT) 0 else f;
    }
}

// Clay__UpdateAspectRatioBox — fill a zero dim from the other at ar.
// Called at the same three sites clay.h fires it: end of closeEl, and
// after each percent expansion inside sizeAxis.
fn updAspect(e: *El) void {
    if (e.ar != 0) {
        if (e.dw == 0 and e.dh != 0) {
            e.dw = e.dh * e.ar;
        } else if (e.dw != 0 and e.dh == 0) {
            e.dh = e.dw * (1.0 / e.ar);
        }
    }
}

fn els_clip_anc(n: *Native) void {
    const i = n.els.items.len - 1;
    n.els.items[i].clipAnc = if (n.clipStk.items.len > 0) n.clipStk.items[n.clipStk.items.len - 1] else -1;
}

fn closeEl(n: *Native) void {
    const idx = n.stack.items[n.stack.items.len - 1];
    const e = &n.els.items[@intCast(idx)];
    const plr: f32 = @floatFromInt(@as(i64, e.padl) + @as(i64, e.padr));
    const ptb: f32 = @floatFromInt(@as(i64, e.padt) + @as(i64, e.padb));
    const buf = n.kidsbuf.items;
    const base = buf.len - @as(usize, @intCast(e.nc));
    e.fc = @intCast(n.kids.items.len);
    if (e.dir == LTR) {
        e.dw = plr;
        e.mw = plr;
        for (buf[base..]) |ci| {
            const ce = &n.els.items[@intCast(ci)];
            e.dw += ce.dw;
            e.dh = @max(e.dh, ce.dh + ptb);
            if (!e.ch) e.mw += ce.mw;
            if (!e.cv) e.mh = @max(e.mh, ce.mh + ptb);
            n.kids.append(alloc, ci) catch @panic("nl: OOM");
        }
        const gaps: f32 = @floatFromInt(@max(@as(i64, e.nc) - 1, 0) * @as(i64, e.gap));
        e.dw += gaps;
        if (!e.ch) e.mw += gaps;
    } else {
        e.dh = ptb;
        e.mh = ptb;
        for (buf[base..]) |ci| {
            const ce = &n.els.items[@intCast(ci)];
            e.dh += ce.dh;
            e.dw = @max(e.dw, ce.dw + plr);
            if (!e.cv) e.mh += ce.mh;
            if (!e.ch) e.mw = @max(e.mw, ce.mw + plr);
            n.kids.append(alloc, ci) catch @panic("nl: OOM");
        }
        const gaps: f32 = @floatFromInt(@max(@as(i64, e.nc) - 1, 0) * @as(i64, e.gap));
        e.dh += gaps;
        if (!e.cv) e.mh += gaps;
    }
    n.kidsbuf.items.len = base;
    if (e.wk != PCT) {
        if (e.wmx <= 0) e.wmx = MAXF;
        e.dw = fClamp(e.dw, e.wmn, e.wmx);
        e.mw = fClamp(e.mw, e.wmn, e.wmx);
    } else e.dw = 0;
    if (e.hk != PCT) {
        if (e.hmx <= 0) e.hmx = MAXF;
        e.dh = fClamp(e.dh, e.hmn, e.hmx);
        e.mh = fClamp(e.mh, e.hmn, e.hmx);
    } else e.dh = 0;
    updAspect(e);

    n.stack.items.len -= 1;
    if (n.stack.items.len > 1) {
        const pidx = n.stack.items[n.stack.items.len - 1];
        const p = &n.els.items[@intCast(pidx)];
        if (e.fat == 0) {
            p.nc += 1;
            e.par = @intCast(pidx);
            n.kidsbuf.append(alloc, idx) catch @panic("nl: OOM");
            // Final config not floating — drop roots an earlier floating
            // configure registered on this element (clay.h CloseElement purge).
            dropRootsFor(n, idx);
        } else {
            // floating roots resolve PARENT attach against the hierarchical
            // parent (clay.h:2130 — parentId = hierarchicalParent->id).
            e.fpar = @intCast(pidx);
        }
    }
    // clay.h:1876 — one clip-stack pop per close, only if the element's
    // FINAL config has clip or floating.
    if (e.ch or e.cv or e.fat != 0) {
        if (n.clipStk.items.len > 0) n.clipStk.items.len -= 1;
    }
}

// Text measurement — Clay__MeasureTextCached minus the cache: same word
// splitting (' ' folds a trailing spaceWidth into the word's width and
// length; '\n' emits a zero-length word), same minWidth / unwrapped dims.
fn measureWords(n: *Native, e: *El) void {
    const tx = e.tx;
    const fs: f64 = @floatFromInt(e.fs);
    const ls: i32 = @intCast(e.ls);
    const spw = koru_clay_measure(" ", 1, fs, ls).width;
    var lw: f32 = 0;
    var mw: f32 = 0;
    var start: usize = 0;
    var end: usize = 0;
    while (end < tx.len) : (end += 1) {
        const ch = tx[end];
        if (ch == ' ' or ch == '\n') {
            const len = end - start;
            var dw: f32 = 0;
            var dh: f32 = 0;
            if (len > 0) {
                const d = koru_clay_measure(tx[start..].ptr, @intCast(len), fs, ls);
                dw = d.width;
                dh = d.height;
            }
            e.tmin = @max(dw, e.tmin);
            e.unw_h = @max(e.unw_h, dh);
            if (ch == ' ') {
                dw += spw;
                n.words.append(alloc, .{ .s = @intCast(start), .len = @intCast(len + 1), .w = dw }) catch @panic("nl: OOM");
                lw += dw;
            }
            if (ch == '\n') {
                if (len > 0) {
                    n.words.append(alloc, .{ .s = @intCast(start), .len = @intCast(len), .w = dw }) catch @panic("nl: OOM");
                }
                n.words.append(alloc, .{ .s = @intCast(end + 1), .len = 0, .w = 0 }) catch @panic("nl: OOM");
                lw += dw;
                mw = @max(lw, mw);
                e.has_nl = true;
                lw = 0;
            }
            start = end + 1;
        }
    }
    if (end - start > 0) {
        const d = koru_clay_measure(tx[start..].ptr, @intCast(end - start), fs, ls);
        n.words.append(alloc, .{ .s = @intCast(start), .len = @intCast(end - start), .w = d.width }) catch @panic("nl: OOM");
        lw += d.width;
        e.unw_h = @max(e.unw_h, d.height);
        e.tmin = @max(d.width, e.tmin);
    }
    // clay.h:1766 — unwrapped width sheds one trailing letterSpacing.
    e.unw_w = @max(lw, mw) - @as(f32, @floatFromInt(e.ls));
    e.dw = e.unw_w;
    e.dh = if (e.lh > 0) @floatFromInt(e.lh) else e.unw_h;
    e.mw = e.tmin;
    e.mh = e.dh;
    e.nw = @intCast(n.words.items.len - @as(usize, @intCast(e.w0)));
}

// ============================================================================
// Solve — port of Clay__SizeContainersAlongAxis + CalculateFinalLayout.
// ============================================================================

fn dim(e: *El, xAxis: bool) *f32 {
    return if (xAxis) &e.dw else &e.dh;
}
fn mdim(e: *El, xAxis: bool) f32 {
    return if (xAxis) e.mw else e.mh;
}
fn stype(e: *El, xAxis: bool) u8 {
    return if (xAxis) e.wk else e.hk;
}
fn smin(e: *El, xAxis: bool) f32 {
    return if (xAxis) e.wmn else e.hmn;
}
fn smax(e: *El, xAxis: bool) f32 {
    return if (xAxis) e.wmx else e.hmx;
}
fn clipsAxis(e: *El, xAxis: bool) bool {
    return if (xAxis) e.ch else e.cv;
}

fn sizeAxis(n: *Native, xAxis: bool) void {
    n.bfs.clearRetainingCapacity();
    for (n.roots.items) |re| {
        const ri = re.el;
        n.bfs.items.len = 0;
        const root = &n.els.items[@intCast(ri)];
        if (root.fat != 0) {
            // attachTo PARENT → hierarchical parent's solved dims;
            // ROOT → the implicit root container {W,H} (clay.h:2290).
            var pw: f32 = n.w;
            var ph: f32 = n.h;
            if (root.fat == 1 and root.fpar >= 0) {
                const pe = &n.els.items[@intCast(root.fpar)];
                pw = pe.dw;
                ph = pe.dh;
            }
            if (xAxis) {
                if (root.wk == GROW) root.dw = pw;
                if (root.wk == PCT) root.dw = pw * root.wmn;
            } else {
                if (root.hk == GROW) root.dh = ph;
                if (root.hk == PCT) root.dh = ph * root.hmn;
            }
        }
        if (xAxis) {
            if (root.wk != PCT) root.dw = fClamp(root.dw, root.wmn, root.wmx);
        } else {
            if (root.hk != PCT) root.dh = fClamp(root.dh, root.hmn, root.hmx);
        }
        n.bfs.append(alloc, ri) catch @panic("nl: OOM");
        var bi: usize = 0;
        while (bi < n.bfs.items.len) : (bi += 1) {
            const pi = n.bfs.items[bi];
            const p = &n.els.items[@intCast(pi)];
            var growCount: i32 = 0;
            const parentSize = dim(p, xAxis).*;
            const parentPad: f32 = @floatFromInt(if (xAxis) @as(i64, p.padl) + @as(i64, p.padr) else @as(i64, p.padt) + @as(i64, p.padb));
            var inner: f32 = 0;
            var totalPadGaps: f32 = parentPad;
            const along = (xAxis and p.dir == LTR) or (!xAxis and p.dir == TTB);
            n.rbuf.items.len = 0;
            const gap: f32 = @floatFromInt(p.gap);
            var first = true;
            const kids = n.kids.items[@intCast(p.fc)..@intCast(p.fc + p.nc)];
            for (kids) |ci| {
                const ce = &n.els.items[@intCast(ci)];
                const ck = stype(ce, xAxis);
                const cs = dim(ce, xAxis).*;
                if (xAxis and ce.is_text) {
                    n.texts.append(alloc, ci) catch @panic("nl: OOM");
                } else if (ce.nc > 0) {
                    n.bfs.append(alloc, ci) catch @panic("nl: OOM");
                }
                if (xAxis and !ce.is_text and ce.ar != 0) {
                    n.aspects.append(alloc, ci) catch @panic("nl: OOM");
                }
                if (ck != PCT and ck != FIX and (!ce.is_text or ce.wm == 0)) {
                    n.rbuf.append(alloc, ci) catch @panic("nl: OOM");
                }
                if (along) {
                    inner += if (ck == PCT) 0 else cs;
                    if (ck == GROW) growCount += 1;
                    if (!first) {
                        inner += gap;
                        totalPadGaps += gap;
                    }
                } else {
                    inner = @max(cs, inner);
                }
                first = false;
            }
            // Expand percent children against the now-final parent size.
            for (kids) |ci| {
                const ce = &n.els.items[@intCast(ci)];
                if (stype(ce, xAxis) == PCT) {
                    const cs = dim(ce, xAxis);
                    cs.* = (parentSize - totalPadGaps) * smin(ce, xAxis);
                    if (along) inner += cs.*;
                    updAspect(ce);
                }
            }
            if (along) {
                var leftover = parentSize - parentPad - inner;
                if (leftover < 0) {
                    if (clipsAxis(p, xAxis)) continue;
                    // Compress resizable children, largest first.
                    while (leftover < -EPS and n.rbuf.items.len > 0) {
                        // No-progress guard, mirroring the clay.h LOCAL PATCH: an
                        // iteration that moves nothing can never converge.
                        const leftoverBefore = leftover;
                        var largest: f32 = 0;
                        var secondLargest: f32 = 0;
                        var wta = leftover;
                        for (n.rbuf.items) |ci| {
                            const cs = dim(&n.els.items[@intCast(ci)], xAxis).*;
                            if (fEq(cs, largest)) continue;
                            if (cs > largest) {
                                secondLargest = largest;
                                largest = cs;
                            }
                            if (cs < largest) {
                                secondLargest = @max(secondLargest, cs);
                                wta = secondLargest - largest;
                            }
                        }
                        wta = @max(wta, leftover / @as(f32, @floatFromInt(n.rbuf.items.len)));
                        var i: usize = 0;
                        while (i < n.rbuf.items.len) {
                            const ce = &n.els.items[@intCast(n.rbuf.items[i])];
                            const cs = dim(ce, xAxis);
                            const prev = cs.*;
                            if (fEq(prev, largest)) {
                                cs.* += wta;
                                const mn = mdim(ce, xAxis);
                                if (cs.* <= mn) {
                                    cs.* = mn;
                                    n.rbuf.items[i] = n.rbuf.items[n.rbuf.items.len - 1];
                                    n.rbuf.items.len -= 1;
                                    leftover -= cs.* - prev;
                                    continue;
                                }
                                leftover -= cs.* - prev;
                            }
                            i += 1;
                        }
                        if (leftover == leftoverBefore) break;
                    }
                } else if (leftover > 0 and growCount > 0) {
                    var i: usize = 0;
                    while (i < n.rbuf.items.len) {
                        if (stype(&n.els.items[@intCast(n.rbuf.items[i])], xAxis) != GROW) {
                            n.rbuf.items[i] = n.rbuf.items[n.rbuf.items.len - 1];
                            n.rbuf.items.len -= 1;
                        } else i += 1;
                    }
                    // Distribute leftover to grow children, smallest first.
                    while (leftover > EPS and n.rbuf.items.len > 0) {
                        const leftoverBefore = leftover;
                        var smallest: f32 = MAXF;
                        var secondSmallest: f32 = MAXF;
                        var wta = leftover;
                        for (n.rbuf.items) |ci| {
                            const cs = dim(&n.els.items[@intCast(ci)], xAxis).*;
                            if (fEq(cs, smallest)) continue;
                            if (cs < smallest) {
                                secondSmallest = smallest;
                                smallest = cs;
                            }
                            if (cs > smallest) {
                                secondSmallest = @min(secondSmallest, cs);
                                wta = secondSmallest - smallest;
                            }
                        }
                        wta = @min(wta, leftover / @as(f32, @floatFromInt(n.rbuf.items.len)));
                        i = 0;
                        while (i < n.rbuf.items.len) {
                            const ce = &n.els.items[@intCast(n.rbuf.items[i])];
                            const cs = dim(ce, xAxis);
                            const mx = smax(ce, xAxis);
                            const prev = cs.*;
                            if (fEq(prev, smallest)) {
                                cs.* += wta;
                                if (cs.* >= mx) {
                                    cs.* = mx;
                                    n.rbuf.items[i] = n.rbuf.items[n.rbuf.items.len - 1];
                                    n.rbuf.items.len -= 1;
                                    leftover -= cs.* - prev;
                                    continue;
                                }
                                leftover -= cs.* - prev;
                            }
                            i += 1;
                        }
                        if (leftover == leftoverBefore) break;
                    }
                }
            } else {
                // Off-axis: clamp every resizable child into the parent.
                for (n.rbuf.items) |ci| {
                    const ce = &n.els.items[@intCast(ci)];
                    var maxSize = parentSize - parentPad;
                    if (clipsAxis(p, xAxis)) maxSize = @max(maxSize, inner);
                    const cs = dim(ce, xAxis);
                    if (stype(ce, xAxis) == GROW) cs.* = @min(maxSize, smax(ce, xAxis));
                    cs.* = @max(mdim(ce, xAxis), @min(cs.*, maxSize));
                }
            }
        }
    }
}

// Text wrap — the wrapped-lines pass between X and Y sizing.
fn wrapTexts(n: *Native) void {
    for (n.texts.items) |ti| {
        const e = &n.els.items[@intCast(ti)];
        // Clay re-bases wrappedLines per pass (clay.h:2587): duplicate texts
        // entries (float-then-reflat elements) re-wrap and only the last
        // pass's lines count — reset nl alongside l0.
        e.l0 = @intCast(n.lines.items.len);
        e.nl = 0;
        const lineH: f32 = if (e.lh > 0) @floatFromInt(e.lh) else e.unw_h;
        var lw: f32 = 0;
        var lineLen: i32 = 0;
        var lineStart: i32 = 0;
        if (!e.has_nl and e.unw_w <= e.dw) {
            n.lines.append(alloc, .{ .w = e.dw, .h = e.dh, .s = 0, .len = @intCast(e.tx.len) }) catch @panic("nl: OOM");
            e.nl += 1;
            continue;
        }
        const spw = koru_clay_measure(" ", 1, @floatFromInt(e.fs), @intCast(e.ls)).width;
        var wi: usize = @intCast(e.w0);
        const wend = wi + @as(usize, @intCast(e.nw));
        while (wi < wend) {
            const word = &n.words.items[wi];
            // Lone word wider than the box — emit it on its own line.
            if (lineLen == 0 and lw + word.w > e.dw) {
                n.lines.append(alloc, .{ .w = word.w, .h = lineH, .s = word.s, .len = word.len }) catch @panic("nl: OOM");
                e.nl += 1;
                wi += 1;
                lineStart = word.s + word.len;
            } else if (word.len == 0 or lw + word.w > e.dw) {
                // Wrap: emit the accumulated line.
                const endOff = @max(lineStart + lineLen - 1, 0);
                const sp = e.tx[@intCast(endOff)] == ' ';
                n.lines.append(alloc, .{ .w = lw + (if (sp) -spw else 0), .h = lineH, .s = lineStart, .len = lineLen + (if (sp) @as(i32, -1) else 0) }) catch @panic("nl: OOM");
                e.nl += 1;
                if (lineLen == 0 or word.len == 0) wi += 1;
                lw = 0;
                lineLen = 0;
                lineStart = word.s;
            } else {
                lw += word.w + @as(f32, @floatFromInt(e.ls));
                lineLen += word.len;
                wi += 1;
            }
        }
        if (lineLen > 0) {
            n.lines.append(alloc, .{ .w = lw - @as(f32, @floatFromInt(e.ls)), .h = lineH, .s = lineStart, .len = lineLen }) catch @panic("nl: OOM");
            e.nl += 1;
        }
        e.dh = lineH * @as(f32, @floatFromInt(e.nl));
    }
}

// Post-wrap height propagation — parents recompute heights bottom-up.
fn propagateHeights(n: *Native) void {
    var stack = std.ArrayListUnmanaged(i32){};
    var seen = std.ArrayListUnmanaged(bool){};
    defer stack.deinit(alloc);
    defer seen.deinit(alloc);
    for (n.roots.items) |re| {
        const ri = re.el;
        stack.clearRetainingCapacity();
        seen.clearRetainingCapacity();
        stack.append(alloc, ri) catch @panic("nl: OOM");
        seen.append(alloc, false) catch @panic("nl: OOM");
        while (stack.items.len > 0) {
            const top = stack.items.len - 1;
            const ei = stack.items[top];
            const e = &n.els.items[@intCast(ei)];
            if (!seen.items[top]) {
                seen.items[top] = true;
                if (e.is_text or e.nc == 0) {
                    stack.items.len -= 1;
                    seen.items.len -= 1;
                    continue;
                }
                for (n.kids.items[@intCast(e.fc)..@intCast(e.fc + e.nc)]) |ci| {
                    stack.append(alloc, ci) catch @panic("nl: OOM");
                    seen.append(alloc, false) catch @panic("nl: OOM");
                }
                continue;
            }
            stack.items.len -= 1;
            seen.items.len -= 1;
            const ptb: f32 = @floatFromInt(@as(i64, e.padt) + @as(i64, e.padb));
            if (e.dir == LTR) {
                for (n.kids.items[@intCast(e.fc)..@intCast(e.fc + e.nc)]) |ci| {
                    const ce = &n.els.items[@intCast(ci)];
                    const chp = @max(ce.dh + ptb, e.dh);
                    e.dh = fClamp(chp, e.hmn, e.hmx);
                }
            } else {
                var content = ptb;
                for (n.kids.items[@intCast(e.fc)..@intCast(e.fc + e.nc)]) |ci| {
                    content += n.els.items[@intCast(ci)].dh;
                }
                content += @floatFromInt(@max(@as(i64, e.nc) - 1, 0) * @as(i64, e.gap));
                e.dh = fClamp(content, e.hmn, e.hmx);
            }
        }
    }
}

const Node = struct { el: i32, x: f32, y: f32, nox: f32, noy: f32, seen: bool };
const Root = struct { el: i32, par: i32, clip: i32, zi: i32 };

// Registers (or updates) the tree root for element ei. Configure calls are
// repeatable in the dialect — a reconfigure must not accumulate roots.
fn addRoot(n: *Native, ei: i32, par: i32, cid: i32, zi: i32) void {
    for (n.roots.items) |*r| {
        if (r.el == ei) {
            r.par = par;
            r.clip = cid;
            r.zi = zi;
            return;
        }
    }
    n.roots.append(alloc, .{ .el = ei, .par = par, .clip = cid, .zi = zi }) catch @panic("nl: OOM");
}

// Drops root entries for an element whose final config is not floating —
// the element exists in exactly one emission frame. (clay.h CloseElement
// purge; without it a reconfigure that removes floating leaves the element
// visited both as a child and as a root, corrupting attach/clip reads.)
fn dropRootsFor(n: *Native, ei: i32) void {
    var ri = n.roots.items.len;
    while (ri > 0) {
        ri -= 1;
        if (n.roots.items[ri].el == ei) {
            _ = n.roots.orderedRemove(ri);
        }
    }
}

// Position + command emission — the final DFS per root. Roots walk in
// stable zIndex order — clay.h:2712's bubble sort (strict-< swap ⇒ stable,
// declaration order preserved among equal keys).
fn runRoot(n: *Native, dfs: *std.ArrayListUnmanaged(Node), rent: Root) void {
        const ri = rent.el;
        dfs.clearRetainingCapacity();
        const root = &n.els.items[@intCast(ri)];
        var px: f32 = 0;
        var py: f32 = 0;
        if (root.fat != 0) {
            // Attach resolution (clay.h:2739): the parent's attach point lands
            // on the element's attach point, plus offset — against the
            // parent's emitted bbox (post-expand), filled by the
            // declaration-order position pre-pass or the implicit-root seed.
            var pbx: f32 = 0;
            var pby: f32 = 0;
            var pw: f32 = 0;
            var ph: f32 = 0;
            if (rent.par >= 0) {
                const pe = &n.els.items[@intCast(rent.par)];
                pbx = pe.ebx;
                pby = pe.eby;
                pw = pe.ebw;
                ph = pe.ebh;
            }
            const pcol = @divTrunc(root.fap, 3);
            const prow = @mod(root.fap, 3);
            var ax = pbx;
            if (pcol == 1) ax += pw / 2 else if (pcol == 2) ax += pw;
            var ay = pby;
            if (prow == 1) ay += ph / 2 else if (prow == 2) ay += ph;
            const ecol = @divTrunc(root.fae, 3);
            const erow = @mod(root.fae, 3);
            if (ecol == 1) ax -= root.dw / 2 else if (ecol == 2) ax -= root.dw;
            if (erow == 1) ay -= root.dh / 2 else if (erow == 2) ay -= root.dh;
            px = ax + root.fx;
            py = ay + root.fy;
        }
        // The entry's stored clip wraps this subtree's DFS in a SCISSOR pair
        // using the clip element's emitted bbox (clay.h:2793, :3198) — filled
        // by the pre-pass or the implicit-root seed before this runs.
        if (rent.clip >= 0) {
            const ce2 = &n.els.items[@intCast(rent.clip)];
            const cb = [4]f32{ ce2.ebx, ce2.eby, ce2.ebw, ce2.ebh };
            if (!offscreen(n, cb[0], cb[1], cb[2], cb[3])) {
                n.cmds.append(alloc, .{ .kind = 5, .x = cb[0], .y = cb[1], .w = cb[2], .h = cb[3], .zi = rent.zi }) catch @panic("nl: OOM");
            }
        }
        const rpadx: f32 = @floatFromInt(root.padl);
        const rpady: f32 = @floatFromInt(root.padt);
        dfs.append(alloc, .{ .el = ri, .x = px, .y = py, .nox = rpadx, .noy = rpady, .seen = false }) catch @panic("nl: OOM");
        const zi = rent.zi;
        while (dfs.items.len > 0) {
            var node = &dfs.items[dfs.items.len - 1];
            if (node.seen) {
                const e = &n.els.items[@intCast(node.el)];
                dfs.items.len -= 1;
                if (e.is_text) continue;
                if (!offscreen(n, e.ebx, e.eby, e.ebw, e.ebh)) {
                    // BORDER + betweenChildren rects emit on pop, before
                    // OVERLAY_END/SCISSOR_END — matching clay.h's DFS-return order.
                    if (e.bwl > 0 or e.bwr > 0 or e.bwt > 0 or e.bwb > 0 or e.bwc > 0) {
                        n.cmds.append(alloc, .{ .kind = 2, .x = e.ebx, .y = e.eby, .w = e.ebw, .h = e.ebh, .r = e.br, .g = e.bg, .b = e.bb, .a = e.ba, .ud = e.ud, .ctl = e.ctl, .ctr = e.ctr, .cbl = e.cbl, .cbr = e.cbr, .bwl = @floatFromInt(e.bwl), .bwr = @floatFromInt(e.bwr), .bwt = @floatFromInt(e.bwt), .bwb = @floatFromInt(e.bwb), .bwc = @floatFromInt(e.bwc) }) catch @panic("nl: OOM");
                        if (e.bwc > 0 and e.ba > 0) {
                            const gap: f32 = @floatFromInt(e.gap);
                            // childGap and betweenChildren are u16 in clay.h —
                            // their halves are integer divisions, not float.
                            const halfGap: f32 = @floatFromInt(e.gap / 2);
                            const halfW: f32 = @floatFromInt(e.bwc / 2);
                            var sx: f32 = 0;
                            var sy: f32 = 0;
                            if (e.ch or e.cv) {
                                sx = e.ox;
                                sy = e.oy;
                            }
                            var offx = @as(f32, @floatFromInt(e.padl)) - halfGap;
                            var offy = @as(f32, @floatFromInt(e.padt)) - halfGap;
                            const kids = n.kids.items[@intCast(e.fc)..@intCast(e.fc + e.nc)];
                            if (e.dir == LTR) {
                                for (kids, 0..) |ki, i| {
                                    const ce = &n.els.items[@intCast(ki)];
                                    if (i > 0) {
                                        n.cmds.append(alloc, .{ .kind = 1, .x = e.ebx + offx + sx - halfW, .y = e.eby + sy, .w = @floatFromInt(e.bwc), .h = e.dh, .r = e.br, .g = e.bg, .b = e.bb, .a = e.ba, .ud = e.ud }) catch @panic("nl: OOM");
                                    }
                                    offx += ce.dw + gap;
                                }
                            } else {
                                for (kids, 0..) |ki, i| {
                                    const ce = &n.els.items[@intCast(ki)];
                                    if (i > 0) {
                                        n.cmds.append(alloc, .{ .kind = 1, .x = e.ebx + sx, .y = e.eby + offy + sy - halfW, .w = e.dw, .h = @floatFromInt(e.bwc), .r = e.br, .g = e.bg, .b = e.bb, .a = e.ba, .ud = e.ud }) catch @panic("nl: OOM");
                                    }
                                    offy += ce.dh + gap;
                                }
                            }
                        }
                    }
                    if (e.ova > 0) {
                        n.cmds.append(alloc, .{ .kind = 8, .ud = e.ud, .zi = zi }) catch @panic("nl: OOM");
                    }
                    if (e.ch or e.cv) {
                        n.cmds.append(alloc, .{ .kind = 6 }) catch @panic("nl: OOM");
                    }
                }
                continue;
            }
            node.seen = true;
            const e = &n.els.items[@intCast(node.el)];
            const bx = node.x;
            const by = node.y;
            var sx: f32 = 0;
            var sy: f32 = 0;
            if (e.ch or e.cv) {
                sx = e.ox;
                sy = e.oy;
            }
            e.bx = bx;
            e.by = by;
            // expand inflates the emitted bbox only (clay.h:2948); the solved
            // dims dw/dh stay untouched, but children position and the stored
            // attach-resolution box both read the expanded box.
            var ebx = bx;
            var eby = by;
            var ebw = e.dw;
            var ebh = e.dh;
            if (e.fat != 0) {
                ebx -= e.exw;
                ebw += e.exw * 2;
                eby -= e.exh;
                ebh += e.exh * 2;
            }
            e.ebx = ebx;
            e.eby = eby;
            e.ebw = ebw;
            e.ebh = ebh;
            const offs = offscreen(n, ebx, eby, ebw, ebh);
            if (!offs) {
                if (e.is_text) {
                    // clay.h:2981 — the natural glyph box centers inside the
                    // configured line height: first line offsets by half the
                    // difference, each line then advances by finalLineHeight.
                    const lineH: f32 = if (e.lh > 0) @floatFromInt(e.lh) else e.unw_h;
                    var ypos: f32 = (lineH - e.unw_h) / 2;
                    const ll = n.lines.items[@intCast(e.l0)..@intCast(e.l0 + e.nl)];
                    for (ll) |line| {
                        if (line.len == 0) {
                            ypos += line.h;
                            continue;
                        }
                        // textAlignment: line offset inside the element box
                        // (clay.h:2991 — LEFT 0, CENTER half, RIGHT full).
                        var toff: f32 = ebw - line.w;
                        if (e.tal == 0) toff = 0 else if (e.tal == 1) toff /= 2;
                        n.cmds.append(alloc, .{
                            .kind = 3,
                            .x = ebx + toff,
                            .y = eby + ypos,
                            .w = line.w,
                            .h = line.h,
                            .r = e.tcr,
                            .g = e.tcg,
                            .b = e.tcb,
                            .a = e.tca,
                            .ud = e.ud,
                            .zi = zi,
                            .tx = e.tx[@intCast(line.s)..@intCast(line.s + line.len)],
                            .fs = e.fs,
                            .fi = e.fid,
                            .ls = @floatFromInt(e.ls),
                            .lh = @floatFromInt(e.lh),
                        }) catch @panic("nl: OOM");
                        ypos += line.h;
                        if (eby + ypos > n.h) break;
                    }
                } else {
                    if (e.ova > 0) {
                        n.cmds.append(alloc, .{ .kind = 7, .r = e.ovr, .g = e.ovg, .b = e.ovb, .a = e.ova, .ud = e.ud, .zi = zi }) catch @panic("nl: OOM");
                    }
                    if (e.img != 0) {
                        n.cmds.append(alloc, .{ .kind = 4, .x = ebx, .y = eby, .w = ebw, .h = ebh, .img = e.img, .ud = e.ud, .zi = zi, .ctl = e.ctl, .ctr = e.ctr, .cbl = e.cbl, .cbr = e.cbr }) catch @panic("nl: OOM");
                    }
                    if (e.cd != 0) {
                        n.cmds.append(alloc, .{ .kind = 9, .x = ebx, .y = eby, .w = ebw, .h = ebh, .r = e.r, .g = e.g, .b = e.b, .a = e.a, .cd = e.cd, .ud = e.ud, .zi = zi, .ctl = e.ctl, .ctr = e.ctr, .cbl = e.cbl, .cbr = e.cbr }) catch @panic("nl: OOM");
                    }
                    if (e.ch or e.cv) {
                        n.cmds.append(alloc, .{ .kind = 5, .x = ebx, .y = eby, .w = ebw, .h = ebh, .zi = zi }) catch @panic("nl: OOM");
                    }
                    if (e.a > 0) {
                        n.cmds.append(alloc, .{ .kind = 1, .x = ebx, .y = eby, .w = ebw, .h = ebh, .r = e.r, .g = e.g, .b = e.b, .a = e.a, .ud = e.ud, .zi = zi, .ctl = e.ctl, .ctr = e.ctr, .cbl = e.cbl, .cbr = e.cbr }) catch @panic("nl: OOM");
                    }
                }
            }
            if (e.is_text) continue;
            // On-axis alignment: extra leading space.
            const kids = n.kids.items[@intCast(e.fc)..@intCast(e.fc + e.nc)];
            if (e.dir == LTR) {
                var content: f32 = 0;
                for (kids) |ci| content += n.els.items[@intCast(ci)].dw;
                content += @floatFromInt(@max(@as(i64, e.nc) - 1, 0) * @as(i64, e.gap));
                var extra = e.dw - @as(f32, @floatFromInt(@as(i64, e.padl) + @as(i64, e.padr))) - content;
                if (e.ax == 0) extra = 0 else if (e.ax == 2) extra /= 2;
                node.nox += @max(0, extra);
            } else {
                var content: f32 = 0;
                for (kids) |ci| content += n.els.items[@intCast(ci)].dh;
                content += @floatFromInt(@max(@as(i64, e.nc) - 1, 0) * @as(i64, e.gap));
                var extra = e.dh - @as(f32, @floatFromInt(@as(i64, e.padt) + @as(i64, e.padb))) - content;
                if (e.ay == 0) extra = 0 else if (e.ay == 2) extra /= 2;
                node.noy += @max(0, extra);
            }
            // Children appended in declaration order, first child on top.
            // They position from the EXPANDED box (clay.h:3171 uses the
            // stored boundingBox) but alignment whitespace uses solved dims.
            dfs.ensureUnusedCapacity(alloc, kids.len) catch @panic("nl: OOM");
            const nlen = dfs.items.len + kids.len;
            dfs.items.len = nlen;
            node = &dfs.items[dfs.items.len - 1 - kids.len];
            for (kids, 0..) |ci, i| {
                const ce = &n.els.items[@intCast(ci)];
                const cpadx: f32 = @floatFromInt(ce.padl);
                const cpady: f32 = @floatFromInt(ce.padt);
                if (e.dir == LTR) {
                    node.noy = @floatFromInt(e.padt);
                    const ws = e.dh - @as(f32, @floatFromInt(@as(i64, e.padt) + @as(i64, e.padb))) - ce.dh;
                    if (e.ay == 2) node.noy += ws / 2 else if (e.ay == 1) node.noy += ws;
                } else {
                    node.nox = @floatFromInt(e.padl);
                    const ws = e.dw - @as(f32, @floatFromInt(@as(i64, e.padl) + @as(i64, e.padr))) - ce.dw;
                    if (e.ax == 2) node.nox += ws / 2 else if (e.ax == 1) node.nox += ws;
                }
                const cx = ebx + node.nox + sx;
                const cy = eby + node.noy + sy;
                dfs.items[nlen - 1 - i] = .{ .el = ci, .x = cx, .y = cy, .nox = cpadx, .noy = cpady, .seen = false };
                if (e.dir == LTR) {
                    node.nox += ce.dw + @as(f32, @floatFromInt(e.gap));
                } else {
                    node.noy += ce.dh + @as(f32, @floatFromInt(e.gap));
                }
            }
        }
        if (rent.clip >= 0) {
            const ce2 = &n.els.items[@intCast(rent.clip)];
            const cb = [4]f32{ ce2.ebx, ce2.eby, ce2.ebw, ce2.ebh };
            if (!offscreen(n, cb[0], cb[1], cb[2], cb[3])) {
                n.cmds.append(alloc, .{ .kind = 6 }) catch @panic("nl: OOM");
            }
        }
    }

fn emitCommands(n: *Native) void {
    var dfs = std.ArrayListUnmanaged(Node){};
    defer dfs.deinit(alloc);
    var order = std.ArrayListUnmanaged(Root){};
    defer order.deinit(alloc);
    order.appendSlice(alloc, n.roots.items) catch @panic("nl: OOM");
    var sortMax: usize = order.items.len;
    while (sortMax > 1) {
        sortMax -= 1;
        var i: usize = 0;
        while (i < sortMax) : (i += 1) {
            if (order.items[i + 1].zi < order.items[i].zi) {
                const tmp = order.items[i];
                order.items[i] = order.items[i + 1];
                order.items[i + 1] = tmp;
            }
        }
    }
    // clay.h: the implicit root container's emitted bbox is {0,0,W,H} — it is
    // written when the main DFS starts, so floating roots that sort before it
    // (negative zIndex) resolve ROOT attach against a zero box.
    // The implicit root's emitted box is a layout constant — seed it
    // so ROOT attach and clip-to-root resolve correctly even before
    // its own DFS visit (Clay reads the same constant from its hashmap).
    {
        const r0 = &n.els.items[0];
        r0.ebx = 0;
        r0.eby = 0;
        r0.ebw = n.w;
        r0.ebh = n.h;
    }
    // Attach/clip resolution reads the target's emitted box — the position
    // its commands actually render at — filled for every element by the
    // silent declaration-order pass below. Declaration order materializes
    // the rendered position: a containing root is registered (and walked)
    // before the clip/floating roots nested inside its subtree, so the
    // detached rendering pass writes eb last for elements that live in a
    // detached frame. Parents and clip ancestors always precede their
    // dependents. Skipped when no root attaches to or clips against
    // another element.
    var need_pos = false;
    for (n.roots.items) |re| {
        if (re.par > 0 or re.clip >= 0) {
            need_pos = true;
            break;
        }
    }
    var pass: u8 = if (need_pos) 0 else 1;
    while (pass < 2) : (pass += 1) {
        var saved: @TypeOf(n.cmds) = undefined;
        if (pass == 0) {
            saved = n.cmds;
            n.cmds = .{};
        }
        const seq = if (pass == 1) order.items else n.roots.items;
        for (seq) |rent| runRoot(n, &dfs, rent);
        if (pass == 0) {
            n.cmds.deinit(alloc);
            n.cmds = saved;
        }
    }
}

fn solve(n: *Native) void {
    n.texts.clearRetainingCapacity();
    n.lines.clearRetainingCapacity();
    n.cmds.clearRetainingCapacity();
    n.aspects.clearRetainingCapacity();
    sizeAxis(n, true);
    wrapTexts(n);
    // clay.h: scale vertical heights by aspect ratio, lock via max —
    // after text wrap, before height propagation.
    for (n.aspects.items) |ai| {
        const e = &n.els.items[@intCast(ai)];
        e.dh = e.dw * (1.0 / e.ar);
        e.hmx = e.dh;
    }
    propagateHeights(n);
    sizeAxis(n, false);
    // clay.h: scale horizontal widths from the now-final heights.
    for (n.aspects.items) |ai| {
        const e = &n.els.items[@intCast(ai)];
        e.dw = e.ar * e.dh;
    }
    // All roots z=0 → stable order is declaration order already.
    emitCommands(n);
}

// ============================================================================
// nl.* — the parallel bracket. Mirrors clay:* tor-for-tor; el.cfg/el.img
// carry eid where the ui dialect stamps userData.
// ============================================================================

~pub tor nl.init { width: f64, height: f64 }
| ncl *Native<ready!>
| err string

~proc nl.init|zig {
    const h = $mod.std.heap.page_allocator.create($mod.Native) catch return .{ .err = "nl: OOM" };
    h.* = .{ .w = @floatCast(width), .h = @floatCast(height) };
    return .{ .ncl = h };
}

~pub tor nl.dims { cl: *Native<ready|solved>, width: f64, height: f64 }

~proc nl.dims|zig {
    cl.w = @floatCast(width);
    cl.h = @floatCast(height);
}

~pub tor nl.drop { cl: *Native<!solved|!ready> }

~proc nl.drop|zig {
    cl.els.deinit($mod.std.heap.page_allocator);
    cl.kids.deinit($mod.std.heap.page_allocator);
    cl.kidsbuf.deinit($mod.std.heap.page_allocator);
    cl.stack.deinit($mod.std.heap.page_allocator);
    cl.roots.deinit($mod.std.heap.page_allocator);
    cl.clipStk.deinit($mod.std.heap.page_allocator);
    cl.bfs.deinit($mod.std.heap.page_allocator);
    cl.rbuf.deinit($mod.std.heap.page_allocator);
    cl.texts.deinit($mod.std.heap.page_allocator);
    cl.words.deinit($mod.std.heap.page_allocator);
    cl.lines.deinit($mod.std.heap.page_allocator);
    cl.cmds.deinit($mod.std.heap.page_allocator);
    cl.mcache.deinit($mod.std.heap.page_allocator);
    cl.mwords.deinit($mod.std.heap.page_allocator);
    $mod.std.heap.page_allocator.destroy(cl);
}

~pub tor nl.layout { cl: *Native<ready|solved> }
! ntree *NTree<ntree!>
| nsolved *Native<solved>

~proc nl.layout|zig {
    cl.els.clearRetainingCapacity();
    cl.kids.clearRetainingCapacity();
    cl.kidsbuf.clearRetainingCapacity();
    cl.stack.clearRetainingCapacity();
    cl.roots.clearRetainingCapacity();
    cl.clipStk.clearRetainingCapacity();
    // The implicit root — FIXED to layout dims, LTR, on the stack twice
    // (mirroring BeginLayout's double push) so top-level elements attach.
    cl.els.append($mod.alloc, .{
        .wk = 3, .wmn = cl.w, .wmx = cl.w, .dw = cl.w,
        .hk = 3, .hmn = cl.h, .hmx = cl.h, .dh = cl.h,
    }) catch @panic("nl: OOM");
    cl.stack.append($mod.alloc, 0) catch @panic("nl: OOM");
    cl.stack.append($mod.alloc, 0) catch @panic("nl: OOM");
    cl.roots.append($mod.alloc, .{ .el = 0, .par = -1, .clip = -1, .zi = 0 }) catch @panic("nl: OOM");
    var __t = $mod.NTree{ .n = cl, .depth = 0 };
    ntree(&__t);
    while (__t.depth > 0) : (__t.depth -= 1) $mod.closeEl(cl);
    // EndLayout closes the implicit root once — gathers its top-level
    // children and clamps it back to FIXED{W,H}.
    $mod.closeEl(cl);
    $mod.solve(cl);
    return .{ .nsolved = cl };
}

~pub tor nl.el.open { t: *NTree<ntree> }

~proc nl.el.open|zig {
    const idx: i32 = @intCast(t.n.els.items.len);
    t.n.els.append($mod.alloc, .{}) catch @panic("nl: OOM");
    $mod.els_clip_anc(t.n);
    t.n.stack.append($mod.alloc, idx) catch @panic("nl: OOM");
    t.depth += 1;
}

~pub tor nl.el.cfg {
    t: *NTree<ntree>,
    wk: i64, w: f64, hk: i64, h: f64,
    dir: i64, gap: i64, padl: i64, padr: i64, padt: i64, padb: i64,
    ax: i64, ay: i64,
    r: f64, g: f64, b: f64, a: f64,
    fat: i64, fx: f64, fy: f64,
    fae: i64, fap: i64, exw: f64, exh: f64, zi: i64, fct: i64,
    eid: i64,
    ovr: f64, ovg: f64, ovb: f64, ova: f64,
    crtl: f64, crtr: f64, crbl: f64, crbr: f64,
    ar: f64,
    br: f64, bg: f64, bb: f64, ba: f64,
    bwl: i64, bwr: i64, bwt: i64, bwb: i64, bwc: i64,
}

~proc nl.el.cfg|zig {
    // ConfigureOpenElement replaces the WHOLE decl — fields an op doesn't
    // carry reset to zero, matching the clay path. nc is declaration state,
    // not config: children already attached survive a re-configure.
    if ((wk == 2 and w > 1.0) or (hk == 2 and h > 1.0)) $mod.pctOverErr();
    const e = &t.n.els.items[@intCast(t.n.stack.items[t.n.stack.items.len - 1])];
    const nc = e.nc;
    e.* = .{ .nc = nc };
    $mod.setSizing(e, true, wk, w);
    $mod.setSizing(e, false, hk, h);
    e.dir = @intCast(@min(@max(dir, 0), 1));
    e.padl = @intCast(@max(padl, 0));
    e.padr = @intCast(@max(padr, 0));
    e.padt = @intCast(@max(padt, 0));
    e.padb = @intCast(@max(padb, 0));
    e.gap = @intCast(@max(gap, 0));
    e.ax = @intCast(@min(@max(ax, 0), 2));
    e.ay = @intCast(@min(@max(ay, 0), 2));
    e.r = @floatCast(r);
    e.g = @floatCast(g);
    e.b = @floatCast(b);
    e.a = @floatCast(a);
    e.ovr = @floatCast(ovr);
    e.ovg = @floatCast(ovg);
    e.ovb = @floatCast(ovb);
    e.ova = @floatCast(ova);
    e.ctl = @floatCast(crtl);
    e.ctr = @floatCast(crtr);
    e.cbl = @floatCast(crbl);
    e.cbr = @floatCast(crbr);
    e.ar = @floatCast(ar);
    e.br = @floatCast(br);
    e.bg = @floatCast(bg);
    e.bb = @floatCast(bb);
    e.ba = @floatCast(ba);
    e.bwl = @intCast(@min(@max(bwl, 0), 65535));
    e.bwr = @intCast(@min(@max(bwr, 0), 65535));
    e.bwt = @intCast(@min(@max(bwt, 0), 65535));
    e.bwb = @intCast(@min(@max(bwb, 0), 65535));
    e.bwc = @intCast(@min(@max(bwc, 0), 65535));
    e.ud = @intCast(@as(u64, @bitCast(eid)));
    e.fat = @min(@max(fat, 0), 3);
    e.fx = @floatCast(fx);
    e.fy = @floatCast(fy);
    e.fae = @min(@max(fae, 0), 8);
    e.fap = @min(@max(fap, 0), 8);
    e.exw = @floatCast(exw);
    e.exh = @floatCast(exh);
    e.zi = @min(@max(zi, -32768), 32767);
    e.fct = @min(@max(fct, 0), 1);
    const __ei: i32 = @intCast(t.n.stack.items[t.n.stack.items.len - 1]);
    if (e.fat != 0) {
        // clay.h:2118-2158 — every floating configure resolves the clip
        // ancestor off the open-clip stack, pushes it back, and registers a
        // tree root. addRoot dedupes reconfigures; clip entries still leak.
        var cid: i32 = -1;
        if (e.fat == 1 and t.n.clipStk.items.len > 0) cid = t.n.clipStk.items[t.n.clipStk.items.len - 1];
        if (e.fct == 0) cid = -1;
        e.clipAnc = cid;
        t.n.clipStk.append($mod.alloc, cid) catch @panic("nl: OOM");
        const __par: i32 = switch (e.fat) {
            1 => t.n.stack.items[t.n.stack.items.len - 2],
            3 => 0,
            else => -1,
        };
        $mod.addRoot(t.n, __ei, __par, cid, @intCast(e.zi));
    }
    if (e.ch or e.cv) t.n.clipStk.append($mod.alloc, __ei) catch @panic("nl: OOM");
}

